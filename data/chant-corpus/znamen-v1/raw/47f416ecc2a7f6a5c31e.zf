%Название Гласъ 1 I=рмосы`
%Архив ГПНТБ СО РАН, F.I.5

%песнь 1
%код i81w
%Расшифровка С.Хохряков

%з мА рТ. Э: п=: рТ рТ. Э: п\ м=`
%н м2 м1н1 с1м1 п4 п2 п1м1 с1м1 п2 м4
%т Во'-ду про-ше'дъ _я='-кw по'-су-ху

%з рА рТ рТ рТ сТ. Э: п_/
%н м2 м2 м2 м2 с1н1 с1м1 п4
%т и=з\ъ _е=-г[v']-пе-т(е)-ска зла`

%з рТ. Э: п\
%н п1м1 с1м1 п2 
%т и=-збе-жа'-

%з м=` рТ. вб_:/ рК: рТ рТ
%н м4 м1с1 м1п1в2 в2 в2 в2 
%т в(о) и=з-ра'-иль-тя-нинъ

%з рТ. мЭ п_/ м=`
%н в1п1 м2 п4 м4
%т во-пi-я'-ше

%з Э: вК: рТ рТ рТ
%н м1п1 в2 в2 в2 в2 
%т и=з-ба'-ви-те-лю

%з рТ пТ. вб_:/ пК. мТ. м_/
%н в2 п1с1 м1п1в2 п2 м1с1 м4
%т бо'-гу на'-ше-му по-

%з стДЭ н+
%н с1н1г2 н4\
%т _е'-м(о).

