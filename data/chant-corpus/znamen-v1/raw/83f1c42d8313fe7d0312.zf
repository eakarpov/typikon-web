%код i18z

%текст вн\длю фоми\н

%з нЭ+ сК. рТ. Э: пК: м\ с= Э: вК: рК: пТ. пК:ч с= нЭ с_/
%н н2 с2 с1н1 с1м1 п2 м2 с4 м1п1 в2 в2 п1м1 п2м2 с4 н2 с4
%т Во пла'-ме-ни *о='-гне-ннё го-ря'-щ*и-я пе'-щи со-хра'н[ь|]-

%з рТ. Э: пр=\ мт_./ с= гЭ нЭ сК. рТ. Э: п=: мТ. нЭ сТ. пб_:/ р:/ч сЭ
%н с1н1 с1м1 п2п1м1 с2м2 с4 г2 н2 с2 с1н1 с1м1 п4 м1с1 н2 с1н1 с1м1п2 п1м1 с2
%т ша-го дё'--ти и= во *о='-бра-зё а='-нге-ла со-ше'-дша-го

%з м_/ с= бТ: пК:ч сКч мК: с\ н= бТ: пК: рТ. сТ. Э: мК:ч н=
%н м4 с2 с1м1 п2м2 с2н2 м2 с2 н2 с1м1 п2 п1м1 с1г1 н1с1 м2с2 н4
%т к\ъ+ни'-мъ _ по'й-те го'-спо-да _ и= пре-во-зно-си'-те

%з Э: пК: лТ: с=\ н=
%н с1м1 п2 с1м1н1 с4 н4\
%т _е=-го` во вё'-ки.

