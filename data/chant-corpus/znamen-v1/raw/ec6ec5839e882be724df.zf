%л.186о
%текст {Т}рпа\р.

%з пА вК: р/: \ ЭЭ\ =ч` вК: Т. пК: \ =`
%н п2 в2 п1в1 п1м1 с1м1п1в1 в1п3 в2 п1м1 п2 н1м1 с4
%т Да ве-се-л[_я]'-т(е)-с[_я] не-бе'-с(е)-на-я[.]

%з рА Э б_./+ в=\ рК: Т. пК: \ =`
%н с2 н2 н1п3 в3п1 в2 п1м1 п2 н1м1 с4
%т да ра-д[о_у]-е-тс[_я] зе-м(е)-на'-[_я][:]

%з (Э:)Э+ вК: пТ рТ. вЗ: Э: б./ч Т: вт_./+-`
%н м1п1 в2 п2 п1м1 п1в1п1м1 с1м1 п1м1 с1м1 п2в4
%т _я='-к[0] с0-тво-ри` де-ржа'--в[о_у]

%з рДЭ Э: [|*]м\ =чк =\ =` в_/ (/:Д)рЗ: =`
%н в1п1м2 п1в1 *м2 в1п1в2 п2м2 п4 в4 п1в1п1м1 п4
%т мы'-шце-ю св0-е-ю г0-сп0-д(е)[,]

%з в/: \ _./ _/шз Т. Э: [|*]мК: Ч /: =\
%н п1в1 п1м1 п2в2 *м3*п1 *м1в1 п1в1 *м2 п1в1 п1м1 п4 
%т п0-п(е)-ра'-в(о) с(0)-ме'-рт[и]-ю с(о)-ме'-

%з =` Т. в/: \ ЭЭ\ =?` вК: п=ч в/:
%н м4 п1м1 п1в1 п1м1 с1м1п1в1 в1п3 в2 м1п2м1 п1в1
%т рт(е) и= пе'-рве-не-ц(е) и=з[|\ъ] ме'-ртвы-

%з \ =ч ,,/ =` рА Э вб,,:/ пТ. р\ =`
%н п1м1 с1м1п2 м1с1м2 с4 с2 н2 м1п1в2 п1м1 п2 с4
%т (и)-х(0) бы'-ст(е)[,] и=-[с|з][\+]чре'-ва а='-до-ва

%з Т. вК: пТ рТ. в/: \ ЭЭ\ =?` Э
%н п1м1 в2 п2 п1м1 п1в1 п1м1 с1м1п1в1 в1п3 м2
%т и=з-ба'-ви-л(0) _е=-си` на'-с(0)[,] и=

%з пК: рТ. Э: в=: п=Э в**./+` п=ч в/: \
%н п2 п1с1 м1п1 в4 п4 в4п!м1п1в4 м1п2м1 п1в1 п1м1 
%т п0-да'-ст(е) м[и]'-р0-ви ве'-л[и]-ю

%з =ч ,,/ +
%н с1м1п2 м1с1м2 с4\
%т ми'-л0-сть.

%Примечание На поле киноварью развод:

%з {в**./+} -- {К: Д _./+}%]

%Разница
   попр[а'въ|а`]
   [и=|] пе'рвенецъ
   и=зба'в[илъ _е=си`|и] на'съ,
   и= по[да'стъ|даде`]

