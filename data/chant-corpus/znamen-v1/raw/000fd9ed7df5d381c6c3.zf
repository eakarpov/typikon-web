%код w10x2

%з сА рТ. мК: сТ рТ. гЭ н\
%н с2 с1н1 м2 с2 с1н1 г2 н2
%т {Р}а-спя--тi-е пре-те-

%з с_/` нТ. лЭ: с:/ч ну=ч *н,,/
%н с4 н1г1 н1с1 с1н1 н!г!ц1г1ц1 *н4
%т рпёвъ и сме-рть о_у-пра-

%з *г=` сТ рТ плК: сТ м:/ч ст_./
%н *г4 с2 с2 с1п1 с2 м1с1 н2с2
%т зднивъ и во-скре-съ и-зме-

%з н=` сТ рТ. пт_:/ сТ рТ
%н н4 с2 с1н1 с2м1п1 с2 с2
%т ртвыхъ о_у-ми-ри на-шу

%з мтДЭ пК: м\ с=` рК. рК.
%н м1с1н2 п2 м2 с4 с2 с2
%т жизнь го-спо-ди _я-ко

%з нТ. лЭ: с:/ч ну=ч *н,,/ *г+
%н н1г1 н1с1 с1н1 н!г!ц1г1ц1 *н4 *г8\
%т _е-динъ все-си--ленъ.

