%код i211

%з нЭ мК: рТ. Э: пК: сЩк
%н н2 м2 м1н1 с1м1 п2 с1н1с2
%т Не-тре-нну не-_о-бы-

%з н= рЭ с_/ нЭ сК. рТ рТ рТ. пб_:/
%н н4 н2 с4 н2 с2 с2 с2 с1н1 с1м1п2
%т чну не-мо-кре-нно мо-рску-ю ше-

%з мТ. мК: с\ н= Э: в=: пК: мТ
%н м1с1 м2 с2 н4 м1п1 в4 п2 м2
%т ство-вавъ сте-зю и-збра-нны-и

%з сК. нЭ с_/ п/: мТ. нЭ бТ: п=: р_/ рК:
%н с2 н2 с4 м1п1 м1с1 н2 с1м1 п4 п4 п2
%т во-пi-я-ше и-зра--иль го-спо-

%з мЭ вт_./+ п_/ м= вт_./+ рТ пТ. Э: в=:
%н м2 п2в2 п4 м4 м2в2 в2 п1с1 м1п1 в4 
%т де-ви по-емъ сла-вно бо про-сла-

%з п_/ м+
%н п4 м4\
%т ви-ся.

%-----------

%Название Ирмосы
%Источник Ирмологий XVIII
%Архив ГПНТБ СО РАН, Q.III.44

%текст Гласъ 2

