%код i28b

%текст рж\ству` б\дцы.

%з Э: вК: пЗ: нЭ
%н м1п1 в2 м1п1м1с1 н2
%т В[|\ъ]пе-щи _о-тро-

%з бТ: п=: рТ рТ. Э: в=: пТ рТ
%н с1м1 п4 п2 п1с1 м1п1 в4 п2 п2 
%т че-стёй про-_w-бра-зилъ _е-си

%з рТ. пК: мтДЭ пТ. Э: вК: рТ. *мЗ: мр=\
%н п1м1 п2 м1с1н2 п1с1 м1п1 в2 в1м1 п1*м1в1п1 м2м1с1
%т и-но-гда сво-ю ма-терь го-спо-

%з пЗ: мр=\ Э: м\ рт=.\ мТ. мК: сК.
%н м1п1м1с1 м2м1с1 н1с1 м2 м2с4н2н1г1н1с4н4 м1с1 м2 с2
%т ди w-бразъ же сихъ _о-гня и-

%л.52о

%з нЭ с_/ нЭ бТ: п=: рТ. Э: вК: рТ. мК.ч
%н н2 с4 н2 с1м1 п4 п1с1 м1п1 в2 в1п1 м2с2
%т зба-вля---ше не-_о-па-лно вше-

%з н= пЗ: нЭ бТ: п=: рТ. Э: вК:
%н н4 м1п1м1с1 н2 с1м1 п4 п1с1 м1п1 в2
%т дша ю-же по-емъ _явль-шу-ся

%з рК: п_/ вК: рТ. мК.ч н= мТ рТ.
%н в2 п4 в2 в1п1 м2с2 н4 м2 м1н1 
%т то-бо-ю ко-нцемъ днесь и пре-

%з Э: п=: м= бТ: вК: рЗ: м=\ п+
%н с1м1 п4 м2 м1п1 в2 м1в1п2 м4 п4\
%т во-зно-си-мъ во вся вё-ки.

