%код i18p

%текст па'сцё.

%з с= бТ: пК: мК: сТ рТ. мК: сТ нТ
%н с2 с1м1 п2 м2 с2 с1н1 м2 с2 н2 
%т Сей _ о_у-бо на-ре-че-нны-и

%з р\? мб_/: ср=\ мК:ч Э: п=: Э: пК:
%н н1г1 н1с1м2 с2с1н1 м2с2 с1м1 п4 с1м1 п2
%т свя-ты-и день _е-динъ су-бо-

%з м\ с=~бТ: пр=\ сТ. Э: п=: р_/
%н м2 с2==с1м1 п2п1м1 с1н1 с1м1 п4 п4
%т - тамъ царь и го-сподь пра-

%з рК: рр=\ тЭ!- п=: нЭ сК. рТ.
%н п2 п2п1м1 с2м2 п4 н2 с2 с1н1
%т здникъ пра-здни-комъ и то-рже-

%з пб_:/ м_/ сК. нЭ с=~бТ: пр=\
%н с1м1п2 м4 с2 н2 с2==с1м1 п2п1м1
%т ство _есть то-рже-ствомъ вонь

%з Э: пК: мК: сКч мК: с\ н= бТ:
%н с1м1 п2 м2 с2н2 м2 с2 н2 н1с1
%т же бла-го-сло-вимъ хри-ста _

%л.26о

%з мК: с\ н=
%н м2 с2 н4\
%т во вё-ки.

