%з вК: п_/ вК: рТ. мК: с\ н= ГнЭ нТ. м,,/: с=Э с_/ н=Э
%т свя-та'-гw бла-же'-нна-г*о *и=-и-су'-се хр[и]-сте`[:]
%н в2 п4 в2 в1п1 м2 с2 н4 г2 н1г1 н1с1м2 с2н2г1 г1н1с1 н4

%з Э: пК: мТ. нЭ Э: ГвДЭ в:/ч м=\ пЗ: нпт_./+- мК: рТ.
%т при-ше'--дше на за'-падъ со'-лнца[,] ви'-дёв-ши
%н с1м1 п2 м1с1 н2 п1в1 *м1в1п2 в1п1 м2м1с1 м1п1м1с1 н2п4 м2 м1с1

%з п/: м\? мт_./ с=ч Э: мК: нЧ т/:- =\ =
%т свё'тъ ве-че'-рн*ий по-е'мъ _о=-тца`[,] сы'-на
%н м1п1 м1с1 н2м2 с2н2 н1с1 м2 н1г1 н2г1 г1н1с1 н4

%з рТ. Э: м_/ сЭ м_/ сК. нЗ:Ф =:
%т и= свя-та'-г*о ду'-ха бо'-га[.]
%н н1г1 н1с1 м4 с2 м4 с2 н2н1г1с2с1н1с2н2г1н1с2

%н н4с2н1г1н1с1м4с2с1н1с2н2н1м1с4н4г2н1с1н4

%з мТ. пЗ: нЭ Э: п=: мЭ пК: рК: рТ. пК: мтДЭ мТ.
%т до-сто'-инъ _е=-си` во вся^ вре-ме-на` _ пё'тъ
%н м1с1 м1п1м1с1 н2 с1м1 п4 м2 п2 п2 п1м1 п2 м1с1н2 м1с1

%з в,,:/ пТ. в/: пЧ Э: п\ м=ч =\ = м_/ сТ нЗ:ФЗ =:
%т бы'-ти гла'-сы пре-по-до'-бны-ми[,] сы'-не бо'-
%н м1п1в2 п1м1 п1в1 п1м1 с1м1 п2 м2с2 н4 г4 м4 с2 н2н1г1с2с1н1с2н2г1н1с2

%т ж*ий
%н н4с2н1г1н1с1м4с2с1н1с2н2н1м1с4н4г2н1с1н4

%з Э: пК: рК: мК:чДЗ =: в,,:/ пК: рК: мТ. нЭ в,,:/ п=. м+
%т жи-во'тъ да-я'-й[:] тё'м-же м[и]'-ръ тя` сла'--витъ.
