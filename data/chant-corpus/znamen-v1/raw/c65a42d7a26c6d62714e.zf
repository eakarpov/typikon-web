%л.185о
%текст }Н{а[+]вели'цёй вече\р. }Н{е[+]стихологису'емъ.
 }Н{а гд\си возва\х. }П{оста'ви\м стихо'въ, 10. }И={ пое\м ст\хры. 
 }Г{ла'съ, 6.

%з Э: сК:ч #гТ. Э: нбДЭ! *нТЭ бТ: сК. Э: м\ с=ч
%н г1н1 с2н2 г1*н1 ц1г1 н!г!н1 *н2 г1н1 с2 н1с1 м2 с2н2
%т {Г}о-спо'дь во-зне-се'-ся _ на не-бе-са`[,]

%з сТ. пб_:/ стКч Э: сЩк мК: нЧ т/:- =\ =
%н с1н1 с1м1п2 с2н2 г1н1 с1н1с2 м2 н1г1 н2г1 г1н1с1 н4
%т да по'-слетъ о_у=-тё'-ши-те-ля м[и|i]-ру[|:]

%з *нЭ+ Э: нК. лТ: нТ! нб_/ Э: н\: Э: с,,/к Э: с\ н=
%н *н2 ц1г1 н2 г1с1 н1 г1н1.г! ц1г1 н4 г1н1 с1н1с1н1 г1н1 с2 н4
%т не-бе-са` о_у=-го-то'-ва-ша пре-сто'-лъ _е=-г[о]`[,]

%з с_/ нТ. с/: нТ. Э: сК.? бТ: м\ ст=Э б_/ т=Э
%н с4 н1г1 н1с1 н1ц1 г1н1 с1г1 н1с1 м2 с2н2г1 г1н1с1 н4
%т _о='-бла-цы во-схож-де'--н[и]-е _е=-г[о]`[|.]

%з пб_:/ мТ. п/: мЧ мт_./ с=ч сА нЭ сК. нТ. мт_./+ (=.ч)сЩ
%н с1м1п2 м1с1 м1п1 м1с1 н2м2 с2н2 с2 н2 с2 н1г1 н2м2 н1с1н1г1
%т а='-нге-ли ди-вя'-тся[,] че-ло-вё'-ка зря'-ще

%з нТ. мб,,/: ст=Э б_/ н=Э рТ! нб_/ Э: н\:
%н н1г1 н1с1м2 с2н2г1 г1н1с1 н4 н1 г1н1.г! ц1г1 н4
%т пре-вы'-ше се-бе`[|.] _о=-те'цъ бо жде'тъ[,]

%з рТ. сК. нТ. с/: н\? мт_./ рт=.\ мТ. пЗ: нТ.
%н н1г1 с2 н1г1 н1с1 н1г1 н2м2 м2с4н2н1г1н1с4н4 м1с1 м1п1м1с1 н1г1
%т _е=-го'-же въ+нё'-др[ё\х|ахъ] и='-мать с\ъ+со-бо'-ю

%з Э: м\ ст=Э б_/ н=Э
%н н1с1 м2 с2н2г1 г1н1с1 н4
%т при-сно-су'--щна[|:]

%л.186

%з с_/ нТ рТ. Э: сК. (Т:)л/:
%н с4 н2 н1ц1 г1н1 с2 г1с1
%т ду'хъ же пре-свя-ты'-[й]

%з нТ! нб_/ Э: н\: нЩкс нТ. Э: с\ н= рТ. сК. с/:
%н н1 г1н1.г! ц1г1 н4 н1г1с2 н1ц1 г1н1 с2 н4 н1г1 с2 н1с1
%т ве-ли'тъ _ всё^мъ а='-нге-л[о]мъ _е=-г[о]`[|:] воз-м[ё|и]'-те

%з н\? тЭ!- м=: пЗ: мб,,/: лЧ б/: =\ =
%н н1г1 н2с2 м4 м1п1м1с1 н1с1м2 н1с1 н1г1 н4 г4
%т вра-та` _ _ кня'--зи ва'-ш[а|я][,]

%з п/: мЧ ст_./ м=:шз мТ. Э: мК: лЧ б/: =\ =
%н м1п1 м1с1 н2с2 м3п1 м1с1 н1с1 м2 н1с1 н1г1 н4 г4
%т вси` _я=-зы'-цы во-спле-щи'-те ру-ка'-ми[,]

%з мТ рТ. пЗ: Э: м\ рт=.\
%н м2 м1с1 м1п1м1с1 н1с1 м2 м2с4н2н1г1н1с4н4
%т _я='-к[о] в[\ъ|]зы'-де хр[и]-сто'съ

%з мК: (=.ч)сЩ нТ. Э: м\ р=ч =\ =+
%н м2 н1с1н1г1 н1г1 н1с1 м2 м1с2м1 н2г2 н4\
%т и=-дё'-же бё` и= пе'-рв[и|ё]-е.

%Разница _о=ц~ъ (бо/) жде'тъ
   (с\ъ собою /со)присносу'щна
   дх~ъ же (пре/)ст~ы'й
