%код a01pl3
%текст {Г}ла'съ 2 й
%л.119о

%з сК: *нн/: #\?  (,,:/ш),,/ (=Т:)=\ (=.)н=рсТ: мК: ГнЧсл
%н с2 *н1н1 г1ц1 *н1ц1г1н1 г2ц1нг1 н2=н1с1 м2 г1с1
%т {П}ре-не-по-ро-чн[о_|]у-ю всё-__хъ

%з нб/: р=\ #= пТ.м рвЗ: Э: п\ (Кч)=ч =\
%н н1г1 н4 г4 п1м1 м1в1п1м1 с1м1 п2 м2с2 н4
%т ца-ри-ц[о_|]у пре-чис-т[о_|]у-ю дё--

%з Гн= сЭ: пК: мТ рТ. нпЗ: т_./ с=ч  нсЩк
%н г4 с1м1 п2 м2 м1с1 н1п1м1с1 н2м2 с2н2 н1г1с2
%т в[о_|]у со-ше-дше-с[_|]я вё-рнi-и днесь

%з #с/: н\? Оп_/ вб,,:/ п_/ Э:
%н н1с1 н1г1 н2с1м1п4 м1п1в2 п4 м1п1
%т о_у-бла-жимъ ма-терь хри-

%з вб=.\ш мК.ч н=бТ: пК: мТ рТ. нп/: м\?
%н в2в1п1 м2с2 н2с1м1 п2 м2 м1с1 н1п1 м1с1
%т ста бо-га при-сно бо к[|\ъ]сы-н[о_|]у

%з мт_./ с=ч сб_/: нТ рТ рТ. Э:
%н н2м2 с2н2 г1н1с2 н2 н2 н1г1 н1с1
%т р[о_|]у цё ми-ло-сти-вно про-

%з м\ с=Э _/ н=Э ##тТ:ФЗ н=: _ рЭ+ пб_:/ мТ.
%н м2 с2н2г1 г1н1с1 н4 г2с1н1г2 н2с2м1н1с1м1п2п1в1п2м2 м1.с!н1г1н1с1м1.с!н1с4с2н2г2н1с1н4 н2 с1м1п2 м1с1
%т сти-ра-ю-щ[о_|]у ю-же _ пре-ди-вный

%з мЭ: вК: мр/: пЧ сЭ: п\ (Кч)=ч с=\
%н м1п1 в2 м1в1 п1м1 с1м1 п2 м2с2 н4
%т ан-дрей ви-дё на во-зд[о_|]у--

%з Гн= нЭ+ пб_:/ рТ рТ рТ.
%н г4 н2 с1м1п2 п2 п2 п1м1
%т сё че-стнымъ сво-имъ по-

%з пК: мТ. нЭ~бТ: вК: рТ рТ рТ.м
%н п2 м1с1 н2=м1п1 в2 в2 в2 в1м1
%т кро--вомъ лю-ди по-кры-

%з ГвЗ: м=\ нпЗ: нОп_/ вК: п_/ вК: рТ. мТ
%н п1*м1в1п1 м2м1с1 н1п1м1с1 н2с1м1п4 в2 п4 в2 в1п1 м2
%т ва-ю-щ[о_|]у сей о_у-ми-лно во-зо-

%з с\ н= вб,,:/ пТ мТ. Э: вК: пТ
%н с2 н4 м1п1в2 п2 м1с1 м1п1 в2 п2
%т п[|*]и-емъ ра-д[о_|]уй-с[_|]я по-кро-ве

%з рТ. Э: п\ (Кч)=ч =\ Гн= пТ рТ. пК: мТ. нЭ
%н п1м1 с1м1 п2 м2с2 н4 г4 п2 п1м1 п2 м1с1 н2
%т и за-ст[о_|]у-пле-н[|*]и-е и спа-се-н[|*]и-е

%з мТ. вб_:/ п\ м+
%н м1с1 м1п1в2 п4 м4\
%т д[о_|]у ш[_|]ямъ на-шымъ.

