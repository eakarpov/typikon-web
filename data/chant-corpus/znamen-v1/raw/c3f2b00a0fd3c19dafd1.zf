%Набор Е.Нечипоренко
%Расшифровка Е.Нечипоренко

%код c21pl1
%текст {Н}а литi'и[.|,]
 {С}тр\хы {Г}ла\с . 4 [.|,]

%з мб,,/: сТ. сЗ:
%н н1с1м2 с1г1 н1с1н1г1
%т {С}вё-тло днес\ъ

%з сЭЭ\ р=? мТ рТ. вб,,:/ п./ч м_/? пЗ:
%н ц1г1н1с1 с1н3 м2 м1с1 м1п1в2 п1с1 м3с1 м1п1м1с1
%т цер-кви о_у-кра-ша-е-тся ра-

%з Э: мК: лЧ б/: н=\ г= сТ рТ. пб_:/
%н н1с1 м2 н1с1 н1г1 н4 г4 с2 с1н1 с1м1п2
%т ду-е-тся зо-ву-щи о_у-я-сни-

%з стК.ч Э: с_/? Э: вК: пТ. пК: м\
%н с2н2 г1н1 с3н1 м1п1 в2 п1м1 п2 м2
%т ся мо-я до-бро-та па-че

%з с= р./ч ст_/: Э: вК: пТ рТ.
%н с4 с1н1 г2н2с4 м1п1 в2 п2 п1м1
%т всёхъ и-бо свя-ти-те-лем\ъ

%з Э: п\ м= бТ: пб=ч с=\ н=
%н с1м1 п2 м2 с1м1 м1п3м1 с4 н4
%т кра-со-та _ сла-вный петръ

%з м_/ сТ. Э: п\ с= нЭ+ пб_:/
%н м4 с1н1 с1м1 п2 с4 н2 с1м1п2
%т взы-де к[|\ъ]не-бе-семъ ца-рю

%з мтДЭ пт_./+ р./ч Э: п\ м=
%н м1с1н2 м2п2 п1м1 с1м1 п2 м4
%т всёхъ цар-ству-ю-ще-му

%з нТ. Э: м_/ мЗ: н= мТ пК: пт_./
%н н1г1 н1с1 м4 с1м1с2 н4 м2 п2 с2п2
%т прi-и-ди-те же пра-здно-лю-

%з м= нТ. Э: мК: лЧ б/: н=\ г=
%н м4 н1г1 н1с1 м2 н1с1 н1г1 н4 г4
%т бцы пра-во-сла-вныхъ со-бо-ри

