%код w50sn

%текст }Б{г~оро'диченъ.

%з пр=.\о пК: мТ. нЭ мб=ч н,,/
%н н3г1 н2 г1ц1 *н2 *г1г4ц1 *н4
%т {Ц}е- - рковь и дверь _е-

%з г=` нК. мб_./+- пр=\ пК: мТ.
%н *г4 *н2 *г2г2 н3г1 н2 г1ц1
%т си по- ла- та и пре-

%з мК: с\ н=` бТ: пК: мТ. нЭ
%н г2 ц2 *н4 ц1г1 н2 г1ц1 *н2
%т столъ ца-ре- въ дё- во все-

%з мб=ч н,,/ г=` вТ *плК: вТ рТ.
%н *г1г4ц1 *н4 *г4 с2 с1п1 с2 с1г1
%т чи- ста- я _е-ю- же и-

%з *мЗ: Э: в\ п_/` Э: вр=\
%н н1м1с1н1 г1н1 с2 н4 г1н1 с3н1
%т зба- ви- тель мой хри- стосъ

%з Э: в\ п_/` нК. гЭ Э: мК:ч
%н г1н1 с2 н4 *н2 *г2 *н1ц1 г2ц2
%т и го-сподь и- же во тмё

%з нЭ мб_./+- пр=\ пК: мТ. мК.ч н=`
%н *н2 *г1г4 н3г1 н2 г1ц1 г2ц2 *н4
%т сё- дя- - щимъ _я- ви- ся

%л.27

%з п/: мТ. тЭ!- в=:` *мЗ: Э: в\
%н г1н1 г1ц1 г2н2 с4 н1м1с1н1 г1н1 с2
%т со- лнце сы- и пра- ве- дно-

%з п_/` рТ рТ. пК: мтДЭ мб=ч н,,/
%н н4 н2 н1г1 н2 г1ц1*н2 *г1г4ц1 *н4
%т е про-свё- ти- - ти хо-

%з г=` бТ: вр=\ Э: в\ п_/` рТ.
%н *г4 г1н1 с3н1 г1н1 с2 н4 н1г1
%т тя _ ихъ же со-зда по

%з пК: мТ. нЭ гЭ бТ: п=:` рТ.
%н н2 г1ц1 *н2 *г2 ц1г1 н4 н1г1
%т _w- бра- зу сво-е- му ру-

%з пК: мТ. нЭ мб=ч н,,/ г=` *пт_:/
%н н2 г1ц1 *н2 *г1г4ц1 *н4 *г4 с2м1п1
%т ко- ю сво-е- - ю тё-

%з вТ рТ рТ. Э: в\ п_/` мТ.
%н с2 с2 с1н1 г1н1 с2 н4 г1*н1
%т мже все-пё- - та-я _я-

%з Э: пК: мТ. нЭ мТ рТ. пЗ:
%н ц1г1 н2 г1ц1 *н2 г2 г1ц1 г1н1г1ц1
%т ко ма- те- рне де-рзно-ве-

%з тЭ!- в=:` Э: вр=\ Э: *п\ *м=ч
%н г2н2 с4 г1н1 с3н1 с1м1 п2 с1м1с1н1
%т нi- _е кне- му _ стя-жа-

%з =\ =` вТ рТ. *мЗ: Э: в\
%н г1н1г1ц1 *н4 с2 с1г1 н1м1с1н1 г1н1 с2
%т - вше не-пре- ста- нно мо-

%з п_/` рТ. пК: мТ. нЭ мб=ч н,,/ г+
%н н4 н1г1 н2 г1ц1 *н2 *г1г4ц1 *н4 *г8\
%т ли спа- сти-ся ду- шамъ на- шимъ.

