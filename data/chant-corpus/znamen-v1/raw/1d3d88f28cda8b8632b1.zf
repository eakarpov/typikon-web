%код a01ptr

%текст Покро'въ. Тропа'рь, гл.4.
%Набор Е.Ю.Нечипоренко
%л.90о

%з мт_./+- рТ сТ. мК: с\ н= сЗ: сбЭЭ\ р=ч сТ м\? мб_/: с=\ н=
%н н2м4 м2 с1н1 м2 с2 н4 н1с1н1г1 ц1г1н1с1 с1н4 с2 м1с1 н1с1м2 с4 н4
%т Дне'сь[,] бла-го-вё'-рн*и-и лю'-д*и-е[,] свё-тл[о] пра'-здну-емъ[,]

%з мЭ рТ. пт_./+ р\ м_/ Э: м_/ рТ рТ. пК: мТ р\ сб_/: =\ =
%н м2 м1с1 м2п2 п2 м4 н1с1 м4 м2 м1с1 п2 м2 м2 г1н1с2 н4 г4
%т *о=-сё-ня'-е-ми тво-и'мъ[,] бо-го-ма'-ти[,] при-ше'-ств*и-емъ[,]

%з нТ рТ. Э: мК:ч н\? сЗ: сбЭЭ\ р=ч Э: вК: пК: мТ.
%н н2 н1г1 н1с1 м2с2 н1г1 н1с1н1г1 ц1г1н1с1 с1н4 м1п1 в2 п2 м1с1
%т [и=|ик] [|къ+]тво-е-му` взи-ра'-ю-ще пре-чи'-сто-му

%з пЗ: нК.ч тЭ!- м_/ пДЭ пт_./+- мТ. м_/ с=. н=\ мб_/: с=.
%н м1п1м1с1 н2г2 н2с2 м4 п1м1с2 м2п4 м1с1 м4 с4 н2н1г1 н1с1м2 с4
%т *о='-бра-зу[,] _ _ _ _ _ _ _ _ _

%з Э: в=: пТ! рТ! мЗ:Ф=Э _ _ мТ. пт_./+ р\
%н м1п1 в4 п1 п1 м4п2п1м1с1м1п2м2 м1с1н1с1м2 с2н2с2м2п4м4 м1с1 м2п2 п2
%т о_у=-ми'-л[|ь]н[о] гла-го'--лемъ[:] по-кры'-й

%з м_/ рТ. пК: мТ рТ сб_/: =\ = мТ рТ. пт_./+ р\ м_/
%н м4 м1с1 п2 м2 м2 г1н1с2 н4 г4 м2 м1с1 м2п2 п2 м4
%т на'съ че-стн[ы\м|ы'мъ] си а=-мфо'--ромъ[,] и= и=-зба'-ви на'съ

%з Э: мК: лЧ б/: =\ = Э: вК: пТ. п/: мТ. нЭ Э: п=:
%н н1с1 м2 н1с1 н1г1 н4 г4 м1п1 в2 п1с1 м1п1 м1с1 н2 с1м1 п4
%т [*от|w\т] вся'-ка-г[о] sла`[,] _ мо-ля'-щи сы'-на сво-е-го

%з рТ. пК: мТ. нЭ пб=ч с=\ н= сТ рК. нтДЭ сТ м\? мб_/: с=\ +
%н п1м1 п2 м1с1 н2 м1п2м1 с4 н4 с2 с2 н1г1ц2 с2 м1с1 н1с1м2 с4 н4\
%т хри-ста' бо'-га на'-ше-го[,] да спа-се'-тъ ду'-ш[я|ы] на'-ш[а|я].

%Разница
[си а=мфо'ромъ|твои'мъ покро'вомъ]
[w\т вся'кагw sла`|и= и=зба'ви w\т вся'кагw sла`]
[своего`|твоего`]
[да спасе'тъ|сп~сти`]

