%з м./ч нЭ бТ: п=:` мЭ вК: рК: рК: п_/ вК: рТ. мТ с\ н=`
%н м1с1 н2 с1м1 п4 м2 в2 в2 в2 п4 в2 в1п1 м2 с2 н4
%т Крё-по--ст(е) да-я ца-рю на-ше-му го-спо-д(е)

%з Э: пК: мК. сТ рТ рТ. п/: мЧ Э: м\ с=ч`
%н с1м1 п2 м2 с2 с2 с1н1 м1п1 м1с1 н1с1 м2 с2н2
%т и ро-г(о) хри-ста сво-е-го во-зно-ся

%з с_/ рТ рТ. п/: мТ. нЭ Э: п=:` Э: *мК: вК:
%н с4 с2 с1н1 м1п1 м1с1 н2 с1м1 п4 п1в1 *м2 в2
%т wт дё-вы ра-жа-е-т(е)-ся       и-де-т[ъ|(е)]

%л.39

%з пТ. Э: п\? м=ч (ЭТ:)_/: п=:`
%н п1м1 с1м1 п1с1 м2с2 н2с1м1 п4
%т же ко кре-ще-нi-ю

%з р=: рТ рТ рТ. Э: вК: рТ. мТ с\ н=` бТ:
%н п4 п2 п2 п1с1 м1п1 в2 в1п1 м2 с2 н2 м1п1
%т тёмъ вё-р(е)-нi-и во-зо-пi-е-м(о) _

%з втК:ч *м!/: втДЭ п=.` вК: рК: пТ. Э: в=: п=. м+
%н в2п2 в2*м2 в1п1м2 п4 в2 в2 п1с1 м1п1 в4 п4 м4\
%т нё-ст(е) свя-та _я-ко-же бо-г(о) на-ш(е).

