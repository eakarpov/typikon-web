%код vlt3

%текст }П{овы'ходё пое\м.

%з пТ. в/: п\? вбЭЭ\ рт=ч` Э:
%н н1г1 н1с1 н1г1 ц1г1н1с1 с1н2 г1н1
%т {С}вя-ты-я сла-вы без-

%з вК: пТ. п\ с=` вК: рК:
%н с2 н1г1 н2 ц4 с2 с2
%т сме--ртна-го wт-ца

%л.93

%з Э: *м\ в=чк =\ =` Э: вК:
%н н1с1 м2 с1н1с2 н2г2 н4 г1н1 с2
%т _ не-бе-сна-го свя-та-

%з п=чб в/: п\? пб=ч м,,/к с=` пТ.
%н г1н2г1 н1с1 н1г1 ц1г1н2 г1ц1г2 ц4 н1г1
%т -го бла-же-нна-го и-

%з вЗ: Э: в\ п_/` сЭ вб,,:/ пТ.
%н н1с1н1ц1 г1н1 с2 н4 ц2 г1н1с2 н1г1
%т су-са хри-ста сы--на

%з пК: м\ с=` пТ. вЗ: тЭ!- *м_/`
%н н2 г2 ц4 н1г1 н1с1н1г1 н2с2 м4
%т бо-жi-я при-ше-дша-го

%з *мб,,:./ лЧ б/: п=\ м=` *пб_:./
%н н1с1м2 н1с1 н1г1 н4 г4 с1м1п2
%т на за-падъ со-лнцу ви-

%з *мК:. вТ ртДЭ Э: *м\ в=чк =\
%н м2 с2 с1н1г2 н1с1 м2 с1н1с2 н2г2
%т дё-вше свё-тъ ве-че-рнi-

%з =` Э: вК: пТ. в/: п\? вбЭЭ\
%н н4 г1н1 с2 н1г1 н1с1 н1г1 ц1г1н1с1
%т и по-_емъ wт-ца и сы-

%з рт=ч` пТ. Э: вК: пб=ч в/: п\?
%н с1н2 н1г1 г1н1 с2 г1н2г1 н1с1 н1г1
%т на и свя-та-го ду-ха

%з пб=ч м,,/к с=` пТ. вЗ: Э: в\
%н ц1г1н2 г1ц1г2 ц4 н1г1 н1с1н1ц1 г1н1 с2
%т бо--га до-сто-инъ _е-

%з п_/` Э: вК: пТ. п\ с=` *пб_:./
%н н4 г1н1 с2 н1г1 н2 ц4 с1м1п2
%т си во вся вре-ме-на пётъ

%з *мК:. вТ р=: рТ. Э: *м\ в=чк =\ =`
%н м2 с2 с4 с1г1 н1с1 м2 с1н1с2 н2г2 н4
%т бы-ти гла-сы пре-по-до-бны-ми

%л.94

%з сЭ вб,,:/ пТ. пК: м\ с=` пТ.
%н ц2 г1н1с2 н1г1 н2 г2 ц4 н1г1
%т сы--не бо-жi-и жи-

%з в/: п\? тЭ!- *м_/` рК:. вЗ: п=\
%н н1с1 н1г1 н2с2 м4 м2 н1с1н1г1 н4
%т вотъ да-я-и все-му ми-

%з м=` Э: вК: пТ. пК:ч с=` вК:
