%Расшифровка Е.Ю.Нечипоренко
%Набор Е.Ю.Нечипоренко
%л.16о
%код a01pkd
%Название Покро'въ.  }К{онда\к гл.3.
%л.17об.

%з вб,,:/ пТ. пК:ч с= пТ.с Э: вК: пДЗЩФ =:
%н м1п1в2 п1м1 п2м2 с4 п1с1 м1п1 в2 п2п1м1с2м2 п2в1п1м2п2м1п1в4
%т Дё'-ва-я дне'сь пре-дсто-и'тъ в\ъ+це'-ркви

%з Э: вК:ч? пК: м/: с= пТ. пК: в/: п\? Э!- *м=.\ *пЗ:
%н м1п1 в2п1м1 п2 н1м1 с4 п1м1 п2 п1в1 п1м1 п2в2 *м2*м1в1 *м1*п1*м1в1
%т и= с[|\ъ+]ли'-ки свя-ты'хъ не-ви'-ди-м[о] бо'-гу за

%з *мб_:/ вЗ: п=\ м= сА нЭ Э: вК: пТ. пК: м/: с=
%н п1в1*м2 п1в1п1м1 п4 м4 с2 н2 м1п1 в2 п1м1 п2 н1м1 с4
%т ны` мо'-ли-тся[:] а='-нге-ли со свя-ти'-те-ли

%з в/: п\? пб=ч м,,/ с= пА рТ. вК: рпТ рТ. в/: п\? *мт_:/-
%н п1в1 п1м1 с1м1п2 м1с1м2 с4 п2 п1м1 в2 п2 п1м1 п1в1 п1м1 п2в2*м4
%т по-кла-ня'-ю-тся[,] и= а=-по'-сто-ли со про-р[о]'-

%з *пЗ: *мб_:/ лЧ п/: р=\ м= пТ. в/: п\? вбЭЭ\ р=ч
%н *м1*п1*м1в1 п1в1*м2 п1в1 п1м1 п4 м4 п1м1 п1в1 п1м1 с1м1п1в1 в1п4
%т ки ли-ков-ству'-ю-т(е)[:] на'-с(о) бо ра'-ди

%з мТ. Э: в=: *мК:ч *м:/ч пТ. пб,,:/ мЭ пК:- мТ. мК.- с= мК.- с=
%н м1с1 м1п1 в4 *м2в2 *м1в1 п1м1 с1м1п2 м2 п4 м1с1 м2 с4 м2 с4
%т бо-го-ро'-ди-----ца _ _ _ _ _

%з пА рТ рТ. Э: вК: вб=чп в/: п\? п=ч м,,/к с+
%н п2 п2 п1с1 м1п1 в2 м1п2м1 п1в1 п1м1 с1м1п2 м1с1м2 с4\
%т хри-ста` мо'-литъ пре-вё'-ч(е)-на-го бо'-га.

%Разница [Дё'вая|Дё'ва]
[бг~у за ны` мо'лится|за ны` мо'лится бг~у]
[со святи'тели |со а=рхiере'и]
[богоро'дица христа` мо'литъ|мо'литъ бц\да]

