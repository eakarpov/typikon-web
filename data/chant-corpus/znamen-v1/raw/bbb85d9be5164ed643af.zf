%т --------ду-

%з сТ:м п=: р=: мК: пб_:/ мК: пб_:/ мК:
%н с1м1 п4 п4 м2 с1м1п4 м2 с1м1п4 м2
%т -йся _

%з пб_:/у мЭ вК: пК: мТ вК:- п=: сТ. мК:
%н с1м1п1 м1 в2 п2 м2 в4 п4 с1н1 м2
%т _ _ _ _ _ w--бра--

%з сК нЭ Э: пК: сКч с_/ р=. нТ г= н=.
%н с2 н2 с1м1 п2 с2н2 с4 с4 н2 г4 н4
%т --до-ва-нна-я го----

%з пК: р*м,,%/ш- вК: п./ч пК: нс/: нТ. н=. г=
%н п2 п1в1*м4 в2 п1м1 п2 н1с1 н1г1 н4 г4
%т спо-----дь сто-бо-ю

%л.14о

%з Э: пК: м/: с=чк пК: м\? т=: мТ. пб_/ Э: п\
