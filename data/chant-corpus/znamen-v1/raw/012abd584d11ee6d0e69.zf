%Расшифровка Е.Ю.Нечипоренко
%Набор Е.Ю.Нечипоренко
%л.16о
%код a01ptr
%Название Тропа'рь, гла'съ д~
Покрову` прес~ты'я б\дцы
%л.16-16о
%Расшифровка Е.Ю.Нечипоренко
%Набор Е.Ю.Нечипоренко

%з м_/ мЗ: н= Э: пТ. Э: п\ м= пК: пт_./ м= мб_/: сТ нТ
%н м4 с1м1с2 н4 с1м1 п1м1 с1м1 п2 м4 п2 с2п2 м4 н1с1м2 с2 н2
%т Д(е)-не'-с(е)[,] бла-го-вё'-рн*и-и лю'-д*и-е[,] свё'-т(е)-лw

%з гЭ сК: Д~З~Ф =: _ мА рТ пК: пт_./ м= Э: вК:
%н г2 с2 н1г1ц2 г2н2 с1н1г1н1с2н4г1н3с4н4 м2 м2 п2 с2п2 м4 м1п1 в2
%т пра'-здну-[и|е]-м(о)[,] _ w=-сё-ня'-е-ми тво-и'мъ

%з пТ мТ. пК: мТ р\ сб_/: н=\ г= гЭ+ нТ. Э: м_/ сТ. Э: пК: м/: с=
%н п2 м1с1 п2 м2 м2 г1н1с2 н4 г4 г2 н1г1 н1с1 м4 с1н1 с1м1 п2 н1м1 с4
%т бо-го-ма'-ти при-ше'-ств*и-емъ[,] и= к(о) тво-е-му` взи-ра'-ю-ще

%з Э: вК: пТ мТ. пЗ: нКч Ф~З~=: _
%н м1п1 в2 п2 м1с1 м1п1м1с1 н2г2 н2с2м4 п1м1с2м2п4м1с1м4с4н2н1г1н1с1м2с4
%т пре-чи'-сто-му w='-бра-зу[,] _

%з Э: пК: мТ. Э: (=:ш)в=: (З~З~=+~=:)вт_./+ пК.- мТ. н= гЭ с/: н= п=\ вЗ:
%н с1м1 п2 м1с1 м1п1 в4 п2в2 п2 м1с1 н4 г2 н1с1 н4 п2п1м1 п1в1п1м1
%т о_у=-ми'-л[|ь]н[о] гла-го'-----ле--мъ[:] по-кры'й

%з пб_/:о п=: Э: в=: пТ! рТ! мЗ:Ф=Э _
%н с1м1п1м1 п4 м1п1 в4 п1 п1 м4п2п1м1с1м1п2м2 м1с1н1с1м2 с2н2с2м2п4м4
%т на'-с(о) чест-ны'мъ си` а=-мфо'--ромъ[,]

%з мб_:/ сТ. с/: н\ сбЭЭ\ р=ч Э: м_/ сТ рТ. Э: пК: м/: с=
%н н1с1м2 с1г1 н1с1 н1г1 ц1г1н1с1 с1н3 н1с1 м4 с2 с1н1 с1м1 п2 н1м1 с4
%т w=-т(о) вся'-ка-г[о] sла`[,] мо-ля'-щи сы'-на сво-е-го`

%з рТ рТ рТ м\? мб_/: с=\ н= Э: пК: пт_:/ б**/ лЧ г/:ц *н=\ *г+
%н с2 с2 с2 м1с1 н1с1м2 с4 н4 с1м1 п2 с4м2п2 с1н1г2н4 г1н1 г1ц1 *н4 *г4\
%т хри-ста` бо'-га на'-ше-го[,] да спа-се'-т(е) ду'-ш[а|ы] на'-ш[а|я].

%Разница
[си а=мфо'ромъ|твои'мъ покро'вомъ]
[w\т вся'кагw sла`|и= и=зба'ви w\т вся'кагw sла`]
[своего`|твоего`]
[да спасе'тъ|сп~сти`]

