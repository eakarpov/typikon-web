%код pcl5

%з п_/ вК: рТ. мТ с\
%н п4 в2 в1п1 м2 с2
%т {С}ла-ва те-бё хри-

%з н= рЭ+ Э: пК: мТ. нЭ мТ. пЗ: Э:
%н н4 н2 с1м1 п2 м1с1 н2 м1с1 м1п1м1с1 н1с1
%т сте и-же в\ъвы--шнихъ сё-дя-ще-

%з мК: лЧ б/: =\ = Э: пК: мТ. пЗ: Э: м\
%н м2 н1с1 н1г1 н4 г4 с1м1 п2 м1с1 м1п1м1с1 н1с1 м2
%т му на пре-сто-лё и ны-нё ча-е-мо-

%з с=ч Э: мК: (Т.)Ч т/:- =\ =
%н с2н2 н1с1 м2 н1г1 н2г1 г1н1с1 н4
%т му съ+че-стнымъ тво-имъ кре-стомъ

%з тТ:оФЗ =: _ пК: рТ. в/: пЧ Э: п\ м=ч нЭ бТ:
%н н2с1н1г2 н2с2м1н1с1м1п2п1в1п2м2 м2с!н1г1н1с1м2с!н1с4с2н2г2н1с1н4 п2 п1м1 п1в1 п1м1 с1м1 п2 м2с2 н2 с1м1
%т тё-мже _ ве-се-ли-ся дщи си-о-но--

%з п=: вб,,:/ рК: пТ рТ рТ. вЗ: Э: п\
%н п4 м1п1в2 в2 п2 п2 п1м1 п1в1п1м1 с1м1 п2
%т ва ра-ду-ю-тся _я-зы-цы зем-

%з =ч =\ = нЭ+ пб_:/ мТ рТ. пЗ: мт_./
%н м2с2 н4 г4 н2 с1м1п2 м2 м1с1 м1п1м1с1 н2м2
%т ни--и и вё-тви де-ржатъ дё-

%з с=ч пК: мТ сТ нТ. Э: м\ рт=.\ мТ рТ. пЗ:
%н с2н2 п2 м2 с2 н1г1 н1с1 м2 м2с4н2н1г1н1с4н4 м2 м1с1 м1п1м1с1
%т ти ри-зы же о_у-че-ни-цы и _е-ди-

%з Э: м\ с=ч сТ рТ. Э: мК: (Т.)Ч
%н н1с1 м2 с2н2 с2 с1г1 н1с1 м2 н1г1
%т но w\т всёхъ слы-ша-ше-ся со-

%з т/:- =\ = нЭ сТ. Э: пК: мТ. пЗ: мт_./
%н н2г1 г1н1с1 н4 н2 с1н1 с1м1 п2 м1с1 м1п1м1с1 н2м2
%т гла-сi-е бла-го-сло-венъ _е-си спа-

%з с=ч н./ч бТ: мК:? (Т.)Ч т/: =\ =+
%н с2н2 н1г1 н1с1 м2 н1г1 н2г1 г1н1с1 н8\
%т се по--ми---луй насъ.

