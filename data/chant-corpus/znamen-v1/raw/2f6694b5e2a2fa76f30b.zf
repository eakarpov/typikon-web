%код dtlc
%текст }Н{алит*и'и, }С{ла'ва }Г{ла'съ, 6.
%л.15

%з с_/ слТ:? нуТ! нб_/? Э: н\: сТ. Э: м_/ сТ. Э: пК:
%н с4 н1с1 н1 г1н1.г! ц1г1 н4 с1г1 н1с1 м4 с1н1 с1м1 п2
%т Со'-лнце лу-ч[и|ы]` со-кры`[,] и= лу-на` со [з|_з]вё-зда'-

%з ст!/:у т=: мК: (=.ч)Щ Э: м\ с=Э сб_/ н=Э
%н н2с1н1г2 н2с2н2н1м1с4н4 м2 н1с1н1г1 н1с1 м2 с2н2г1 г1н1с1 н4
%т -ми в[|\ъ]кро'-вь пре-ло-жи'--ся[,]

%л.15о

%з пб_:/ сК.ч лТ:с нТ! нб_/? Э: н\: Э: нК.ч(Т.) *нЭ
%н с1м1п2 с2н2 г1с1 н1 г1н1.г! ц1г1 н4 ц1г1 н2г1ц1 *н2
%т го'-ры о_у=-жа-со'-ша-ся и= хо'-лми

%з #гТ рТ. Э: с,,/к мт_./ с=ч Э: мК: сЩк мК:? нЧ нт/:- с=\ н=
%н г2 г1ц1 г1н1 с1н1с2 н2м2 с2н2 н1с1 м2 с1н1с2 м2 н1г1 н2г1 г1н1с1 н4
%т во-стре-пе-та'--ша[,] _е=-гда` ра'й за-тво-ри'--ся[.]

%з сТ. м/: сК.ч су=.ч =\ =                               Э: м=\ пЗ:
%н с1н1 с1м1 с2н2 с1н1г2н2н1ц1 г1н1г1ц1г1н1г1 ц1г2ц4г2ц4 н1с1 м2м1с1 м1п1м1с1
%т и=-схо-дя` _ а=-да'мъ                                 ру-ка'--

%з нЭ Э: ст!/:у #г\ т=:              мб,,/: с=Э сб_/ н=Э
%н н2 г1н1 н2с1н1 г2 н2с2н2н1м1с4н4 н1с1м2 с2н2г1 г1н1с1 н4
%т ма бi-я` [|въ+]ли-це`[,]        гла-го'-ла-ше[:]

%з тЭ- пК:ч ст=.\РФЗ =:
%н с2м2 п2м2 с4с2н2 г2с1н1г2н2г4н2с2н1г1с4н2н1с1н2г2Ь(г1с1с1н1г1с1с1н1г2н2г1 ц1г2ц4г2ц4)
%т ми'--ло-сти-ве[,]

%з мК: Щ Э: м\ р=ч =\ +
%н м2 н1с1н1г1 н1с1 м2 м1с2м1 н2г2 н4\
%т по-ми'-луй мя` па'-дша-го.

%Примечание На поле дан развод площадки на слове "звездами"

%з {нЭ стДЭ ст_./ нТ м/: с=. н=}

%Разница с[о|]кры` [и|]
   [и|] хо'лми
   за[твор|ключ]и'ся.

