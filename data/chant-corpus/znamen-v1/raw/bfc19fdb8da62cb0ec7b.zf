%з пт_./+- рТ рТ рТ. Э: в\ п=` мЭ+ Э:
%н м2п4 п2 п2 п1с1 м1п1 в2 п4 м2 м1п1
%т Вско_у-ю мя w-т(о)-ри-ну w\т ли-

%з вК: рТ рТ рТ рТ рТ рТ. мЭ птК:ч спт!/: м=`
%н в2 в2 в2 в2 в2 в2 в1п1 м2 п2м2 с2п2 м4
%т ца тво-е-го свё-те не-за-хо-дя-и

%з пА рТ. *мб_:/ вТ. мЭ п=.` рТ. *мб,,:/ вК:
%н п2 п1м1 п1в1*м2 в1п1 м2 п4 п1м1 п1в1*м2 в2
%т по-кры-ла мя _е-сть чю-жа тма

%з рТ. мЭ п_/ мтКч м=` пА м=. Э: в=: Э:
%н в1п1 м2 п4 м2с2 м4 п2 м4 м1п1 в4 м1п1 
%т w-ка-я-нна-го но w-бра-ти мя

%з вК: рТ рТ рТ. мЭ п_/ м=` Э: вК:
%н в2 в2 в2 в1п1 м2 п4 м4 м1п1 в2 
%т к\ъ+свё-ту за-по-вё-дей ти пу-ти

%з рТ рТ пТ. вб_:/ пК: мТ. м_/ стДЭ н+
