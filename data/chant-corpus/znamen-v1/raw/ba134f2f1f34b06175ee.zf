%л.151
%Набор Е.Ничипоренко
%код w20tr
%Расшифровка С. Хохряков
%текст {Т}ро\п.

%з мА п/: \ _/: п=:` р_/ вК: рТ.
%н м2 м1п1 м1с1 н2с1м1 п4 п4 в2 в1п1
%т {_Е=}-гда` с(0)-ни'-де к(0) сме'-рти

%з Т \ =` Э: Гв:/ч Э в./ч м=\ пЗ:`
%н м2 с2 н4 п1в1 *м1в1 п2 в1п1 м2м1с1 м1п1м1с1
%т жи-в0-т[ё]` бе[|з]-с(0)-ме'-рт(е)-ны-[й][,]

%з Э пт_./+ р/: Ч Э: м\ =?` мА
%н н2 н2п4 м1п1 м1с1 н1с1 м2 с2н2 м2
%т т0-гда` а='-да о_у=-ме-ртви` бли-

%з рТ. мК: Т \ =Э _/ =Э` Э: пК:
%н м1с1 м2 с2 н2 с2н2г1 г1н1с1 н4 с1м1 п2
%т ста'-н[и]-е-м(е) б0-же-ства`[.] _е=-гда'

%з тКч м_:/ Ч т/:- =\ =` Т. сК: р/: \
%н с2н2 н1с1м2 н1г1 н2г1 г1н1с1 н4 н1г1 с2 н1с1 н1г1
%т же о_у=-м[е]'-р[|(е)]-ш[а|ы]-[_я] w-т(о) пре-и-

%з пО_/` рТ. Э: п\ =ч =\ =` Э:
%н н2с1м1п4 п1м1 с1м1 п2 м2с2 н4 г4 с1м1 
%т сп0'-д(е)-ни-х(0) в0-скре-си`[,] вс[_я]^

%з пК: мТ рТ. п/: \ _./ м=:` рК: Ч /:
%н п2 м2 м1с1 м1п1 м1с1 н2с2 м4 м2 н1г1 н2г1  
%т си^-лы не-б[е]'-с(е)-ны-[_я] в0-п[и]-я'-

%з =\ =` мТ. пЗ: Э бЭ: п=:` рТ.м
%н г1н1с1 н4 м1с1 м1п1м1с1 н2 с1м1 п4 п1м1 
%т х[о_у] ти[:] жи-зн0-да'-в(е)-че хр[и]-

%з рК: (Т.)ДЭ (Э)Т. в_:/ рТ \ +
%н п2 м1с1 н2 м1п1в2 в2 п2 м4\
%т сте` б0'-же[,] сла`-ва те-бё`.

%Разница
   [сни'де|снизше'лъ _е=си`] къ сме'рти
   а='д[а|ъ] о_у=мертв[и`|и'лъ _е=си`]
   [|и=] о_у=ме'ршыя
   воскр~с[и`|и'лъ _е=си`]
   [вопiя'ху ти`|взыва'ху]
   бж~е [|на'шъ]

