%з *нЭ+ нб_/:шзс рЧ тЭ- с=. Э: пК: м\ с=
%н *н2 ц1г1н1с1 с1н1 г2н2 с4 с1м1 п2 м2 с4
%т в\ъ+не'-мъ со-тво'-рше[,] не в\ъ+бра'--шнёхъ

%з м/: сЧ Э: сК. лЧ б/: Г=\ н= сА рТ. пт_:/ сТ.
%н с1м1 с1н1 г1н1 с2 г1с1 н2 г4 н4 с2 с1н1 с2м1п1 с1н1
%т и= пи-тi-и'-хъ тво-ря'-ще[,] но в\ъ+мо-ли'-твё

%з Э: с\ нт=.\ нТ. Э: сК. рТ нТ. лЭ:с
%н г1н1 с2 н4н2г2 н1ц1 г1н1 с2 с2 н1ц1 г1с1
%т и по-стё` до-бро-дё'-те-ли и=-

%л.32о

%з р./ч рну=чк *н,,/ *г=
%н с1н1 н!г!ц1г1ц1 *н4 *г4
%т спра-вля'-ю-ще[:]

%з нб_/:шзс рЧ тЭ- с=. рТ рТ. м/: сЧ Э: сК. лЧ б/: Гн=\ н=
%н ц1г1н1с1 с1н1 г2н2 с4 с2 с1г1 н1м1 с1н1 г1н1 с2 г1с1 н2 г4 н4
%т си'-ми дё'-лы о_у=-го-жда'-емъ бы-ва'-етъ го-спо'-дь[,]

%з сТ плК: сТ нТ. Э: с\ нХ сК.ч(Т.) Э: нК.ч нТ сК. Г\? *н,,/ *г=
%н с2 с1п1 с2 н1ц1 г1н1 с2н1 с1н2 с2н1г1 ц1г1 н2г2 н2 с2 г1ц1 *н4 *г4
%т и= пё'-нязь по-да-ва'-етъ и='-мже ду'-шы и=-зба-вля'-етъ

%з ГТ. Э: с_/о Э: пК.ч с=          Э: сК. нТ ГТ. Э: сК. ГТ ц\ *н+
%н г1ц1 г1н1 с3н1 с1м1 п2м2 с4     г1н1 с2 н2 г1ц1 г1н1 с2 г2 ц2 *н4\
%т w\т до-лго'въ грё-хо'-вныхъ[,] _е=-ди'-не мно-го-ми'-ло-сти-ве.

%текст }С{ла'ва, па'ки ту'же ст\хру.

%Примечание Из Тих.333, л.93:
%з Э: сК. нК. рТ. Э: сК. гТ? *н,,/ *г+
%н г1н1 с2 н2 н1ц1 г1н1 с2 г1ц1 *н2 *г4\
