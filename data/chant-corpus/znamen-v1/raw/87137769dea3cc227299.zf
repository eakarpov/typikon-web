%код wupc
%л.124о
%текст }Г{ла'съ 1 :

%з нТ рТ рТ сК. Э: пК: мТ. м\
%н н2 н2 н2 с2 с1м1 п2 м1с1 м2
%т {И}-детъ че-рнецъ и[-|з\ъ] [з|]мо-на-сты-

%з с+ _ нТ рТ рТ рТ гЭ сТ
%н с4==/ = н2 н2 н2 н2 г2 с2
%т ря, {2} {В}стре-чю _е-му вто-ры-

%з рТ нТ г= _ пТ вТ рТ мЭ
%н с2 н2 г4==/ = п2 в2 в2 м2
%т и че-рнецъ; {3 W}тъ-ку-ду ты

%з пК: вТ рТ рК: пр=\ с+ _ мТ рТ рТ
%н п2 в2 в2 в2 п2п1м1 с4==/ = м2 м2 м2
%т бра-те гря-де--ши {4 И}[-|з\ъ] [с|]ко-нста-

%з с= мТ! рТ! сК. нЭ с_/ н+
%н с4 м1 м1 с2 н2 с4 н4==/
%т нти--на гра--да _;

%з _ мТ рТ рТ рТ пТ вК: рК: пК:
%н = м2 м2 м2 м2 п2 в2 в2 п2
%т {5 С}я-демъ мы бра-те по-бе-сё-

%з мТ. м\ с+ _ гТ рТ рТ рТ рТ
%н м1с1 м2 с4==/ = г2 г2 г2 г2 г2
%т -ду-емъ; {6 Ж}и-ва ли та-мо

%з н_/ рТ сТ нЭ гЭ н+
%н н4 н2 с2 н2 г2 н4==/
%т бра-те ма-ти мо-я;

%з _ сТ рТ рТ рТ рТ рТ нЭ мК:
%н = с2 с2 с2 с2 с2 с2 н2 м2
%т {7 О}_у-же ма-ти тво-я да-вно

%з рТ с\ н_/ г+ _ нЭ мК: рК:
%н м2 с2 н4 г4==/ = н2 м2 м2
%т о_у-ме-рла _; {8 О}_у-вы мнё

%з гЭ н= м:/ч мК: лЧ б/: =\ +
%н г2 н4 м1с1 м2 н1с1 н1г1 н4 г4==\
%т о_у-вы мнё ма-ти мо-я _;


