%т спа'-се[,] да'-р[о_у]-[_я] м[и]'-ро-ви жи'-зн(е)[,]

%з сА рТ. б_/:о с=:` рТ. мК: Т \ б_/: =\ =`
%н с2 с1н1 г1н1с1н1 с4 с1н1 м2 с2 н1г1 н1с1м2 с4 н4
%т се-г[0]` ра'-ди си^-лы не-б[е]-с(е)-ны-я

%з мТ Т =+ _:/шФЗ =:` вК: Т. пК:
