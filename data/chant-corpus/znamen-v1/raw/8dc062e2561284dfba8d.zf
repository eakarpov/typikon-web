%Набор Е.Нечипоренко
%Расшифровка Е.Нечипоренко

%код 920hx2

%з Э: м_/ рТ
%н н1с1 м4 м2
%т {W\т} ко-ре-

%з рТ сТ. р\ н= Э: (_/)м=: нр=.чс н= мТ.
%н м2 с1н1 с2 н4 н1с1 м4 н1м1с2 н4 м1с1
%т не из-ра-сте че-стна--гw, ми-

%з вб_:/ пТ рТ рТ. пт_./+ м=. вб,,:/ пТ
%н м1п1в2 п2 п2 п1м1 с2п2 м4 м1п1в2 п2
%т хай-ле бла-го-ро-дне. ис-ти-

%з рТ. Э: п\ м= мТ рТ.
%н п1м1 с1м1 п2 м4 м2 м1с1
%т ну воз-лю-бивъ, и не-

%л.16

%з пК:ч сб_/: н=\ г= Э: м_/
%н п2м2 г1н1с2 н4 г4 н1с1 м4
%т тлё-нный хри-стовъ из-во-

%з сТ м\ н=+ Э: вК: пТ
%н с2 м1с1 н4 м1п1 в2 п2
%т ли жи-вотъ, и ца-рство

%з (Т)нр/: (Т.)мЧ (З:~Кч)нКч ФЗ (Кч)с=: сК: нтДЭ сТ м\?
%н н1п1 м1с1 н2г2 н2с2м4п1м1с2м2п4м1с1м4с4н2н1г1н1с1м2 с2н2 с2 н1г1ц2 с2 м1с1
%т не-ру-ши-мо, _ с\ъ_фе-о-д_w-ромъ

%з мб_/: =\ н= Э: м_/ сТ рТ. Э:
%н н1с1м2 с4 н4 н1с1 м4 с2 с1н1 с1м1
%т ди--внымъ за-ко-ннw по-стра-

%з пК: л\ с= ГнТб рТб нКч ФЗ (Кч)с=: мТ. пт_./+
%н п2 н1м1 с4 г1 г1 н2г2 н2с2м4п1м1с2м2п4м1с1м4с4н2н1г1н1с1м2 с2н2 м1с1 м2п2
%т да--вша, и вё-нца _ _ по-бё-

%з рТ. Э: п\ м= сК: нТ. Э:
%н п1м1 с1м1 п2 м4 с2 н1г1 н1с1
%т ды при-я-ста, му-че-ни-

%з м_/ сТ. Э: пК: л\ с= нЭ+ Э: пК:
%н м4 с1н1 с1м1 п2 н1м1 с4 н2 с1м1 п2
%т ка все-свя-та--я, и мо-ли

%з мК. сТ нтДЭ сТ м\? мб_/: с=\ +
%н м2 с2 н1г1ц2 с2 м1с1 н1с1м2 с4 н4\
%т тве-ни-ка w ду-шах\ъ на-шихъ.

