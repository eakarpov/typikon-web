%Набор Е.Нечипоренко
%Расшифровка Е.Нечипоренко

%код 624_x1
%л.273о
%текст {Н}а хвали'тё\х. {С}тр\хы
%л.274
%текст [{Н}а|{Г}ла\с] 4 {П}о\д. {З}ванъ свы'ше.

%з сА рТ
%н с2 с2
%т {W\т} не-

%з рТ. Э: п\ рЗ: нТ. м_/: (сТ)н=: (нЭ)сК. (сК.ДЗФ)ДЗФ (=:)н=:
%н с1н1 с1м1 п2 м1п1м1с1 н1г1 н1с1м2 н4 с2 н1г1ц2 г2н2с1н1г1н1с2н2 г1н3с4н4
%т пло--дны-я ро-ди-ся о_у-тр_w-бы.

%з сТ. Э: пК: м\ (сТ.)Э: т_:/ б**/ н=. нТ.(г) рЗ:
%н с1н1 с1м1 п2 м2 с1н1 с4м2п2 с1н1г2 н4 г1ц1 г1н1г1ц1
%т раз-рё-ши-вый не-пло-дi-е сер-децъ

%з ,,/н =г сК. нЭ Э: п=\ вЗ: сК.ч п_/:о р=: мтДЭ п/:
%н *н4 *г4 с2 н2 с1м1 п2п1м1 п1в1п1м1 с2н2 с1м1п1м1 п4 м1с1н2 м1п1
%т на-шихъ. и бла-го-ча-дi-е в[|\ъ]вё--рё же

%з (мДЭт)бД п=.ч  (=\)рт=.\ (=)=: Э: м_/ Э: пК:~л\
%н м!с!н1 м1п3 п2м1 с1м2с4м2с4 н1с1 м4 с1м1 п2==н1м1
%т и и-сти-нё, ду-шямъ не-пл_w-

%з с= рТ м\? мб_/: =\ = п_/:о р=:
%н с4 с2 м1с1 н1с1м2 с4 н4 с1м1п1м1 п4
%т днымъ сло-во да-ру-я, слав-ный

%з вК: пТ. рК.ч с= нЭ+ п_/:о рК: мТ.
%н в2 п1м1 п2м2 с4 н2 с1м1п1м1 п2 м1с1
%т пре-до-те-че при-ше-ств[|*]и-я

%з нЭ п=.ч рт=.\ ст=: пб_:/ мК. с= (мТ.~нп/:)мДЗ (мТ.)мТ.
%н н2 м1п3 п2м1 с1м2с4м2с4 с1м1п2 м2 с4 м1с1м1п1 м1с1
%т хри-ст_w--ва. гла-а-асъ сл_w-

%з нЭ мТ. в_:/ =\ = мТ. Э: в=.\~Р~Ф З п_/ мтДЭ
%н н2 м1с1 м1п1в4 п1м1п4 м2п1в1п4 м1с1 м1п1 в4в2п2 м2в1п1м2п2м4п2в2*м2в2п1м1 п4 м1с1н2
%т ва на-ро-чи-тый по-ка-я-нi-я про-

%з п/: бД п=ч =\ = мТ. Э: в=:ш пЗ: н=
%н м1п1 м!с!н1 м1п3м1 с4 н4 м1с1 м1п1 в4 м1п1м1с1 н4
%т зна-ме-на-ны-и ве-ле-гла-сны-и

%з м_/: рТ. пК: мТ р\ с_/: =\ = Э: в=:ш
%н н1с1м2 м1с1 п2 м2 м2 г1н1с2 н4 г4 м1п1 в4
%т ве-тхо-му же и но-во-му бо-же-

%з пТ рТ рТ мЗ:Ф=Э _ сб_/: мК: лЧ
%н п1 п1 п1 м4п2п1м1с1м1п2м2м1с1н1с1м2 с2н2с2м2п4м4 г1н1с2 м2 н1с1
%т стве-ный хо-да-тай, _я-вё по-

%з б/: =\ = Э: вК: пТ. Э: п\ м=
%н н1г1 н4 г4 м1п1 в2 п1м1 с1м1 п2 м4
%т зна-ва-емъ. _е-го-же ро-же-ство

%з рТ. п=.ч нКч ФЗ=: сб_/: рК: тДЭ сТ м\?
%н м1с1 м1п1м1с1 н2г2 н2с2м4п1м1с2м2п4м1с1м4с4н2н1г1н1с1м2с4 г1н1с2 с2 н1г1ц2 с2 м1с1
%т лю-бо-вi-ю пра-здну-емъ ве-се-

%л.274о

%з мб_/: =\ +
%н н1с1м2 с4 н4=\
%т ля-ще-ся.

