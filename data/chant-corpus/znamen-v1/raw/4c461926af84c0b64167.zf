%т и= *о='-блакъ _я='-к[о] сё'нь про-тя-за'-ше-ся[,] те-б[е|ё`] пре-*о-бра-зя'-щу-ся[,]

%з вб,,:/ пК: мТ. р_/ стДЭ мТ. пт_./+ рТ. Э: п\ м_/ рТ пК: пт_./ м_/ мТ. Э: вК:ч мТ рТ. пК:
%н м1п1в2 п2 м1с1 м4 с1н1г2  м1с1 м2п2 п1м1 с1м1 п2 м4 м2 п2 с2п2 м4 м1с1 м1п1 в2п2 м2 м1с1 п2
%т [_отъ|w\т] _ _о=т-ца` же сви-дё'-тель-ству-е-му: ту` бё` пе'-тръ со *и=-[я|а]'-к[о]-вомъ и=

%з мТ р\ сб_/: =\ = сА нТ. Э: м_/ сТ рТ рТ рТ. пб_:/ стКч
%н м2 м2 г1н1с2 н4 г4 с2 н1г1 н1с1 м4 с2 с2 с2 с1н1 с1м1п2 с2н2
%т [и]=-[о]-а'н--номъ, _я='-к[о] хо-тя'-ху бы'-ти с\ъ+то-бо'-ю[,]

%з Э: пК: м\ ср=\ Э: с_/о рК. рТ. #гТ ц\ #= мТ. пЗ: тЭ!- м=: рТ рТ. пЗ: тЭ!- м=:шз
%н с1м1 п2 м2 с2с1н1 г1н1 с3н1 с2 с1н1 г2 ц2 *н4 м1с1 м1п1м1с1 н2с2 м4 м2 м1с1 м1п1м1с1 н2с2 м3п1
%т и= во вре'-мя пре-да'-н[и]-я тво-е-г[о]`[,] да ви'-дёв-ше чу-де-са` тво-я^[,]

%з мТ рТ пК: пт_./ м_/ Э: мК: рК: лЧ б/: нЭ бТ: п=: пб_:/ рТ. п/: бД пб=ч сЭ м\ с=
%н м2 м2 п2 с2п2 м4  н1с1 м2 м2 н1с1 н1г1 н2 с1м1 п4 с1м1п2 п1с1 м1п1 м1с1  м1п2м1 с2 м2 с4
%т не о_у=-стра-ша'т-ся стра-да'-н[и]-и тво-и'хъ, _ _ и='м-же по-кло-ни'-ти-ся на'мъ[,]

%з мб,,/: сТ. Э: пК: м\ с= Э: пК: мТ сТ. р_/ нтДЭ сТ рТ м\ мб_/: =\ =+
