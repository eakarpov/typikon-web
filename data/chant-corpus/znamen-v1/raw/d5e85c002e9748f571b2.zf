%т _я='-ко-же и= _ф[о]-му` во-пи'-ти те-бё`[:]

%з Э: в=\ вб_/:о п=. Э: в:/ч рпу=чк
%н м1п1 в2в1п1 м1п1в1м1 п4 м1п1 в1п1 п!м!с1м1с1
%т го-спо'-дь мо'[й] и= бо'гъ мо'[й][,]

%з пЗ: нТ р\ #г+
%н м1п1м1с1 н2 н2 г4\
%т сла'-ва те-бё`.

