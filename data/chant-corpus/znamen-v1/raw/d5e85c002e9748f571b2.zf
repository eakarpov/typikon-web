%т и= w\т а=-п[о]'-столъ [_о]=-ся-

%з мб=ч н,,/ #г= вА рТ рТ *плК: вТ рТ. Э:
%н г1м2с1 н4 г4 в2 в2 в2 в1*п1 в2 в1п1 м1п1
%т за'--ем[ъ|ь][,] и= _о=-тме-та'-ю-щи-хся

%з в\ вЗ: вт_./о ру=ч п/: м\ н,,/ #г=
%н в2 п1в1п2 п2в1п1 п!м!с1м1с1 м1п1 м1с1 н4 г4
%т те-б[ё`|е`] мно'-го-и=-спы-ту'-ем[ъ|ь][,]

%з нЭ+ пб_/: мТ рТ. Э: пК: мТ с\ н=
%н н2 с1м1п2 м2 м1н1 с1м1 п2 м2 с2 н4
%т ка'--к[о] во-пло-ти'-лся _е=-си`[;]

%з Э: пК: мЧ Э: в=: рТ рТ. Э: *п\
%н с1м1м п2 м1с1 м1п1 в4 в2 в1п1 в1*м1 *п2
