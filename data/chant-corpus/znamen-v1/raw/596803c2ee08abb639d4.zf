%т м[0]-[и|v"]-се'-[_я|а][,] хр[и]-ст0'-с(0)[,] во спа-

%з п/: Ч Э (Т.)мК: (Э:)Т (\)\ (=ч)сб_/: (=\)=\ (+)+
