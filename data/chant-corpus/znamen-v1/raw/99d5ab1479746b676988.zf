%Набор Е.Нечипоренко
%Расшифровка Е.Нечипоренко

%код 624_c1
%текст {Н}а[| ]ст[и]\х. {С}тр\хы. {Г}ла\с 2. {П}о\д.
 {Д}оме _е=фра'_фо\в.

%з мА рТ. пЗ: нЭ+ Э: п=:
%н м2 м1с1 м1п1м1с1 н2 с1м1 п4
%т {О}_у-_я-сни свой _я-зыкъ

%з р_/ вК: рТ. мТ с\ н= мТ. пЗ: Э:
%н п4 в2 в1п1 м2 с2 н4 м1с1 м1п1м1с1 н1с1
%т свё-тло за-ха-рi-е, про-рокъ _о-

%з м\ с=ч п_:/ нЭ мК: (=.ч)сЩ м_:/ с=Э _/ н=Э
%н м2 с2н2 с1м1п2 н2 м2 н1с1н1г1 н1с1м2 с2н2г1 г1н1с1 н4
%т тро-ча бо-жi-и б[о_|]у-детъ во-зо-пивъ,

%з нЭ мт_./+ сК.ч пт_/: мТ. пЗ: нЭ+ Э:
%н н2 н2м2 с2н2 с2м2п4 м1с1 м1п1м1с1 н2 с1м1
%т и сло--ву бо-жест-ве-но-

%л.264

%з п=: мТ. Э: в=: п=. м+
%н п4 м1с1 м1п1 в4 п4 м4\
%т му пре-до-те--ча.

