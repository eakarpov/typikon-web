%т но бо'-гомъ со-тво-ре'нъ бы'сть[.] дре-вле о_у=-б[о] м[о]-[и|v"]-се'-[й]

%з Э: *мК: лЧ /: =\ = сТ. Э: пК: мТ. нЭ мТ. вб,,:/ пКч п=
