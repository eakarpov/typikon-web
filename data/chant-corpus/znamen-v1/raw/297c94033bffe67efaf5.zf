%код prl3

%з пт_:/ сТ м:/ч нЭ с\ Х сК: нЩк Э:л р:/ч =чк ,,/ =
%н с2м1п1 с2 м1с1 н2 с2н1 с1н2 с2 н1г1н2 г1с1 с1н1 н!г!ц1г1ц1 *н4 *г4
%т {С}ла'-ва в\ъ+вы'-шнихъ бо'-гу[,] в\ъ+ви-[ф|_ф]л[и|е]'-е-мё слы'--шу

%з сТ. Э: вК: пТ. п\ с= мЗ: сб_:/ лЧ б/: =\ =
%н с1н1 м1п1 в2 п1м1 п2 с4 с1м1с1н1 г1н1с2 г1с1 н2 г4 н4
%т w\т бе-зпло'--тныхъ дне'сь[,] и='-же на зе-мли` ми'ръ

%з гТ рТ. Э: нК: гТ. Э: мт_./о ст_./+ н= гТ. Э: с_/ рТ. Э: п\
%н г2 г1*н1 ц1г1 н2 г1ц1 г1н1 с2м1с1 н2с2 н4 г1ц1 г1н1 с4 с1н1 с1м1 п2
%т бла-го-во-ли'-вше-му ти` бы'-ти[,] ны'-нё дё'-ва-я не-

%з м=ч н=\ *н= сТ. Э: пК: л\ с= рК: лЧ б/: =\ =
%н с1м1с1н1 г1н1г1ц1 *н4 с1н1 с1м1 п2 н1м1 с4 с2 г1с1 н2 г4 н4
%т бе'съ ши'-рши[.] во-[|з]с[и]-я' бо свё'тъ w--мра-ч[е|_е]'-ннымъ[,]

%з сТ. Э: вК: п/ч сТ. Э: п:/ч с= рТ рТ лК: сТ м:/ч нЭ с_/ Х
%н с1н1 м1п1 в2 п1м1 с1н1 с1м1 п1м1 с4 с2 с2 с1п1 с2 м1с1 н2 с2н1 с1н2
%т и= сми-р[е|_е]'-нны-я во-зне-се` и=`-же а='-нге-льски по-ю'-ща[:]

%з сА нТ. Э: р:/ч =чк #*н,,/ #*г+
%н с2 н1ц1 г1с1 с1н1 н!г!ц1г1ц1 *н4 *г4\
%т сла'-ва в\ъ+вы'-шнихъ бо'--гу.

%Разница дё'ва[я|]
   [вознесе` и=`же|возвы'си]
   пою'щ[а|ыя]:

