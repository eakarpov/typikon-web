%код prg2

%з н=Э тЭ!- п=:
%н н4 с2м2 п4
%т {Г}о-спо-до_у

%з вК: пК: вб,,:/ рТ. мТ с\ н= пТ. Э:
%н в2 п2 м1п1в2 в1п1 м2 с2 н4 п1м1 п1в1
%т и-су--су рождь-шу-ся w\т свя-

%з *м:/ч пЭ в:/ч м=\ пЗ: нЭ+ Э: пК: мТ рТ.
%н *м1в1 п2 в1п1 м2м1с1 м1п1м1с1 н2 с1м1 п2 м2 м1с1
%т ты-я дё--вы про-свё-ти-ша-ся

%з пЗ: Э: м\ с=ч сК. нТ рТ. Э: м\
%н м1п1м1с1 н1с1 м2 с2н2 с2 н2 н1г1 н1с1 м2
%т вся-че-ска-я па-сты-ремъ бо сви-

%з ст=Э б_/ т=Э мТ рТ. пЗ: нТ. Э:
%н с2н2г1 г1н1с1 н4 м2 м1с1 м1п1м1с1 н1г1 н1с1
%т ря-ю-щимъ и во-лхвомъ по-кла-

%л.90о

%з мК: лЧ б/: =\ = пб_:/ мТ рТ рТ рТ. пЗ:
%н м2 н1с1 н1г1 н4 г4 с1м1п2 м2 м2 м2 м1с1 м1п1м1с1
%т ня--ю-щи-мся а-нге-ломъ во-спё-ва-

%з мт_./ с=ч (=.ч)нсЩ Э: м\ ст=Э б_/ т=Э м_/
%н н2м2 с2н2 н1с1н1г1 н1с1 м2 с2н2г1 г1н1с1 н4 м4
%т ю-щимъ и-родъ мя-тя-ше-ся _я-

%з сТ {=~Ф~_/:} н= стКч тЭ!- п=: вб,,:/ пТ. п/: м\?
%н с2 = н4 с2н2 с2м2 п4 м1п1в2 п1с1 м1п1 м1с1
%т ко _ бо---__гъ во пло-ти _я-

%з (ЭТ:)_/: п=: р=: мТ. вб,,:/ п=. м+
%н н2с1м1 п4 п4 м1с1 м1п1в2 п4 м4\
%т ви-ся спасъ ду-шамъ на-шимъ.

