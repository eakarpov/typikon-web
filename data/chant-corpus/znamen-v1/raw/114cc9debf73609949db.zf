%код prs1
%текст }Н{а ст[и]хо'внё стр\хы. Гла'съ, 2.
%л.96о

%з сб_/: нТ. н=. рЭ Э: пК: мТ рТ. мт_./ рт=.\
%н г1н1с2 н1г1 н4 н2 с1м1 п2 м2 м1с1 н2м2 м2с4н2н1г1н1с4н4
%т {В}е'-л[и]-е и= пре-сла'-вно-е чю'-до

%з Э: м\ ст=Э б_/ т=Э нб_/: рТ лТ: бТ н_/ Э: н\:
%н н1с1 м2 с2н2г1 г1н1с1 н4 ц1г1н2 н2 г1с1 н1 г1н1.г! ц1г1 н4
%т со-ве-рши'-ся дне'сь[:] дё'-ва-я ра-жда'--етъ

%з нЭ+ Э: в/: пТ рТ. Э: п\ м=ч =\ =        пК: мТ рТ рТ. пЗ: мт_./ с=ч
%н н2 с1м1 п1в1 п2 п1м1 с1м1 п2 м2с2 н4 г4 п2 м2 м2 м1с1 м1п1м1с1 н2м2 с2н2
%т и= о_у=-тро'-ба не и-стлё-ва'--етъ[.]  сло'-во во-пло-ща'-е-тся

%з (Т)сТ. (Т.)Э: (Э:)мК: (К:)сЩ(=.ч) (Щ)нТ. Э: м\ т=Э б_/ т=Э пт_:/ сЗ: Х
%н с1г1 н1с1 м2 с1н1с2 н1г1 н1с1 м2 с2н2г1 г1н1с1 н4 с2м1п1 н1с1н1.г!ц1 г1н2
%т и= w\т _о\т-ца` не w\т-лу-ча'-е-тся[.]  а='-нге-ли

%з п:/ч Э: п\ м=ч =\ = Э: пК: п/: мЧ Э: м\ с=ч
%н п1м1 с1м1 п2 м2с2 н4 г4 с1м1 п2 м1п1 м1с1 н1с1 м2 с2н2
%т с\ъ+па'-сты-ри сла'--вятъ[,] и= мы` с\ъ+ни'-ми во-пи-е'мъ[:]

%з м=\ пЗ: н= ст_./+ рТ. пб_:/ стК.ч Э: мК: Ч т/:- =\ +
%н м2м1с1 м1п1м1с1 н4 н2с2 с1н1 с1м1п2 с2н2 н1с1 м2 н1г1 н3г1 г1н1с1 н4\
%т сла'--ва в\ъ+вы'-шнихъ бо'-гу[,] и= на зе-мли` _ ми'ръ.

%Примечание Примечание: Последняя строка правлена по рукописи
F.III.23. Здесь было:

%з _ с= нЭ сК. рТ.
%т +++++++++++ ва в\ъ+вы'--шнихъ

%Разница Ве'лiе и= пресла'вное чу'до соверши'ся
дне'сь: [дв~ая|дв~а] ражда'етъ и= о_у=тро'ба не и=стлjьва'етъ:
сло'во воплоща'ется и= [w\т|] _о=ц~а` не w\тлуча'ется. а='гг~ли
съ па'стыр[|ь]ми сла'вятъ, и= мы` съ ни'ми вопiе'мъ: сла'ва
въ вы'шнихъ бг~у, и= на земли` ми'ръ.

