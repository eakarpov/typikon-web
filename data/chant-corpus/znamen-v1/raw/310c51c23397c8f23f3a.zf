%код vlt1
%л.17
%текст }П{овы'ходё пое'мъ.

%з Э: мт_./о нЭ с\ Х` сТ.
%н г1н1 с2м1с1 н2 с2н1 с1н2 с1г1
%т {С}вя-ты-я сла-вы без-

%з мЗ: сб_/:о с_/` нТ. лЭ: с:/ч
%н н1м1с1н1 г1н1с1н1 с4 н1г1 н1с1 с1н1
%т сме-ртна-го wт-ца не-

%з ну=ч *н,,/ *г=` Э: ср=\ Э: п\
%н н!г!ц1г1ц1 *н4 *г4 г1н1 с3н1 с1м1 п2
%т бе-сна-го свя-та-го бла-

%з м=ч =\ =` сТ. мЗ: гЭ н\ с=.`
%н с1м1с1н1 г1н1г1ц1 *н4 с1г1 н1м1с1н1 г2 н2 с4
%т же-нна-го и-су-са хри-ста

%л.18

%з бТ: вК: пТ. пК: м\ с=` рТ.
%н м1п1 в2 п1м1 п2 м2 с4 с1г1
%т _ сы-на бо-жi-я при-

%з мЗ: сб_/:о с_/` мК: сТ н\? мб_/:
%н н1м1с1н1 г1н1с1н1 с4 м2 с2 н1г1 н1с1м2
%т ше-дша-го на за-падъ со-

%з =\ =` п=: мТ. нЭ бТ: п/:
%н с4 н4 п4 м1с1 н2 с1м1 м1п1
%т -лнцу ви-дё-вше _ свётъ

%з мДк пб=ч с=\ н=` сТ плК: сТ
%н м1с1 м1п4м1 с4 н4 с2 с1п1 с2
%т ве-че-рнi-и по-емъ wт-

%з м:/ч нЭ с\ Х` гТ. Э: с_/
%н м1с1 н2 с2н1 с1н2 г1ц1 г1н1 с4
%т ца и сы-на и свя-та-

%з рТ. Э: п\ м=ч =\ =` Э:
%н с1н1 с1м1 п2 с1м1с1н1 г1н1г1ц1 *н4 г1н1
%т го ду-ха бо--га до-

%з сК. лЧ б/: =\ =` Э: вК:
%н с2 г1с1 н2 г4 н4 м1п1 в2
%т сто-инъ _е-си _ во вся

%з пТ. п\ с=` мК: сТ н\? мб_/:
%н п1м1 п2 с4 м2 с2 н1г1 н1с1м2
%т вре-ме-на пётъ бы-ти гла-

%з ср=\ Э: п\ м=ч =\ =` нЭ
%н с3н1 с1м1 п2 с1м1с1н1 г1н1г1ц1 *н4 н2
%т сы пре-по-до-бны-ми сы-

%з пб_:/ рТ. лТ: с=\ н=` Э: мт_./о
%н с1м1п2 п1м1 с1м1н1 с4 н4 г1н1 с2м1с1
%т -не бо-жi-и жи-вотъ

%з нЭ с\ Х` сК. сЗ: =\ =`
%н н2 с2н1 с1н2 с2 г1с1н2 г4 н4
%т да-я-и все-му ми-ру

%л.19

%з Э: вК: пТ. пК:ч с=` мК:ч н\?
%н м1п1 в2 п1м1 п2м2 с4 м2с2 н1г1
%т _е-го-же ра-ди весь миръ

%з мб_/: с=\ н+
%н н1с1м2 с4 н8\
%т сла-витъ тя.

