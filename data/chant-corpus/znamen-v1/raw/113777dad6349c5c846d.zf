%Название Гласъ 1 I=рмосы`
%Архив ГПНТБ СО РАН, F.I.5

%песнь 1
%код i81k
%Расшифровка С.Хохряков

%текст Во\з кр\ста`

%з нЭ+ Э: п/ч вК: пТ рТ. Э: *мК:
%н н2 с1м1 п1м1 в2 п2 п1м1 п1в1 *м2
%т Кре-ста` на-че-рта'-в(о) мо-и-

%з *м=.ч` Э: вК: рТ. Э: п_/ рТ. Э:
%н в1*м1в1п1 м1п1 в2 в1п1 с1м1 п4 п1м1 с1м1
%т се'й в(о)-пря'-м[о] же-зло'-м(е) чер-

%з п_/ рТ! рТ! мтКч Э!- в=.` пА мТ. вб_:/ пК:
%н п4 п1 п1 м2с2 м2п2 в4 п2 м1с1 м1п1в2 п2
%т м(е)-но'-_е пре-сё-че` и=з-ра'-и-лю _

%з мТ. м_/ с=. рЗ:` нЭ+ Э: п/ч
%н м1с1 м4 с4 н1с1н2 н2 с1м1 п1м1
%т про-хо-дя'-щу то'й-же w=-

%з Э: *мК: *м=.ч` вК:! рТ! п_/ м=. п_/ рТ!
%н п1в1 *м2 в1*м1в1п1 в1 в1 п4 м4 п4 п1
%т бра-ще'-на фа-ра-_w'-на с(о) ко-

%з рТ! ртКч Э!- в=:` пТ. вб_:/ пК: мТ.
%н п1 п2с2 м2п2 в4 п1с1 м1п1в2 п2 м1с1
%т ле-сни'-ца-ми о_у=-да'-ри со-

%з м_/ с=. рЗ:` Э: *мК: вК. пТ. Э: в_/
%н м4 с4 н1с1н2 п1в1 *м2 в2 п1с1 м1п1 в4п1
%т во-ку-пи` во-пре-ки` на-пи-са'-

%з ЭЭЧ` Э: пК: мК. сТ. п/: мТ. нЭ
%н в1п2 с1м1 п2 м2 с1н1 м1п1 м1с1 н2
%т в[(w)|ъ] не-по-бё-ди'-мw _о=-ро_у'-

%л.144

%з Э: п=:` вК: рТ. мЭ Э!- *мК:ш!у Дд
%н с1м1 п4 в2 в1п1 м2 п2в2 *м1 в1п2 
%т жi-_е тё'-м(е) хри-ста` _ _

%з в=:` мЭ пТ. Э: в=: рК: пТ вК: пТ мТ.
%н в4 м2 п1с1 м1п1 в4 в2 п2 в2 п2 м1с1
%т _ во-спо-и'-м(о) бо'-га на'-ше-го

%з вб_:/ пК: мТ. м_/ стДЭ н+
%н м1п1в2 п2 м1с1 м4 с1н1г2 н4\
%т _я='-кw про-сла'-ви-ся.

