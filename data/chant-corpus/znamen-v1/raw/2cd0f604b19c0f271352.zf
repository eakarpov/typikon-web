%Источник Поморский обиход XIX в.

%код x_n72

%з нА с= бТ: птКч пК: мТ \? мб_/: с=\
%н н2 с2 с1м1 п2м2 п2 м2 с1г1 н1с1м2 с2с1н1
%т {И}-же _ всё-м(о) ца-р(е)-ству-я-

%з мтКч нЭ+ Э: п=: рТ рТ рТ рТ. Э: пК:
%н м2с2 н2 с1м1 п4 п2 п2 п2 п1м1 с1м1 п2
%т и и со-зда-нi-емъ бы-в(о) че-ло-

%з л\ с= рТ рТ рТ рТ мТ птКч ФЗ
%н н1м1 с4 с2 с2 с2 с2 м2 п2м2 п1м1с2
%т вё-к(о) в(о)-се-ли-ся во тво-ю

%з Э: вК: пТ. сЭ рТ. Э: п=:о сЭ м\
%н м1п1 в2 п1м1 с2 с1н1 с1м1 п3м1 с2 м2
%т бо-го-ра-до-ван-ну-ю о_у-тро-

%з п=: Э: вК: пТ. сЭ рТ рТ рТ. мК:
%н п4 м1п1 в2 п1м1 с2 с2 с2 с1н1 м2
%т бу и ра-спя-тi-е пре-те-рпё-

%л.227

%з сТ \? мб_/: =\ = гЭ с_/ рТ
%н с2 н1г1 н1с1м2 с4 н4 г2 с4 с2
%т в(о) и с(о)-ме-рт(е) и во-скре-

%з рТ рТ рТ рТ рТ. пУ сТ. Э:
%н с2 с2 с2 с2 с1н1 с1м1п2м4 с1н1 м1п1
%т се бо-го-лё-п(е)-но со-воз\ъ-

%з вб**/ сТ рТ рТ рТ рТ. мК: сТ \?
%н в!п!м1п1м1 с2 с2 с2 с2 с1н1 м2 с2 н1г1
%т ста-ви-в(о) на-с(о) _я-ко в(е)-се-

%з мб_/: =\ +
%н н1с1м2 с4 н4\
%т си-ле-н(о).

