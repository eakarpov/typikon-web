%код w10x3

%з сА рТ. мК: сТ н\? мб_/: с=`
%н с2 с1н1 м2 с2 н1г1 н1с1м2 с4
%т {И}-же а-да плё-ни-въ

%з сК. рК. нТ. лЭ: с:/ч ну=ч *н,,/ *г=`
%н с2 с2 н1г1 н1с1 с1н1 н!г!ц1г1ц1 *н4 *г8
%т и че-ло-вё-ка во-скре-сивъ

%л.32

%з сТ рТ плК: сТ рТ рТ мтДЭ
%н с2 с2 с1п1 с2 с2 с2 м1с1н2
%т во-скре-се-нi-емъ тво-имъ

%з с\ н=` сТ плК: сТ рТ м:/ч
%н с2 н4 с2 с1п1 с2 с2 м1с1
%т хри-сте спо-до-би насъ чи-

%з нЭ с\ Х` сК. рК. нТ.
%н н2 с2н1 с1н2 с2 с2 н1г1
