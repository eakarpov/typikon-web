%код w20g5

%з Э: вК: рК: рТ рТ
%н м1п1 в2 в2 в2 в2
%т {К}ре-стомъ тво-имъ о_у-

%з пТ. вт_./о п/: мТ. нЭ` мК: рТ.
%н п1м1 п2в1п1 м1п1 м1с1 н2 м2 м1с1
%т пра-здни-лъ _е-си ю-же

%з мК: сК. нЭ с=. нЭ бТ: п=:`
%н м2 с2 н2 с4 н2 с1м1 п4
%т wт дре-ва кля---тву

%з рТ. Э: *мК:. вК: пЭ вК: п_/
%н п1м1 п1в1 *м2 в2 п2 в2 п4
%т по-гре-бе-нi-емъ сво-имъ

%л.52

%з вК: рТ. мТ с\ н=` пЗ: мб,,/:
%н в2 в1п1 м2 с2 н4 м1п1м1с1 н1с1м2
%т о_у-ме-ртвилъ _е-си сме--

%з лЧ б/: =\ =` нЭ пб_:/ мТ
%н н1с1 н1г1 н4 г4 н2 с1м1п2 м2
%т рти де-ржа-ву во-ста-нi-

%з рТ. Э: м\ ст=ч` мТ рТ. п/:
%н м1с1 н1с1 м2 с2н2 м2 м1с1 м1п1
%т емъ же сво-имъ про-свё-тилъ

%з мТ. нТ. сК. нТ. Э: мК: (Т.)Ч
%н м1с1 н2 с2 н1г1 н1с1 м2 н1г1
%т _е-си родъ че-ло-вё--

%з т/:- =\ =` Э: вК: п_/ Э:
%н н2г1 г1н1с1 н4 м1п1 в2 п4 м1п1
%т че-скi-и се-го ра-ди

%з вК: рТ. мК.ч н=` мТ рТ. п/:
%н в2 в1п1 м2с2 н4 м2 м1с1 м1п1
%т во-пi-емъ ти бла-го-да-

%з мТ. нЭ бТ: п=:` рК: рК: мТ.
%н м1с1 н2 с1м1 п4 п2 п2 м1с1
%т те-лю хри-сте бо-же нашъ

%з вб,,:/ рК: п\ м+
%н м1п1в2 в2 п2 м8\
%т сла-ва те-бё.

