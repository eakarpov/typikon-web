%код prh3s
%текст С}ла\в {Г}ла\с . {3} .

%з Э: пК: мТ сТ
%т {I}-w-си-фе
%н с1м1 п2 м2 с2

%з мб_/: с=~бТ: п=: мТ сТ рТ
%т рцы намъ ка-кw ю-же
%н н1с1м2 с2с1м1 п4 м2 с2 с2

%з рТ рТ рТ рТ рТ
%т w\т свя-тых\ъ прi-ялъ
%н с2 с2 с2 с2 с2

%з рТ. Э: пК:ч с= гЭ сК. рТ.
%т _е-си дё-ву не-праз-дну
%н с1н1 с1м1 п2м2 с4 г2 с2 с1н1

%з Э: пК: мТ с\ Э: м\
%т при-во-ди-ши в\ъви-_фле-
%н с1м1 п2 м2 с2 н1с1 м2 

%з с= в=: р=.ч п= Э: вК:
%т емъ; азъ ре-че про-ро-
%н с4 в4 п1в1п1м1 п4 м1п1 в2

%з пТ. пК: м\ с= мЭ пК.
%т ки ис-пы-тахъ и вёсть
%н п1м1 п2 м2 с4 м2 п2

%з рТ мЭ пТ вК: рТ рТ мЭ
%т прi-емъ w\т ан-ге-ла о_у-
%н п2 м2 п2 в2 в2 в2 м2

%з п_/ рКч с= вТ. Э: *пК:чш вТ
%т вё-ри-хся _я-кw бо-га
%н п4 п2м2 с4 в1п1 в1*м1 *п2*м2 в2

%з рТ рТ. Э: *пК:чш втДЭ Э:
%т ро-дитъ ма-рi-я не-
%н в2 в1п1 в1*м1 *п2*м2 в1п1м2 п1в1

%з *м\ в=чк =\ = нЭ пК:
%т ска-за--ннw. _е-му-
%н *м2 в1п1в2 п2м2 п4 н2 п2

%з рТ рТ рТ рТ вб,,:/ пКч п=
%т же на по-кло-не-нi-е
%н п2 п2 п2 п2 м1п1в2 п2м2 п4

%з Э: пК. рТ Э: в=.\ рК:
%т вол-сви w\т во-сто-кwв\ъ
%н с1м1 п2 п2 м1п1 в2в1п1 в2

%з пТ. пК.ч с=~бТ: п_/ мЭ
%т прi-и-дутъ с\ъда-ры
%н п1м1 п2м2 с2с1м1 п4 м2

%з Э: пК: мТ с\ мб_/: с=
%т чест-ны-ми слу-жа-ще.
%н с1м1 п2 м2 с2 н1с1м2 с4

%з нЭ Э: пК: рТ рТ рТ
%т во-пло-ти-вый-ся насъ
%н н2 с1м1 п2 п2 п2 п2 

%з вб,,:/ пКч втТ: рК: мЭ п_/ рТ
%т ра-ди го-спо-ди сла-ва
%н м1п1в2 п2м2 п2в2 в2 м2 п4 п2

%з м\ с+
%т те-бё.
%н м2 с4\

