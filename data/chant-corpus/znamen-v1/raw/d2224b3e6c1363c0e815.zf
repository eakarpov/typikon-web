%текст Т}ро\п~. {Г}ла\с. 8.

%з в=:ш п_/о стКч п=: м_/о сЭ!- (/ч~_:/-)_:/ч
%н в4 п2п1м1 с2н2 п4 м2м1с1 н2с2 н1ц1г1н1с4
%т {С[\+]}вы'-%(и-%) шнихъ сни'-де ми'- ло-

%з (Т.~=.)=\ (Т~/:=)=:` рТ. м/: (/чТ:)=ч пК: \ (,+:/~Т~_./+)=:` вК:
%н н1г1н4 г2н1с1н4 н1г1 н1м1 с1н1с1м1 п2 м1с1 м1.п!в1п1м1в3п1 в2
%т сти- ве[,] и= по- гре- бе'-н[и]-е пр[и]-

%з З: Х` мК: лЧ /: =\ =` Э: п_/о
%н м1п1м1.с!н1 г1н2 м2 н1с1 н1г1 н4 г4 с1м1 п2п1с1
%т [_я]'-т(о) три-д[|(е)]-не'-в(е)-но[,] да на'съ

%з м=\ (Т.~сК:)Щ (тДЭ~/ч~/:~п,,:/ш)ДЗЗТ: мК: Т. сб_./+ =\
%н м2м1с1 н1г1с2 с1н1г2н1г1н1с1н1с1м1п1 м2 с1н1 г1с4 н1г1н4 
%т сво-бо- ди'- ши [0]-т(о) стра-

%л.272о

%з =` А мб_:/ ФЗ=:` _ пК: м/: =чк
%н г2н1с1н4 г2 н1с1м2 с2с1н1с1м1п2м!с1м1п2п1в1п2м2 м2с!н1г1н1с1м2с!н1с4с2н2г2н1с1н4 п2 н1м1 с1н1с1м1 
%т сте'[й][,] жи-во- т[{а}|е]` _ и= во- скре-

%з пК: \ =:` п_/ Э: \ =ч =\ +
%н п2 м1с1 м1.п!в1п1м1в3п1 м1п3м1 с1м1 п1с1 м2с!н1м1 г1н3с1 н1г1н4\
%т се'-н[и]-е на'-ше[,] сла'-ва те-бё`.

%Разница

Съ [вы'шнихъ|высоты`] [сни'де|снизше'лъ _е=си`]
[ми'лостиве|бл~гоутро'бне], [и=|] погребе'нiе
прiя'[тъ|лъ _е=си`] тридне'вно[|е], да на'съ
свободи'ши [w\т|] страсте'й, животе` и= воскр\снiе
на'ше, [|гд\си] сла'ва тебjь`.

%Примечание [ОШ+|]

