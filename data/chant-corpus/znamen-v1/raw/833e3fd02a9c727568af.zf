%код i238

%з пА Э: вК: пТ. Э: вК: рТ. мК:
%н п2 м1п1 в2 п1с1 м1п1 в2 в1п1 м2
%т Раз-ши-ри на вра-ги о_у-ста

%з с\ н= Э: вр=.\ мК: с\ н= пТ.
%н с2 н4 м1п1 в2в1п1 м2 с2 н4 п1м1
%т мо-я хри-сте спа-се мой и

%з Э: *мК% вК: пТ рТ. Э: вК: рТ. мК:
%н п1в1 *м2 в2 п2 п1с1 м1п1 в2 в1п1 м2
%т на ка-ме-ни вё-ры о_у-тве-рди

%з с\ н= сб_/: рТ рТ рТ. пЗ: нЭ
%н с2 н4 г1н1с2 с2 с2 с1н1 м1п1м1с1 н2
%т ме-не па-че бо и нёсть свя-

%з бТ: п=: вб,,:/ рК: п\ м+
%н с1м1 п4 м1п1в2 в2 п2 м4\
%т - та _я-ко-же ты.

