%Набор Е. Нечипоренко
%Расшифровка Е. Нечипоренко
%л.254

%з Э: пК: р:/ч пК: тДЭ бТ:
%н с1м1 п2 п1м1 п2 м1с1н2 с1м1
%т {Д}w-сто-ино _е--сть

%з пК: рТ. пК: мТ. нЭ лЭ: р:/ч =ч
%н п2 п1м1 п2 м1с1 н2 м1в1 в1п1 м2
%т ве-ли-ча-ти тя бо-го-ро-

%з \ Х нЭ+ п_:/ Э: вК:
%н с2н1 г1н2 н2 с1м1п2 м1п1 в2
%т ди-це че-стнё-ишу-ю

%з рК: р:/ч в_./+- пК: рЩ пК:
%н в2 в1п1 м2в4 п2 п1м1п2 п2
%т хе-р[о_|]у-вимъ и сла-внё[|й]-

%з мТ. нЭ К: Т. Э: *п/: *мТ. пнЭ
%н м1с1 н2 п2 п1м1 п1в1 *м1*п1 *м1в1 п2
%т шу-ю без[|\ъ] ра-су-жде-ни-я

%з Э: *м/: пЩ~Х
%н м1п1 в1*м1 п1м1п1=п4\
%т се-ра-фимъ.

%текст {_Пс}ало'мъ {И=}з\ъбра'нный {Б}ж~е со_у'дъ тво'и

