%код eb3s
%текст }Т{а\ж посе'мъ т\про по чi'ну та\ж тр\стое. а~ . ли\к а=ми\н.}

%Источник Рукопись XVII в. 
%Расшифровка иеродиакон Афанасия (Савельева).
%Архив РНБ Сол. 277/282.
%л.297 об.

%з мЭ+ в/: рК: п=. мЭ+ в/: р\ п=.
%н м2 п1в1 в2 п4 м2 п1в1 в2 п4
%т {С}вя-тый бо-же свя-тый крёп-кiй

%з мЭ+ вб/: рК: рК: рК: пТ в!/: рК: п=.
%н м2 п1в1 в2 в2 в2 п2 п2в2 в2 п4\
%т свя-тый без\ъ-смерт-ный по-ми-луй насъ.

%текст {П}рево'дне.

%з п_/ мбЭ п_/шз в=. п= рЩк мбЭ п_/шз в=. п=
%н п4 м1 п3в1 в4 п4 п1м1п2 м1 п3в1 в4 п4
%т {С}вя-тый _ бо-же свя-тый _ крёп-кiй

%з рЩк мЭ пб_/шз вК: п=. вК: пК. пб_./+шз вК: пТ. р=. р=\ вб_./+ п= вб,+:/ п=. м+
%н п1м1п2 м1 п3в1 в2 п4 в2 п2 м1п3в1 в2 п1м1 п4 п3м1 п1в2 п4 м2п!в2 п4 м4\
%т свя-тый _ без-смер\ът-ный по-ми-лу-й на------___съ.

%текст }_О='{{ба ли'ка три\ж. Сла'ва i= нн~ё.}

%з пЩк мбЭ п_/шз вК: п=. вК: пК. мбЭ п_/шз вК: пТ. р=.
%н п1м1п2 м1 п3в1 в2 п4 в2 п2 м1 п3в1 в2 п1м1 п4\
%т {С}вя-тый _ без\ъ-смерт-ный по-ми--лу-й насъ.

%текст {Л}и'къ. {Вы'шшимъ гла'сомъ.}

%з мЭ вт_./+ р=. п= р= пб_./+шз в=. п=
%н м2 п2в2 в4 п4 п4 м1п3в1 в4 п4
%т {С}вя-тый бо-же свя-тый крёп-кiй

%з р= пб_./+шз вК: п=. вК: пК. пб_./+шз вК: пТ. р=.
%н п4 м1п3в1 в2 п4 в2 п2 м1п3в1 в2 п1м1 п4\
%т свя-тый безъ-смерт-ный по-ми-луй _ насъ.

