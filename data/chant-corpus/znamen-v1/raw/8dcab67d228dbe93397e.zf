%т _ ч[ю|у]'-встве[|н]-ны-[й] ли'--к(о)[,] ви'-дя-ще

%з пК: м\ =: мТ пК:? п_/ Э: п\ =ч =\ =бТ:
%н п2 м1с1 м1.п!в1п1м1в2п1 м2 п1с1 м1п3м1 с1м1 п2 м1.с!н1м1 г1н2с1 н1г1н2м1п1
%т ца-ри'-цу и= вла-ды'-чи-цу ве-сё'-х(о)[,]

%з в=:ш п/чс бТ: вК: рТ. мТ с\ н=бТ: пр_/ос м=\ м/: сК:-
%н в4 п1с1 м1п1 в2 в1п1 м2 с2 н2с1м1 п3с1 м2м1с1 н1м1 с2
%т м(о)-но--го-и-мя'-н(е)-н[е|нё] вё'-р(е)-ны--

%з руДЭ нТ. с/: пб,,:/ш мК: сТ. сб_./+- =\ =бТ: п=:
%н с!н!г1 н1г1 н1с1 н1с1м1п1 м2 с1н1 г1с4 н1г1н2 г2н1с1н2с1м1 п4
%т (и)-----ми сла'-ви-му[:] ра'-

%з м/чс бТ: мК: лЧ н/: р=\ г= с/: пО_/ нТ. м/: с=чк
%н м1с1 н1с1 м2 н1с1 н1г1 н4 г4 н1с1 н2с1м1п4 н1г1 н1м1 с1н1с1м1
%т --ду-ю-т(е) же ся и= ду'-си пра'-ве-

%з пК: м\? =: мТ пК: п_/ Э: п\? =ч =\
