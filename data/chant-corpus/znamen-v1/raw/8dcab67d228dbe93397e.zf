%т и= о_у=-тве-рж[|д]е'-н[и]-я[,] и= спа-се'-н[и]-я

%з п_/ Э: п\? =ч =\ +
%н м1п2м1 с1м1 п2 м1.с!н1м1 г1н2с1 н1г1н4\
%т ду-ша'-м(о) на'-ш[и|ы]-м(о).

%Разница [разу^мная|о_у=мная]
[ра'дуютжеся|ра'дуются же]
[позара'таи видё'нию|зри'телiе видё'ния]
[превы'спрь|на возду'сё]
[простира'ющи|простира'ющу]
[прося'щи|прося'щу]
[мi'рови|мi'ру]
[душамъ нашымъ|ду'шъ нашихъ]

