%Набор и нотолинейная транскрипция Елены Барсуковой
%л.001о
%текст {ТРI_W'ДЬ 
ПО'СТНАЯ 
И=+ЦВЁТНА'Я}
%л.002
%текст {НЛ~Я _W= МЫТАРИ' И=+ФАРИСЕ'И. 
}Н{А'+ГД~И ВОЗВА'ХЪ.} 
С{Т\хРЫ.} Г{ЛА'СЪ 1.}
%код s3y2

%з Э: сК: нТ. г_/ цтДЭ г_/ 
%н г1н1 с2 н1ц1 г4 ц1*н1*г2 г4 
%т {П}ро-стре блу-дни-ца вла-

%з цтДЭ Э: нК: рК: (/ч~Т:)гЩк н=. Э: сК: 
%н ц1*н1*г2 ц1г1 н2 н2 г1*н1ц1г1 н4 г1н1 с2 
%т сы те-бё су-дi-и про-стре 

%з рТ нТ. г_/ цтДЭ г_/ цтДЭ гТ рТ. Э: 
%н с2 н1ц1 г4 ц1*н1*г4 г4 ц1*н1*г4 г2 г1*н1 ц1г1 
%т же и-ю-да ро_у-цё без-за-ко-

%з нК: рК: (/ч~Т:)гЩк н=. сА нЭ сК: рТ. Э: 
%н н2 н2 г1*н1ц1г1 н4 с2 н2 с2 с1г1 н1с1 
%т не-ны--мо о-ва прi-я-то 

%з мК: Ч т/:- =\ = сб_:/ рТ рТ рТ. 
%н м2 н1г1 н2н1г1 г1н1с1 н4 г1н1с2 с2 с2 с1г1 
%т w-ста-вле-нi-_е овъ же прi-я-

%з Э: м\? с=Э б_/ =Э сТ. пб_:/ лТ: 
%н н1с1 м1н1 с2н2г1 г1н1с1 н4 с1н1 с1м1п2 г1с1 
%т ти сре-бре-ни-ки тё-ме ти 

%з нуТ! нб_/? Э: н\: сА нЭ пб_:/ мТ рТ 
%н н1 г1н1г1 ц1г1 н4 с2 н2 с1м1п2 м2 м2 
%т во-пi-_е-мо про-да-но--му 

%з рТ рТ рТ рТ рТ. п/: \? мт_./+ с=ч 
%н м2 м2 м2 м2 м1с1 м1п1 м1с1 н2м2 с2н2 
%т и сво-бо-жде-ше--му на-со 

%з мК: (=.ч)сЩ Э: м\ р=ч =\ +
%н м2 н1с1н1г1 н1с1 м2 м1с2.м1 н2г2 н4\
%т го-спо-ди сла-ва те-бё.

