%код i233

%текст _о=к\т. вн\длю напо\л.

%з мЭ пК: рТ рТ. Э: вК: рТ. мК:
%н м2 п2 п2 п1с1 м1п1 в2 в1п1 м2
%т На ка-ме-ни мя вё-ры о_у-

%з с\ н= пТ. Э: *мК% вК: пТ
%н с2 н4 п1м1 п1в1 *м2 в2 п2
%т тве-рди ра-зши-ри о_у-ста

%з рТ. Э: вК: рТ. мК: с\ н= мТ рТ.
%н п1с1 м1п1 в2 в1п1 м2 с2 н4 м2 м1н1
%т мо-я на вра-ги мо-я во-зве-

%з Э: пК: мТ рТ. тЭ!- пК:ч п_/ вК: рК:
%н с1м1 п2 м2 м1н1 с2м2 п2м2 п4 в2 в2
%т се-ли бо ся духъ мо-й во-спё-

%з п_/ м= бТ: вК:ч *мт_./+ в=: п_/ рТ рТ
%н п4 м2 м1п1 в2п2 в2*м2 в4 п4 п2 п2
%т ва-ти _ нё-сть свя-тъ _я-ко-

%з рТ. вт_./+ п_/ м=~бТ: вК: рК:ч *мт_./+ вК:
%н п1м1 п2в2 п4 м2==м1п1 в2 в2п2 в2*м2 в2 
%т же бо-гъ нашъ и нёсть пра--

%з р\ п_/ вК: рК: пТ. Э: в=: п_/ м+
%н в2 п4 в2 в2 п1с1 м1п1 в4 п4 м4\
%т ве-дна па-че те-бе го-спо-ди.

