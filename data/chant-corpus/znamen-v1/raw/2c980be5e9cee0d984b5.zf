%код dag2
%текст Недё'ля [_о|w]= мытари` и= фарисе'и,
на гд\си возва'хъ, самогла\с гла\с 1
%л.1о
%Набор Елена Нечипоренко
%Расшифровка Елена Нечипоренко

%з сА рТ. с_/:о с=. Э: пК:ч сТ. мК: сТ н\? м_/: с=\ н=
%н с2 с1н1 г1н1с1н1 с4 с1м1 п2м2 с1н1 м2 с2 н1г1 н1с1м2 с4 н4
%т Фа-ри-се'-и  тще-сла'-в[и]-емъ  по-бё-жда'--ем[ъ|ь],

%з сА рТ. с_/:о с=. рТ. Э: пК:ч сТ. мК: сТ н\? м_/: с=\ н=
%н с2 с1н1 г1н1с1н1 с4 с1н1 с1м1 п2м2 с1н1 м2 с2 н1г1 н1с1м2 с4 н4
%т и мы'-та-рь  по-ка-я'-нi-емъ пре-кло-ня'--ем[ъ|ь],

%з #гТ. Э: мт_./о нЭ с\ нт=.\ Э: нК. Э: сК. #г\? ,,/н =г
%н г1ц1 г1н1 с2м1с1 н2 с2 н4н2г2 ц1г1 н2 г1н1 с2 г1ц1 *н4 *г4
%т при-ст[о_у]-пи'-ста к[|\ъ]те'-бё _е=-ди'-но-мо_у вла-ды'-цё[:]

%з сА? мЗ: с_/:оФЗ =:
%н с1н1 с1м1с1н1 г1н1с1н1 с4м2п4м1с1м4с4н2н1г1н1с1м2с4
%т но [w|_о]='въ о_у='-б[о] _ _ _ _ _ _ _ _

%з сА рТ. с_/:о с=. нЭ+ п_:/ мтТ:? с=\ н=
%н с2 с1н1 г1н1с1н1 с4 н2 с1м1п2 с1м1н1 с4 н4
%т по-хва-ли-вся[,] ли-ши'-ся бла-ги'хъ[.]

%з с_:/чФЗ =: Э: мт_./о нЭ с\ н=.
%н г1н1с1н1 с4м2п4м1с1м4с4н2н1г1н1с1м2с4 г1н1 с2м1с1 н2 с2 н4
%т _о='въ-же ни-что'-же вё-ща'въ[,]

%з рЭ+ п_:/ рТ рТ рТ рТ. мтТ:? с=\ н= сА рТ. пт_:/ сТ рТ мтДЭ
%н н2 с1м1п2 п2 п2 п2 п1м1 с1м1н1 с4 н4 с2 с1н1 с2м1п1 с2 с2 м1с1н2
%т спо-до'-би-ся да-ро-ва'-нi-и[,] и= в\ъто-гw` во-зды-ха'-

%з с\ н=бТ: сК. #г\? ,,/н =г нА ст_./ нЩк Э:
%н с2 н2г1н1 с2 г1ц1 *н4 *г4 н2 г2с2 н1г1н2 г1н1
%т нi-ихъ о_у=-тве-рди' мя хри-сте` бо'-же[,]

%з сК. рТ нТ! гТ! сЭ:л р./ч ну=чк ,,/н +г
%н с2 с2 н1 г1 н1с1 с1н1 н!г!ц1г1ц1 *н4 *г4\
%т _я='-к[о] че-ло-вё-ко-лю'--бецъ.

%Разница [и в тогw|въ си'хъ]

