%код pak32

%текст  Припjь'въ.

%з пК:   м_/ рТ  рТ  р_/ рТ  рТ сЭ   рТ  пКч-
%н п1    м2  м1  м1  м2  м1  м1 с1   м1  п2м2
%т {В}че-ра` спо-гре-бо'-хся те-бjь` хрi-сте`,

%з пА рТ  рТ рТ р=:    сЭ м_/    сТ рТ м_/
%н п1 п1  п1 п1 п2     с1 м2     с1 с1 м2
%т со-вос-та-ю` дне'сь во-скре'с-шу те-бjь`,

%з пА  рТ  р=:  рТ рТ р=:  мТ  с=
%н п1  п1  п2   п1 п1 п3   м1  с2
%т сра-спи-на'х-ся те-бjь` вче-ра`,

%з п=:   рТ  вК:  пКч  с=
%н п2    п1  в1   п1м1 с2
%т са'мъ мя` спро-сла'-ви

%з р=   рТ мТ п=:  сЭ   мКч  р_/ с+
%н с2   с1 м1 п3   с1   м1с1 м2  с4\
%т спа'-се во ца'р-ствi-и    тво-е'мъ.

