%н п2 м2 с2 с2 с1н1 м2 с2 н1г1 н1с1м2 с2с1н1 м2н2
%т Чю-до пре-ве-лi-е ро-со-да-ви-цу

%з Э: пК: мТ. нЭ пК: мТ. п/: \? т_/: в=:`
%н с1м1 п2 м1с1 н2 п2 м1с1 м1п1 м1с1 м2п2 в4
%т во w-бра-зё пе-щ(е) _о-бра-зо-м(е)

%з сТ. Э: вК: пТ. пК. л\ с=`
%н с1н1 м1п1 в2 п1м1 п2 н1м1 с4
%т ни _я-же бо прi-я-т(о)

%з нЭ сК. рТ рТ. Э: пК. л\ с=`
%н н2 с2 с2 с1н1 с1м1 п2 н1м1 с4
%т не w-па-ли ю-ны--х(о)

%з рТ! рТ! рТ.! Э: птКч пК:!у тДд`
%н с1 с1 с1н1 с1м1 п2м2 п1 м1с2
%т та-ко же ни _о-гн(е) _

%з Э: вК: п/ч сТ. Э: пК: мТ сТ. мК: сТ \? мб_/: стКч с=` бТ:
%н м1п1 в2 п1м1 с1н1 с1м1 п2 м2 с1н1 м2 с2 н1г1 н1с1м2 с2н2 с2 с1м1
%т бо-же-стве-ны-и дё-ву-ю же про-и-де чи-сту _

%з п=: рТ рТ. Э: вК: пТ. пК. л\ с=`
%н п4 п2 п1с1 м1п1 в2 п1м1 п2 н1м1 с4
%т тёмъ по-ю-ще во-зо-пi-е-м(о)

%з нЭ сК:! рТ.! Э: птКч пК:!у тДд` птКч
%н н2 с1 с1н1 с1м1 п2м2 п1 м1с2 п2м2  
%т да бла-го-сло-ви-т(е) _          тварь

%л.27

%з сТ. мК: сТ \? мб_/: стКч с=` бТ:
%н с1н1 м2 с2 н1г1 н1с1м2 с2н2 с2 с1м1
%т в(е)-ся-ка-я го-спо-да _

%з пК: рТ. стКч мК. с\ н=` бТ:
%н п2 п1м1 с2н2 м2 с2 н2 с1м1
%т и пре-во-зно-си-т(е) _

