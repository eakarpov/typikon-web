%код w11sw
%Набор Е. Нечипоренко
%текст {В}нё\д ве\ч и в\ъ по\н на {Б}г~ъ {Г}ь~

%з с=.бТ: пК: мТ сТ. мК: сТ \? мб_/:
%н с2=с1м1 п2 м2 с1н1 м2 с2 н1г1 н1с1м2
%т {Ч}у--до чу-десъ бла-го-да-

%з с=\ н= _ Э: мт_./о ст_./ нт=.\
%н с4 н4 = г1н1 с2м1с1 н2с2 н4н2г2
%т тна-я въ те-бё зря-щи+.

%з н_/ сК: рТ. гЭ н\ с=.
%н н4 с2 с1н1 г2 н2 с4
%т тварь ра--ду-е-тся+.

%з нЭ+ Э: пК:ч сТ нТ гЭ н\ с_/
%н н2 с1м1 п2м2 с2 н2 г2 н2 с4
%т за-ча-ла бо _е-си без-се-

%з н= с_/ пт_:/ сТ м:/ч нЭ с\ нт=.\
%н н4 с4 с2м1п1 с2 м1с1 н2 с2 н4н2г2
%т ме-ннw+. и ро-ди-ла _е-си+.

%з н_/ сК: гТ. гК:ч *н= Э: вК: пТ.
%н н4 с2 г1ц1 г2ц2 *н4 м1п1 в2 п1м1
%т не-из-ре-че-ннw+. _е-го--

%з сТ рТ рТ. Э: пК: м\ с= бТ: пК:
%н с2 с2 с1н1 с1м1 п2 м2 с2 с1м1 п2
%т же чи-но-на-ча-ли-я _ ан-

%з м\ с= пт_./+ рК: рТ. сЭ
%н м2 с4 н2п2 п2 п1м1 с2
%т ге-лwвъ+. ви-дё-ти не

%з м_/ с= мКч нЭ пК: мЭ
%н м4 с4 м2с2 н2 п2 м2
%т мо--гутъ+. то-го мо-

%з пК:ч сТ. мК: сТ \? мб_/: с=\ +
%н п2м2 с1н1 м2 с2 н1г1 н1с1м2 с4 н4\
%т ли w ду-ша-хъ на--шихъ.

