%Расшифровка С.Хохряков
%текст Б}г~о. {С}ла\в. {[I]=}[+]н~нё.

%з сТ. т_:/ сТ м:/ч Э с\ Х` сА рК:
%н с1н1 с2м1п1 с2 м1с1 н2 с2н1 с1н2 с2 с2
%т {В}се-м[и]'-р(е)-н[о_у]-ю сла'-в[о_у] w=-т(о)

%з нТ Э нТ рТ. лЭ: :/ч =чк т_./+ (_./+)Х`
%н н1 г1 н2 н1г1 н1с1 с1н1 н!г!ц1г1ц1 *н2г2ц1 ц1*н2
%т че-л0-вё^-к(0) пр0-з[_я]'-б(0)-ш[о_у]-ю[,]

%з Т. Э: сК: Т р/: \ б_/:о (м_./о)с=:` Э
%н г1ц1 г1н1 с2 н2 г1н1 г1ц1 г1н1с1н1 с4 г1
%т и= вла-ды'-к[о_у] р0'-ж[|д](е)-ш[о_у]-ю не-

%з н_/ Э: пК: мТ. Э Э+ Э: пК: р/ч
%н н4 с1м1 п2 м1с1 н2 н2 с1м1 п2 п1м1 
%т бе'-сн[о_у]-ю две'-р(е) в0-сп0-и'-м(о)

%з рК: Т \ п=ч =\ =` сА Э Т.
%н п2 с2 н2 м1п3м1 с4 н4 с2 н2 с1н1 
%т ма-р[и]'-ю д[е|ё]'-ви-ц[о_у], бе-спло'-т(е)-

%з Э: вК: пр/ч р:/ч бТ: п=:` Э Э: п./ч
%н м1п1 в2 п1м1 п1м1 с1м1 п4 н2 с1м1 п1с1
%т н(0)-(и)-м(0) пё'--ёснь[,] а вё'-р(е)-

%з (/:)рК: тДЭ (/:)пК: Д п=ч =\ =` с= бТ:
%н м1п1 м1с1н2 м1п1 с1н1 м1п3м1 с4 н4 с2 м1п1
%т ны-м(0) о_у=-д0-бре'-н[и]-е[.|:] та' _

%з вК:ч пК: л\ =` Э нК. Т. Э: с=\
%н в2п1м1 п2 н1м1 с4 г2 н2 г1ц1 г1н1 с2с1н1
%т б0 _я=-ви'-с[_я] не'-б0 и= це'-ркви

%з Э: п\ =ч =\ =` бТ: т_:/ сТ м:/ч
%н с1м1 п1м1 с1м1с1н1 г1н1г1ц1 *н2 г1н1 с2м1п1 с2 м1с1
%т б0-же'-стве-[|н]на-[_я][:] _ та пре-гра-

%з Э с_/ Х` с_/ Т. лЭ: :/ч =чк
%н н2 с2н1 с1н2 с4 н1г1 н1с1 с1н1 н!г!ц1г1ц1
%т жде'-н[и]-е вра-жды` ра-зр[о_у]-ши'-

%з б_/:о с=.` Т: вК: Т. Э: п:/ч бТ: п=:` Э+ Э: пК:
%н г1н1с1н1 с2 м1п1 в2 п1м1 с1м1 п1м1 с1м1 п4 н2 с1м1 п2
%т в(0)-ши[,] _ м[и]'-р(0) в(0)-ве--де`[,] а ца-р(е)-

%з тДЭ п/: бД п=ч =\ =` с=\ в_/:о рК:
%н м1с1н2 м1п1 с1н1 м1п3м1 с4 н4 с2с1н1 м1п1в1п1 в2
%т ств[и]-[_я] w=-т(о)-ве'-р[s]е. то-[_я]` о_у='-

%з Т. пК: м/: с=` Э нК. Э: с=\ Э: п\
%н п1м1 п2 н1м1 с4 г2 н2 г1н1 с2с1н1 с1м1 п1м1 
%т б[0] и=-м[о_у]'-ще вё'-р(е)-н0-е о_у=-тве-

%л.154

%з =ч =\ =` сА Э с= Т: вК: Т. Э: п/ч бТ: п=:`
%н с1м1с1н1 г1н1г1ц1 *н4 с2 н2 с2 м1п1 в2 п1м1 с1м1 п1м1 с1м1 п4
%т рж[|д]е'-н[и]-е[.] п0-б0'-р(е)--ни-ка и='-ма--мы

%з Э Э: пК: р/ч п/: тДЭ п/: бД =ч =\ =`
%н н2 с1м1 п2 п1с1 м1п1 м1с1н2 м1п1 с1н1 м1п3м1 с4 н4
%т и=-з[\+]не-[_я]` р0'-ж[|д](е)-ша-г0-ся го'-спо-да[.]

%з Э: птК:ч Т. Э: (т=.\)с=\ Э: пК:ч Т.
%н с1м1 п2м2 с1н1 г2н2 с2с1н1 с1м1 п2м2 с1н1
%т де-р[s]а'-[й]те о_у=-б[о][,] де-р[s]а'-[й]те

%з мК: Т \ (Щ)_/: =\ =` сА Э сТ рТ.
%н м2 с2 н1г1 н1с1м2 с4 н4 с2 н2 с2 с1н1 
%т лю'-д[и]-е б0'-ж[и]-и[:] и='-б0 т0'[й] по-

%з Э: б**/ Э: п./ч Т: п=:` Э+ Э: пК: тДЭ п/:
%н м1п1 в!п!м1п1м1 с1м1 п1м1 с1м1 п4 н2 с1м1 п2 м1с1н2 м1п1
%т бё-ди'--т[\+]вра--ги`[,] _я='-к[0] че-ло-вё-

%з бД п=ч =\ +
%н с1н1 м1п3м1 с4 н4\
%т к0-лю'-б(е)-че.

%Примечание На поле л.153о киноварью вариант 5-й строки:

%з пК: Т. Э мЩк =\ =
%т ма-р[и]-ю дё-ви-цу

%Примечание На поле л.154 киноварью варианты развода:

%з вК: пК:- тД п:/ч Т: _ п=:
%з вК:ш п_/ Дч пК:- Дк мТ п=:
%т ди _ _ вра---ги

%Разница
   дё'в[иц|]у
   беспло'тны[м|х]ъ ... [а|и] вёрны[м|х]ъ
