%з н= Э: пК: стК.ч мК: сЗ: г=\ нт_/:-
%н н4 с1м1 п2 с2н2 м2 н1с1н1ц1 г2г1*н1 ц2г2н4
%т ми во-спо-емъ свя-ти-те-ля

%з пб_:/ п/: мЧ Э: м\ с=? нЭ+ Э:
%н с1м1п2 м1п1 м1с1 н1с1 м2 с2н2 н2 с1м1
%т ди-вна-го в[|\ъ]чю-де-сёхъ и бе-

%з пК: мТ рТ. пЗ: мт_./ с=?
%н п2 м2 м1с1 м1п1м1с1 н2м2 с2н2
%т зпло-тныхъ со-жи-те-ля

%з сА? Э: сЩ?к Э: мК: рК: лЧ б/: г=\ нт_/:
%н с1н1 г1н1 с1н1с2 н1с1 м2 м2 н1с1 н1ц1 г2г1*н1 ц2г2н4
%т w-свя-ще-нна-го w\т пе-ле-ны

%з рТ. сЗ: (ЭТ:)_/: п=: рТ. Э: пК:
%н н1г1 н1с1н1г1 н2с1м1 п4 п1м1 с1м1 п2
%т сто-лпа це-ркви не-по-дви-

%з мТ с\ н= рТ. сЗ: (ЭТ:)_/: п=: р:/ч пб_:/ м=ч н=\
%н м2 с2 н4 н1г1 н1с1н1г1 н2с1м1 п4 п1м1 с1м1п2 м2с2 н4
%т жа-е-ма ве-се-ли-е зе-мли на-

%з г= мт_./+- м/: стДЭ н\ г= нТ рТ.
%н г4 н2м4 с1м1 с1н1г2 н2 г4 н2 н1г1
%т шей пра-вдё пра-ви-ло си-ро-

%з сК. нТ. сЗ: ст_./ м=: рТ. п=ч пб_/:о
%н с2 н1г1 н1с1н1г1 н2с2 м4 м1с1 м1п3м1 с1м1п1м1
%т тамъ пи-та-те-ля w-би-ди-

%з п=: Э: п=ч сДЭ мт_./+- рТ рТ.
%н п4 с1м1 м1п3м1 с1н1г2 н2м4 м2 м1н1
%т мымъ за-сту-пни-ка и бо-

%з пт_:/ нЭ сК.? Э: м\ п=ч =\ +
