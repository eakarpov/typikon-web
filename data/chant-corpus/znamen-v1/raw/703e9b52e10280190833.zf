%т го-спо'-день вер-ху` го-ры` о_у=-вё'-дё-хо-мже вла-ды'-чи-це

%з рТ- Э: пК: мТ. рК: сТ рТ н\? мб_/: с=\ н= сЩкм сТ рТ рТ рТ
%н с1н1 с1м1 п2 м1с1 м2 с2 с2 н1г1 н1с1м2 с4 н4 с1н1м2 с2 с2 н2 с2
%т w= те-бё` _ и='-сти-нно-е збы'-тi-е го'-ры бо и= хо'-

%з рТ- м/: сЧ гЭ н\ с=бТ: пК: мК. сТ рТ- мК: сТ н\? мб_/: с=\ н=
%н с1г1 н1м1 с1н1 г2 н2 с2с1м1 п2 м2 с2 с1н1 м2 с2 н1г1 н1с1м2 с4 н4
%т лми о_у=-кра-си'-ша-ся мно-го-и-мё-ни'-ты-ми це-рква'-ми

%з сТ. мЗ: сб_/:? р=: н=бТ: пК:ч сТ- мК: сТ н\? мб_/: с=\ пт_:/
%н с1г1 н1м1с1н1 г1н1с1н1 с4 н2с1м1 п2м2 с1н1 м2 с2 н1г1 н1с1м2 с2н2 с2м2п4
%т тво-и'хъ пра^-здникъ[|.] тё'мъ ве'-се-л[о] во-пi-е'-мъ ти

%з Э: м\:к нЭ+ пб_./+ в=\ рК: пЩк
%н н1с1 м1с1м1с1 н2 н1п3 в2в1п1 в2 п1м1п2
%т w=-бра'-до-ва-нна-я ра'-

%л.54

%з м\ с= нЭ+ вб,,:/ пТ- п\ с=
