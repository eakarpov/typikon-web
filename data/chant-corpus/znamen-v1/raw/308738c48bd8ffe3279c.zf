%з %[_ нА пт_./+- м=+ п:/ч с./ч суДЭ н=%]
%т %[{р}о\з. и бо-----гъ%]
%н _ н2 н2п4 м4 п1м1 с1н1 с1г1 н4

%з рЭ+ Э: пК: рТ Э: вК:
%т че-ло-вё-кwмъ w\т дё-
%н н2 с1м1 п2 п2 м1п1 в2

%з рТ. мЭ п_/ мКч м= нЭ рТ сТ
%т вы _я-ви--ся. во-_о-бра-
