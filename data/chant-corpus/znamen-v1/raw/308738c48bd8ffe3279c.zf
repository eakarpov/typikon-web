%з рТ мТ с_/ нКч н= пт_./+-
%т _о-бо-живъ _ плоть. тём\ъ
%н п2 м2 с4 н2г2 н4 н2п4

%з рТ рТ рТ рТ вб_:/ рК:
%т а-дамъ wб-но-вля-ет-
%н п2 п2 п2 п2 м1п1в2 в2

%з п= Э: вК: рТ рТ. мЭ п_/ м=
%т ся со _е-vо-ю зо-ву-ще:
