%Расшифровка Е.Ю.Нечипоренко
%Набор Е.Ю.Нечипоренко
%л.16о
%код a01pq2!w
%л.25, то же на л.43о
%текст Покро'во_у. На цёлова'нiи. И='нъ w=смогла'сникъ.
%Набор А.В.Коваленин (крюки, текст), Е.Ю.Нечипоренко (ноты).
%Расшифровка Е.Ю.Нечипоренко.

%текст гла\с 1

%з сА рТ рТ п/: сТ рТ рТ рТ м:/ч нЭ с\    нЭЭЧ
%н с2 с2 с2 с1п1 с2 с2 с2 с2 м1с1 н2 с2н1 с1н2
%т Бо-го-на-ча'л[|ь]-ны-м(е) ма-но-ве'-н[и]-е-м(е)[,]

%з с/: рТ. н=ч *н,,/ *г= нЭ+ Э: пК: мТ.
%н н1с1 с1н1 н!г!ц1г1ц1 *н4 *г4 н2 с1м1 п2 м1с1
%т [w=|_W^=] пре-ди'-ве-н(о) бо-го-сло'-ве-

%з н= Т:б пК: рТ. пК: тТ: =\ = сТ. м/: с\?
%н н2 с1м1 п2 п1м1 п2 с1м1н1 с4 н4 с1н1 с1м1 с1н1
%т ц(е) _ со пре-д(о)-т'е-че-ю не-ве-ще'-

%з сб_./:н с=: бТ: пК: сТ. мК: сТ н\? мб_/: с=\ н=
%н г1н1с1н1 с2 с1м1 п2 с1н1 м2 с2 н1г1 н1с1м2 с4 н4
%т стве-но _ д(е)-не'-с(е) пре-д(о)-сто-я'-ху.

%текст гла\с 5

%з пА рТ рТ рТ. пК: мТ. нЭ мб=ч н,,/ г=
%н п2 п2 п2 п1м1 п2 м1с1 н2 г1м2с1 н4 г4
%т Бо-го-лё'-п(е)-но в(о) пре-че- стнё'-м(е)

%з вА рТ *п/: вТ р./ч мЭ   в\ ррЭЭЧп
%н в2 в2 в1*п1 в2 в1п1 м2 в2п1 в1п2
%т и= бо-же'-стве-нё-м(е) хра'-мё

%з пТ.с Э: вК: пТ рТ. пК: мТ. нЭ м=ч н,,/ г=
%н п1с1 м1п1 в2 п2 п1м1 п2 м1с1 н2 г1м2с1 н4 г4
%т в(е)-се-кра'-с(е)-ны-я ма'-те-ре свё'-та.

%текст гла\с 2

%з мЭ пТ. Э: в=:  пТ рТ рТ.с Э: вК: рТ. мТ с\ н=
%н м2 п1с1 м1п1 в4 п2 п2 п1с1 м1п1 в2 в1п1 м2 с2 н4
%т пре-вы-ш(е)-ня-я же не-бе-с(е)-ны-я си-лы[.]

%з мА рТ.н Э: пК: мТ рТ. Э: вК: лЧ      сп/: м=\ пт_/:-
%н м2 м1н1 с1м1 п2 м2 м1с1 м1п1 в2 м1в1 п1с1 м2м1н1 с2м2п4
%т пре-д(о) сво-имъ вла-ды-ко-ю при-ше-д(о)-ше.

%текст гла\с 6

%з м\:к нЭ+ пТ. в/: р:/ч
%н м1с1м1с1 н2 п1м1 п1в1 в1п1
%т Бо-го-при-я'т-н(о)

%з м_/ срЭЭЧн нТ. сК: рТ рТ. Э: м=\ т/:
%н м2с1 с1н2 н1г1 с2 н2 н1г1 н1с1 м2м1с1 н2с1н1г2
%т зря-ще пре-чи-сту-ю вла-ды-чи-

%з =: Э: п\? =ч =\ = нА Э:  с/чг
%н н2с2н2н1м1с4н4 с1м1 п2 м2с2 н4 г4 н2 г1н1 с1г1
%т цу по-кры-ва-ю-щу че-ст(е)-ны-

%з Э: мК: с=.ч Э: м\ с=Э с_/ н=Э
%н н1с1 м2 н1с1н1г1 н1с1 м2 с2н3г1 г1н1с1 н4
%т (и)-м(е) а=м-фо-ро-м(о) лю-ди.

%текст гла\с 4

%з Э: вК: рТ пТ.с Э: вК: п/: м\ н=
%н м1п1 в2 в2 п1с1 м1п1 в2 м1п1 м1с1 н4
%т Пре-мир-но же пре-ди- хо-жа-ху

%з мА! рТ! п_/ рТ! рТ! рТ! рТ! мЗ:Ф=Э _ _
%н м1 м1 п4 п1 п1 п1 п1 м4п2п1м1с1м1п2м2 м1с1н1с1м2 с2н2с2м2п4м4
%т и не-ви-ди-мо во-пи-я--ху

%з нЭ мК: рТ пК: ст_./п м= рТ. пК: мТ п\? с=чк гЭ с\ н=
%н н2 м2 м2 п2 с2п2 м4 м1с1 п2 м2 п1м1 с1н1с1н1 г2 с2 н4
%т пре-вы-ше-не-и-мо чи-но-на-ча-ле-ни-ко-мо

%з гЭ+ сК: рТ. Э: пК: мТ. н= рЭ+ Э: пК: рТ рТс п/: мтДЭ
%н г2 с2 с1н1 с1м1 п2 м1с1 н4 н2 с1м1 п2 п2 п1с1 м1п1 м1с1н2
%т се ве-сё-хо ца-ри-ца во це-ркви пре-вы-ше пре-

%з пб=ч с=\ н=
%н м1п2м1 с4 н4
%т до-сто-итъ

%текст 3

%з пА рТ. вЗ: Э: п:/ч бТ: п=: мЭ пК: рТ рТ Т.с Э: в=: вЗ:
%н п2 п1м1 п1в1п1м1 с1м1 п1м1 с1м1 п4 м2 п2 п2 п2 п1с1 м1п1 в4 п1в1п1м1
%т со ли-ки свя-ты--хо а-по-сто-ло и про-ро-ко

%з в/: п\? пб=ч м,,/к с= пТ.! в/: п\? т_./ *м=:ш *мТ. Э: *мК:
%н п1в1 п1м1 с1м1п2 м1с1м2 с4 п1м1 п1в1 п1м1 п2в2 *м4 *м1в1 п1в1 *м2
%т и му-че-ни-ко свя-ти-те-ли же со пре- по-

%з лЧ п/: =\ = пТ. в/: п\? вбЭЭ\ р=ч
%н п1в1 п1м1 п4 м4 п1м1 п1в1 п1м1 с1м1п1в1 в1п4
%т до-бе-ны-ми то-я бо ра-ди

%текст 7

%з Э: с_/ р/: рЧ т_./ с=: рТ. Э: пК: н/:м с=
%н г1н1 с4 н1с1 с1н1 г2н2 с4 с1н1 с1м1 п2 н1м1 с4
%т ве-се-мо-ще-но-е зе-ме-ны-и-мо

%з Э: сК: лЧ н/:ц г=\ н= с_/ рТ рТ мтДЭ Э: п\? =ч =\ =
%н г1н1 с2 н1с1 н1ц1 г4 н4 с4 с2 с2 м1с1н2 с1м1 п2 с1н1с2 н4 г4
%т спа-се-ни-е бы-сте нань же во-зрё-ти не мо-же-мо

%з гЭ нК: гтДЭ гКч ст_/:- рТ рТ рТ. Э: пК: мТ
%н г2 н2 г1ц1*н2 г2ц2 г2н2с4 с2 с2 с1н1 с1м1 п2 м2
%т _я-кw же то-гда чю-дны-и а-ндре-и

%з сТ. Э: пК: сТ мтДЭ Э: п\? с=чк =\ = Э: с_/ нТ. с/: рЧ Э!- с=:
%н с1н1 с1м1 п2 с2 м1с1н2 с1м1 п2 с1н1с2 н4 г4 г1н1 с4 н1г1 н1с1 с1н1 г2н2 с4
%т со бла-же-ннымъ _е-пи-фа-ни-е-мо ви-дя-ще на во-зду-сё

%з Э: п_/ мтДЭ с=. гТ. Э: сК: лЧ н/: =\ =
%н с1м1 п4 м1с1н2 с4 г1ц1 г1н1 с2 г1с1 н1ц1 г4 н4
%т мо-ле-бе-но ру-цё про-сти-ра-ю-щи

%текст 8 w\ттля

%з гЗ:Ф =:
%н г1ц1г1н1 с2с1н1 с1м1п2м!с1м1п2п1в1п2м2м2с!н1г1н1с1м2с!н1с4с2н2г2н1с1н4
%т тё-ме

%з сЧ. Э: нТ Э: в/: пЧ сТ. с\ н= мА нЭ мТ.н Э: пК: мТ. нЭ вб_:/ птДЭ п=:
%н с2н1г1 ц1г1 н2 с1м1 п1в1 п1м1 с1н1 с2 н4 м2 н2 м1н1 с1м1 п2 м1с1 н2 м1п1в2 п1м1с1м1 п4
%т пре-чи-ста-я бо-го-ро-ди-це при-сно сжи-во-но-сны-мо ца-ре-мо

%з мА рТ рТ.н Э: п\? =ч =\ = Э: с_/ нТ. мб_:/ФЗ =:
%н м2 м2 м1н1 с1м1 п2 м1.с!н1м1 г1н2с1 н1г1н4 г1н1 с4 н1г1 н1с1м2 с2с1н1с1м1п2м!с1м1п2п1в1п2м2м2с!н1г1н1с1м2с!н1с4с2н2г2н1с1н4
%т и ро-же-ство-ме жи-ву-ще мо-ли-ся все-гда

%з сА рТ. мК: сТ н\? мб_/: с=ч  мА рТ.н Э: пК: мТ рТ рТ рТ.н Э: п\?
%н с2 с1н1 м2 с2 н1г1 н1с1м2 с2н2 м2 м1н1 с1м1 п2 м2 м2 м2 м1н1 с1м1 п2
%т со-хра-ни-ти и спа-сти w-то ве- сё-хо про-ти-ве-ны-и-

%з м=ч =\ = *мК: вб=ч вК: рТ мТ с\ н=
%н м1.с!н1м1 г1н2с1 н1г1н4 *м2 п1в2п1 в2 в1п1 м2 с2 н4
%т хо по-лко но-вы-я лю-ди тво-я

%з Э: в=:шФЗ=:
%н м1п1 в4*м2в1*м1*п2 *п2*м!в1п1в1*м1в2п1м1с2м2п2м2п2м2п1м1с2 м2п2м2п1в1п4
%т тво-е _ бо

%з мА пК: м\? п_/ Э: п\? =ч =\ =
%н м2 п2 м1с1 м1п2м1 с1м1 п2 м1.с!н1м1 г1н2с1 н1г1н4
%т за-сту-пле-ни-е стя-жа-хо-мо

%текст 1

%з сА рТ. мК: м/: с\? сб_/:он с=: рТ. мК: сТ рТ. сб_/:о ФЗ=: _ бТ:
%н с2 с1н1 м2 с1м1 с1н1 г1н1с1н1 с4 с1н1 м2 с2 с1н1 г1н1с1н1 с4м2п4м1с1м4с4 н2н1г1н1с1м2с2 н1с1
%т и че-стны-и по-кро-во свё-то-w-бра-зе-но _ _

%з мК: сТ н\? м_/: с=\ н+
%н м2 с2 н1г1 н1с1м2 с4 н4\
%т да о_у=-бла-жа-е-мо.

