%код i213

%з нЭ м_/ пК: сТ. с\ н= пЗ: нТ.
%н н2 м4 п2 с1н1 с2 н4 м1п1м1с1 н1г1
%т По-емъ го-спо-де-ви в[|\ъ]мо-ри

%з мт_./ рт=.\ мК: сК. нЭ с_/ нЭ бТ:
%н н2м2 м2с4н2н1г1н1с4н4 м2 с2 н2 с4 н2 с1м1
%т дре-вле лю-ди на-ставль-ше--

%з п=: Э: вК: рК: пТ. пК: мтДЭ п_/ вК:
%н п4 м1п1 в2 в2 п1м1 п2 м1с1н2 п4 в2
%т му и в[|\ъ]немъ фа-ра-_w-на с\ъво-и

%з рТ. мК. с\ н= пТ. Э: *мК% вК:
%н в1п1 м2 с2 н4 п1м1 п1в1 *м2 в2
%т по-топль-ше-му пёснь по-бё-дну-

%з пК: вК: пТ. Э: в=: п_/ м+
%н п2 в2 п1с1 м1п1 в4 п4 м4\
%т ю _я-ко про-сла-ви-ся.

