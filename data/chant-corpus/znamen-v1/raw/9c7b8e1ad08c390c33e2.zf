%код w10bn

%текст КНИ'ГА ГЛ~МА_Я W=КТА'И СИ'Рёчь }W={смогла'сникъ.
 }В{субо'ту ве'черъ. }Н{а ма'лёй вече'рни. }Н{а'д\си возва\х.
 }С{ла'ва. }И={нн~ё. }Б{г~ородиченъ.

%л.5

%з мт_./о нЭ с\ сЗ:`
%н с2м1с1 н2 с2 н1с1н2
%т {Р}а--дуй-ся

%з нЭ пб_:/ рТ. пК:
%н н2 с1м1п2 п1м1 п2
%т wт насъ свя-та-

%з мтДЭ нЭ Э: пК: мТ.
%н м1с1н2 н2 с1м1 п2 м1с1
%т я бо-го-ро-ди-

%з нЭ пб=ч с=\ н=` сК.
%н н2 м1п4м1 с4 н4 с2
%т це дё--во чи-

%з нЭ сТ. Э: п=: мтДЭ нЭ пб_:/
%н н2 с1н1 с1м1 п4 м1с1н2 н2 с1м1п2
%т сты-и со-су-де все-й

%з рТ. лТ: с=\ н=` Э: вК: пТ.
%н п1м1 с1м1н1 с4 н4 м1п1 в2 п1м1
%т все-ле--ннёй свё-ще не-

%з сТ. Э: пК: м\ с=` гТ. нЗ:
%н с1н1 с1м1 п2 м2 с4 г1ц1 г1н1г1ц1
%т о_у-га-си-ма-я вмё-сти-

%з тЭ!- с_/` гТ. Э: сК. гсЗ:н г=\
%н г2н2 с4 г1ц1 г1н1 с2 г1с1н[1|2] г2
%т ли-ще не всё-сти--ма-

%з н=` бТ: вК: пТ. сТ рТ. Э:
%н н4 м1п1 в2 п1м1 с2 с1н1 с1м1
%т го _ це-ркве не-w-бо-

%з пК: м\ с=` пт_:/ сТ рТ гЭ
%н п2 м2 с4 с2м1п1 с2 с2 г2
%т ри-ма-я ра-дуй-ся из-

%з н\ сК. рТ рТ рТ рТ рТ рТ
%н н2 с2 с2 с2 с2 с2 с2 с2
%т не-я же ро-ди-ся а-гнецъ

%л.6

%з м:/ч нЭ с\ н=` бТ: п=: сКч
%н м1с1 н2 с2 н4 с1м1 п4 с2н2
%т бо--жi-и _ взе-мля-

%з мК: с\ н=` бТ: пК: лТ: с=\ н+
%н м2 с2 н4 с1м1 п2 с1м1н1 с4 н8\
%т и грё-хи _ все-го ми-ра.

