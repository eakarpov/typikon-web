%код i290

%л.55о

%текст вне\д нао_у\т.

%з пА Э: в=: пТ. Э: пК: мТ. нЭ
%н п2 м1п1 в4 п1м1 с1м1 п2 м1с1 н2
%т Бе-зна-ча-лна ро-ди-те-ля

%з вр=\ *мЗ: мТ рТ. пЗ: нЭ
%н в2в1м1 п1*м1в1п1 м2 м1с1 м1п1м1с1 н2
%т сынъ богъ и го-сподь во-

%з с_/ рК. рТ нЭ с_/ рТ. п/:
%н с4 с2 с2 н2 с4 с1н1 м1п1
%т площь-ся w[|\]т дё-ви-цы намъ

%з мТ. нЭ бТ: п=: гЭ н\ с_/ рТ рТ.
%н м1с1 н2 с1м1 п4 г2 н2 с4 с2 с1н1 
%т _я-ви--ся w-мра-че-нны-я

%л.56

%з п/: мТ. нЭ бТ: п=: рТ. Э: вК: пК:
%н м1п1 м1с1 н2 с1м1 п4 п1с1 м1п1 в2 п2 
%т про-свё-ти--ти и со-бра-ти

%з мТ рТ. пЗ: нЭ бТ: п=: р_/ Э:
%н м2 м1с1 м1п1м1с1 н2 с1м1 п4 п4 м1п1
%т ра-сто-че-нны--я тёмъ все-

%з в=: пТ рТ рТ рТ. пК: мТ. нЭ
%н в4 п2 п2 п2 п1м1 п2 м1с1 н2
%т хва-лну-ю бо-го-ро-ди-цу

%з вТ рТ. *мЗ: п_/ м+
%н в2 в1п1 в1*м1в2 п4 м4\
%т ве-ли-ча--емъ.

