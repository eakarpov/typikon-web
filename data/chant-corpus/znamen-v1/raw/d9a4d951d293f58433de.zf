%т пре--чи'-ста-г[о] ти тё'-ла го-то-вля'-ше-ся[,]

%з сТ. м/: стКч бТ: с_/  Э: н\: *нЭ+ нб_/: м/:
%н с1г1 н1м1 с2н2 с1н1г1 с3н1 ц1г1 н4 *н2 ц1г1н2 н1м1
%т то-гда` _ а=-по'-сто-ли [_о|w]=--б[\ъ|]сто-

%з стКчу=.ч =\ = пб_:/ м\ стДЭ мб,,/: ст=Э б_/ н=Э
%н с1н1г2н2н1ц1 г1н1н1г1н2г1 ц1г2ц4г2ц4 с1м1п2 м2 с1н1г2 н1с1м2 с2н2г1 г1н1с1 н4
%т я'-ще _о='дръ[,] с\ъ+тре'-пе-томъ зря'--ху тя`[.]

%з рЭ мК: рТ. пЗ: нЭ+ Э: вК: пК. мТ. пЗ: ст!/: #г\ т=:
%н н2 м2 м1с1 м1п1м1с1 н2 м1п1 в2 п2 м1с1 м1п1м1с1 н2с1н1 г2 н2с2н2н1м1с4н4
%т и= _о='-ви о_у='-б[о] взи-ра'-ю-ще на тё'--ло

%з пт_./+о сК. нТ #гТ. Э: сК.ч #г\ нб,,/ =\ =
%н н2п3м1 с2 н2 г1ц1 г1н1 с2н2 г1ц1 *н1ц1г1н1 г2ц1г1 н4
%т о_у='-жа-сомъ [_о|w]=-де-ржи'-ми бя'--ху[,]

%з тТ:ФЗ =:
%н н2с1н1г2 н2с2м1н1с1м1п2п1в1п2м2м2с!н1г1н1с1м2с!н1с4с2н2г2н1с1н4
%т пе'тръ же

%з тЭ!- пК:ч с=.\ РФЗ =:
%н с2м2 п2м2 с4с2н2 г2с1н1г2н2г4н2с2н1г1с4н2н1с1н2%[н2г1с1с1н1г1с1с1н1г2 н2г1ц1г2ц4г2ц4%]
%т со _ сле-за'-ми

%з м/: сК.ч бТ: с_/ Э: н\: с_/ нтКч н= тЭ!- в=: вуК:! тД п=: руК:! тД м_/
%н н1м1 с2н2 с1н1г1 с3н1 ц1г1 н4 с4 н2г2 н4 м2п2 в4 в! п!м1 п4 п! м!с1 м4
%т во-п[и]--я'-ше ти`[:] [_w|_w=^]

%з рТ. п/: мтДЭ сб_./+- Дк н= #гТ с/: н=  с_/ нЩк тЭ!- п=: мК.- Дкч
%н м1с1 м1п1 м1с1н2 н1с4 н1г1 н4 г2 н1с1 н4 с4 н1г1н2 с2м2 п4 м2. с!н1г1
%т _ _ _  дё'---во _ _ ви'----ж[ю|ду] _

%з сб_./+- =\ = с./ч пО_/ м_/ сК. #гЭ н_/ мТ. п/: мр=\
%н н1с4 н1г1н4 г2н1с1н4 с1г1 н2с1м1п4 м4 с2 г2 н4 м1с1 м1п1 м2м1с1
%т тя` _я='-сн[о] про-сте'-----рту _ _

%з нЭ  суК.! тД нЭ сК. нТ м/: с_/ н=
%н н2 с1 н1г2 н2 с2 н2 н1м1 с4 н4
%т про'---сту[,] _ _ _ _ _

%поле
%з {Кч =: =. Д З З =.ч =\ =}

%з с_/ нтКч н= тЭ!- в=: рК:- тД вб_./+- пК: Дк стКч п:/ч пб_:/ рДк
%н с4 н2г2 н4 м2п2 в4 в3 п!м1 п1в4 п2 п1м1 с2н2 п1м1 с1м1п2 п1с1
%т жи---во-т[ё|а]` _ _ _ _ _ _ _ _ _

%з п/:-о мЭ пК:- Х мК: с= мК: с= #гЭ н:/ч Э: м_/ рК: нЭ м:/ч п/:
%н м1п3с1 м2 п2м1 с1 м2 с4 м2 с4 г2 н1г1 н1с1 м4 м2 н2 м1с1 м1п1
%т _ _ _ всё'----хъ и= о_у=-ди-вля'-----

%з мК: рД нК. рДк с/: р:/ч рК. нЭ м/: с=. н=+
%н м2 м1с1 н2 н1г1 н1с1 с1н1 с2 н2 н1м1 с4 н4
%т ----ю-ся[:]

%з ст_./+ нтК.ч нТ. бТ: м=: Э: сб_./+ =\ =
%н н2с2 н2г2 н1г1 н1с1 м4  г1н1 н1с3 н1г1н4 г2н1с1н4
%т в\ъ+не'й---- же все-ли'--ся

%з сЗ: нЭ Э: п=: вб,,:/ птДЭ Э: пК: мК: бДч сб_./+- =\ =
%н н1с1н1г1 н2 с1м1 п4 м1п1в2 п1м1с1н1 с1м1 п2 м2 с!н1г1 н1с4 н1г1н4 г2н1с1н4
%т бу'-ду-щ[и]-я жи'-зни на-сла-жде'---н[и]-е[!]

%поле
%з {=.\ _:/ Д З Ф =:}

%з м_/ п=: рК. нЭ тЭ!- п=: Дк мб_./+- рК:! сЭ! сб_./+- тЭ!- мК: п=:
%н м4 п4 п2 н2 с2м2 п4 п!м! с1м4 м! с! н1с4 н2с2 м2 п4
%т но [_w|_w=^]

%з мТ пК: мТ пуК:! тД мЭ пК: мТ в/: п_/ тЭ!- в=: рК: Дк птК:ч пб_:/
%н м2 п2 м2 п1 м1с2 м2 п2 м2 п1в1 п4 м2п2 в4 в2 п1м1 п2м2 с1м1п2
%т _ _ _ _ _ _ _ _ _ _ пре-чи'---ста-я

%з тЭ!- *мт_./+ вК: пК: вб,,:/ Дк *пб_%/ рДчк *м/% вК:- птДЭ пт_./+-
%н м2п2 в2*м2 в2 п2 м1п1в2 в1п1 в1*м1*п2 *м!в1п1 в1*м1 в4 п1м1с2 м2п4
%т мо-ли'-----------

%з мТ пК: мТ пуК:! тД мЭ пК: мТ в/: п_/ н=+ сЗ: нЭ бТ: п=:
%н м2 п2 м2 п1 м1с2 м2 п2 м2 п1в1 п4 н4 н1с1н1г1 н2 с1м1 п4
%т - - - - - ся _ _ _ _ при-лё'---жн[о]

%з рК: мТ. тЭ!- в=: п_/ рТ. в/: пК:ч тЭ!- пб_./+- мК:- сДчк
%н п2 м1с1 м2п2 в4 п4 п1м1 п1в1 п2м2 с2м2 м1п4 м2. с!н1г1
%т сы'----ну и= _ бо'---гу _

%з сб_./+ =\ = мК: Дк тЭ!- в=: рК: Дк тЭ!- *м/% пК:- мК.- с\ нЭ бТ:
%н н1с4 н1г1н4 г2н1с1н4 м2 м1с1 м2п2 в4 в2 п1м1 п2в2 *м1в1 п4 м4 с2 н2 с1м1
%т тво-е-мо_у`[,] спа--сти'---------ся _

%з пК:ч в=: п*/к мтДЭ пб_:/ =.\ =\ =
%н п2м2 в4 п1м1п2 м1с1н2 с1м1п2 п1с1 м1п1п1м1п2м1 с1м2с4м2с4
%т ста'--ду тво-е---му`

%з тЭ!- *мК% *пК%ш *мК% вК: птК:ч в_/ пТ. пК: мК. с\ нЭ+ пб_:/-
%н п2в2 *м2 *п2 *м2 в2 п2м2 в4 п1м1 п2 м2 с2 н2 с1м1п4
%т не-----при--ко----сно--

%з {=: =: ЗЗ =:}

%з пт_./+ мК: бТ: п=: р=: мТ пб_:/- мТ пб_:/- мК. бТ: п:/ч вК: пК: мТ п_/ +
