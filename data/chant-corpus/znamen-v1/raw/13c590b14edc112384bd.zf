%т {И='}-же по w='-бра-зу и= по по-до'-б[и]-ю[,]

%л.95о

%з сТ. мК: сТ нТ рТ. мб_/: =\ = мт_./о нЭ с\ н=
%н с1н1 м2 с2 н2 н1г1 н1с1м2 с4 н4 с2м1с1 н2 с2 н4
%т и=-стлё'-вша пре-сту-пле'-нi-емъ ви'-дёвъ и=-су'съ[,]

%з рК. гЭ сК: нЩк Э:л р:/ч =чк ,,/ = сТ р/ч сб_/:о с=.
%н н2 г2 с2 н1г1н2 г1с1 с1н1 н!г!ц1г1ц1 *н4 *г4 с2 с1н1 г1н1с1н1 с4
%т пр[е|и]-кло-ни'въ _ не-бе-са` сни'-де[,] и= все-ли'-ся

%з рТ рТ. мК: сТ н\? мб_/: с= бТ: вК: пТ. пК: л\ с=
%н с2 с1н1 м2 с2 н1г1 н1с1м2 с2 м1п1 в2 п1м1 п2 н1м1 с4
%т во о_у=-тро'-бу дё-ви'-чю _ не-и-змё'--нн[о][,]

%з нЭ пб_:/ мТ. нЭ Э: пК: р:/ч рК: мТ. нЭ рЭ+ Э: пб/: бД п=ч =\ =
%н н2 с1м1п2 м1с1 н2 с1м1 п2 п1м1 п2 м1с1 н2 н2 с1м1 м1п1 м!с!н1 м1п2м1 с4 н4
%т да в\ъ+не'й и=-стлё'-вша-го а=-да'--ма [_о|w]=-бно-ви'тъ[,] зо-ву'--ща[:]

%з пт_:/ сТ рТ рТ рТ м:/ч нЭ с\ н= с/ч мК: с\ н= бТ: п/: бД п=ч =\ н+
%н с2м1п1 с2 с2 с2 с2 м1с1 н2 с2 н4 с1н1 м2 с2 н2 с1м1 м1п1 м!с!н1 м1п2м1 с4 н4\
%т сла'-ва _я=-вле'-н[и]-ю тво-е-му`[,] и=-зба'-ви-те--лю мо'й бо'--же.

