%код prh9s
%текст Сла'ва {Г}ла\с . {6} .

%з нА Э: с_/ нТ рТ
%т {Д}несь ра-жда-ет-ся
%н н2 г1н1 с4 н2 н2

%з сК: гКч нт_/: рЭ м_/ рТ
%т w\т дё-вы ру-ко-ю
%н с2 г2*н2 ц2г2н4 н2 м4 м2

%з рТ рТ. нЭ с_/ н=
%т всю со-де-ржай тварь
%н м2 м1с1 н2 с4 н4 

%з гЭ нТ с_/ рТ рТ рТ рТ рТ
%т пе-ле-на-ми _я-ко-же зе-
%н г2 н2 с4 с2 с2 с2 с2 с2

%з рТ рТ нЭ с_/ нКч н=
%т менъ по-ви-ва-ет-ся
%н с2 с2 н2 с4 н2г2 н4

%з м_/ рТ нЭ сТ м_/ рТ
%т и-же су-ще-ствомъ не-
%н м4 м2 н2 с2 м4 м2

%з рТ рТ нЭ с_/ нКч н=
%т при-ко-сно-ве-ненъ богъ
%н м2 м2 н2 с4 н2г2 н4

%з м_/ рТ. нЭ с\ н=
%т в\ъ_я-слёхъ воз-лё-жит\ъ
%н м4 м1с1 н2 с2 н4 г

%з гЭ нТ сК. рТ нЭ сТ
%т о_у-тве-рди-вый нё-бе-
%н г2 н2 с2 с2 н2 с2

%з м_/ р_/ рТ нЭ с_/
%т са сло-вомъ в\ъна-ча-
%н м4 м4 м2 н2 с4

%з н= гЭ нТ сК.
%т лёхъ w\т со-сцевъ
%н н4 г2 н2 с2

%з рТ рТ нЭ с=\ пб_:/ с=
%т мле-комъ пи-та-ет-ся
%н с2 с2 н2 с2с1н1 с1м1п2 с4

%з р=. рТ. Э: пК:ч с=бТ: пК:
%т и-же в\ъпу-сты-ни ман-
%н с4 с1н1 с1м1 п2м2 с2с1м1 п2

%з мТ сТ рТ н_/ ст_./+ гКч нт_/:
%т ну w-до-жди-вый лю-дем\ъ
%н м2 с2 с2 н4 н2с2 г2*н2 ц2г2н4

%з нЭ м_/ рТ. нЭ с_/ н=
%т вол-хвовъ при-зы-ва-етъ
%н н2 м4 м1с1 н2 с4 н4

%з гЭ сК. нЭ мК:ч н=
%т же-нихъ цер-ко-вный
%н г2 с2 н2 м2с2 н4

%з м_/ рТ рТ. нЭ с_/ н=
%т да-ры сихъ прi-е-млет\ъ
%н м4 м2 м1с1 н2 с4 н4

%з с=\ пб_/:о мК:ч н= гТ рТ н_/
%т сы-нъ дё-вы. по-кла-ня-
%н с2с1н1 с1м1п1с1 м2с2 н4 г2 г2 н4

%з рТ рТ гЭ нТ сК: рТ.
%т ем-ся ро-жде-ству тво-
%н н2 н2 г2 н2 с2 с1н1

%з гЭ нТ с\ м=: нЭ сТ м_/
%т е-му хри-сте. по-кла-ня-
%н г2 н2 с2 м4 н2 с2 м4

%з рТ рТ нЭ сТ мК: рТ.
%т ем-ся ро-жде-ству тво-
%н м2 м2 н2 с2 м2 м1с1

%з нЭ с_/ нКч н= рЭ Э:
%т е-му хри-сте. по-кла-
%н н2 с4 н2г2 н4 н2 с1м1

%з пК: мТ сТ рТ нЭ с=\
%т ня-ем-ся ро-жде-ству
%н п2 м2 с2 с2 н2 с2с1н1

%з Э: пК: мТ с\ н=
%т тво-е-му хри-сте.
%н с1м1 п2 м2 с2 н4

%з гЭ нТ сК. рТ нЭ сТ
%т по-ка-жи намъ и бо-
%н г2 н2 с2 с2 н2 с2

%з мК:- рТ рТ рТ нЭ мК: рТ сТ
%т же-ствен-на-я тво-я бо-го-
%н м2 м2 м2 м2 н2 м2 м2 с2

%з н\ сб_/: нКч н+
%т я-вле-нi-я.
%н н2 г1н1с2 н2г2 н4\

