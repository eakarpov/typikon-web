%т ни'-м(о)- с[_я] %{_я='-к[о]

%з вт=.\ /: З: Х тКч в_/ */ =.ч =\ =%}
%т бла- го-- и-зво'-%(о-%) ли пло'-т[и]-ю%}

%з %[_ мТ. Э: в=: рК:т Т бТ: ГвК: вК:
%н = м1с1 м1п1 в4 в2 п1м1 п1в1 *м2 в2  
%т %[{р}о\з. _я='-к[о] бла-%(а-а-%) го- %(о- о-

%з пК. мК сТ нЭ+ бТ: тКч в_/
%н п2 м2 с2 н2 с1м1 п2м2 в4 
