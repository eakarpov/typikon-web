%з с\ н= рЭ+ сК. гЭ тТ:
%н с2 н4 н2 с2 г2 н2с2
%т ме-не+. те-бе со-зда-

%з мК:ч н= мТ рТ пТ в=: рТ
%н м2с2 н4 м2 м2 п2 в4 в2
%т вша-w+. и про-свё-ща-ю-

%з рТ рТ рТ. мЭ пК:ч сп!/: м=.
%н в2 в2 в1п1 м2 п2м2 с2п2 м4
%т ща-гw бла-го-да-ти-ю+.

%з пК: рТ мТ с_/ рК нТ гЭ н=
