%т и w-чи-ща-ю-ща-го всё[\х|]хъ+.

%з рТ рТ п_/ рТ рТ рТ рТ
%н н2 н2 п4 п2 п2 п2 п2
%т при-ко-сни-ся бо-же-стве-

%з рТ рТ рТ рТ Э: в\ п=
%н п2 п2 п2 п2 м1п1 в2 п4
%т нно-му мо-е-му ве-рху+.

%з рК рТ рТ вК: мКчн пт_/: в=:
%н п2 п2 п2 в2 м2н2 с2м2п4 в4
%т и не о_у-су-мни-ся+. про-

%з рТ рТ рТ рТ. мЭ пК:ч сп!/: м=.
%н в2 в2 в2 в1п1 м2 п2м2 с2п2 м4
%т че-е w-ста-ви ны--нё

%з рТ сЭ мТ п=: рТ рТ рТ рТ
%н м2 с2 м2 п4 п2 п2 п2 п2
%т и-бо и-спо-лни-ти при-и-

%з м_/ пК: мТ с_/ нКч н=
%н м4 п2 м2 с4 н2г2 н4
%т дохъ пра-вду вся-ку-ю+.

%з п=: мТ сТ рТ нЭ пб_:/ мК:
%н п4 м2 с2 с2 н2 с1м1п2 м2
%т ты же не о_у-су-мни-ся

%з с\ н= гЭ рТ нТ с_/
%н с2 н4 г2 г2 н2 с4
%т wт-нюдъ+. и-бw та-я-

%з рТ рТ рТ рТ рТ гЭ
%н с2 с2 с2 с2 с2 г2
%т ща-го-ся в\ъво-дахъ бо-

%з тТ: мК:ч н= гЭ нТ с_/
%н н2с2 м2с2 н4 г2 н2 с4
%т ри-те-ля+. кня-зя тмы

%з рТ рТ рТ гЭ тТ: мК:ч н=
%н с2 с2 с2 г2 н2с2 м2с2 н4
%т тщу-ся по-гу-би--ти

%з мЭ пТ в=: рТ рТ рТ
%н м2 п2 в4 в2 в2 в2
%т из-ба-вля-я миръ wтъ

%з рТ рТ рТ. мЭ п_/ м=
%н в2 в2 в1п1 м2 п4 м4
%т _е-гw сё-тей ны-нё+.

%з мЭ пТ в=: пТ рТ рТ рТ рТ рТ
