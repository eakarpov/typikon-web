%т _ за-блуждь-шимъ на-ста-вни-че

%з *нЭ+ нб_/: р=\ сК: м/: сК: уД н=\ нуТ:
%н *н2 ц1г1н2 н2н1г1 с2 н1м1 с1 н1г2 н2н1ц1 г1н1
