%Набор Е.Нечипоренко
%Расшифровка Е.Нечипоренко

%код c21Ry3

%з п/: м\? (ЭТ:)_/: п=: мТ. пб_:/ мКчДЗЗп=:
%н м1п1 м1с1 н2с1м1 п4 м1н1 с1м1п2 м2с2м1с1н2м1с1м1п1м1с1н2с1м1п4
%т {П}рi-и-ди-те зе-мнi-и

%з Э: вК: рТ. мК.ч = рЭ+ Э: пК: м/ч
%н м1п1 в2 в1п1 м2с2 н4 н2 с1м1 п2 м1с1
%т со-гла-сно дё-вы бо-го-ро-ди-

%з п/: м\? мт_./ с=? пТ. Э: *м:./ч пЭ
%н м1п1 м1с1 н2м2 с2н2 п1м1 п1в1 *м1в1 п2
%т цу ма-ри-ю во-спо-емъ не-

%з в:/ч м=\ пЗ: пК: пК: мтК.чДЗ =:
%н в1п1 м2м1с1 м1п1м2 п2 п2 м2с2м1с1н2 м2п2в1п1м2п4
%т пре-ста-нно из[|\ъ] не-я-же

%з пТ. пК: мтДЭ мТ. вб_:/ п=. м+
%н п1м1 п2 м1с1н2 м1с1 м1п1в2 п4 м4\
%т хри-ст[а|осъ] _ ра-жда-е-тся.


