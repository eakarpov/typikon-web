%з пА? Э: в=: пТ. Э: вК: рТ. мЭ
%н п1с1 м1п1 в4 п1с1 м1п1 в2 в1п1 м2 
%т Без-на-ча-лна ро-ди-те-ля

%л.54

%з вА рТ рТ рТ. *м=.ч м=\ пЗ:`
%н в2 в2 в2 в1м1 п1*м1в1п1 м2м1с1 м1п1м1с1
%т сынъ бо-г(о) и го-спо-д(е)

%з нЭ м_/ сТ м_/ сТ. Э: пК: мТ. нЭ с=Э нЭ бТ: п=:`
%н н2 м4 с2 м4 с1н1 с1м1 п2 м1с1 н2 с4 н2 с1м1 п4
%т во-пло-щся w\т дё-ви-цы  на-м(о) _я-ви--ся

%з гЭ с_/ рТ. п/: мТ. нЭ Э: п=:`
%н г2 с4 с1н1 м1п1 м1с1 н2 с1м1 п4
%т w-мра-чны-я про-свё-ти-ти

%з рТ. Э: вК: пТ. п/: мТ. нЭ Э: п=:`
%н п1с1 м1п1 в2 п1с1 м1п1 м1с1 н2 с1м1 п4
%т со-би-ра-ти рас-то-че-нны-я

%з р_/ Э: в=: пТ рТ рТ. Э: вК: рТ. мЭ вА рТ. *м=.ч п=. м+
%н п4 м1п1 в4 п2 п2 п1с1 м1п1 в2 в1п1 м2 в2 в1м1 п1*м1в1м1 п4 м4\
%т тёмъ все-хва-лну-ю бо-го-ро-ди-цу ве-ли-ча-е-м[ъ|(о)]

