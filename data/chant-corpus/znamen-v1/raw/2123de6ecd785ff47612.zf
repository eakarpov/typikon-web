%з сА п/: сТ рТ рТ рТ м./ч нЭ с\
%н с2 с1п1 с2 с2 с2 с2 м1с1 н2 с2
%т {Е}-го-же ро-ди-ла _е-си хри-

%з н= сА п/: сТ рТ м./ч нЭ с\
%н н4 с2 с1п1 с2 с2 м1с1 н2 с2
%т ста кра-снё-и-ша из[|\ъ] мер-твы-

%з нт=.\ рЭ н_/ сК: рТ. гЭ н\ с= Э:
%н н4н2г2 г2 н4 с2 с1н1 г2 н2 с4 с1м1
%т х(о) во-сi-я-в(о) чи-ста-я зря-

%з пК: стКч сТ. Э: п=: рТ рТ рТ рТ. Э:
%н п2 с2н2 с1н1 с1м1 п4 п2 п2 п2 п1м1 с1м1
%т щи до-бра-я и не-по-ро-чна-я

%з пК: л\ с= мА рТ. пЗ: (ЭТ:)_/: п=:
%н п2 н1м1 с4 м2 м1с1 м1п1м1с1 н2с1м1 п4
%т в\ъже-на-х(о) и не-тлё-нна-я

%з Э: вК: стКч рЭ мК: рТ. Э: птКч пК:!у
%н м1п1 в2 с2н2 н2 м2 м1н1 с1м1 п2м2 п1
%т д(е)-не-с(е)- спа-се-нi-е  всё-х(о)

%з тДд пК: рТ рТ. сЭ м_/ стКч с= пА мТ
%н м1с2 п2 п2 п1м1 с2 м4 с2н2 с4 п2 м2
%т _ со а-по-сто-лы _е-го ра-ду-

%з сТ. мК: сТ \? мб_/: =\ +
%н с1н1 м2 с2 н1г1 н1с1м2 с4 н4\
%т ю-щи-ся про-сла-ви-м(о).


