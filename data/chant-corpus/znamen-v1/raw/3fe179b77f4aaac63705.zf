%код f1g1
%текст Вто_у'же нл\дю сы\рно_ую. На гд\си во\зва\х.
   стр\ха. гла\с 2. Подо'бе\н w\тдре'ва.
%л.37
%Набор текста Александр Коваленин, знамен Елена Нечипоренко, нот Александр Лукашевич
%Расшифровка Александр Лукашевич

%Примечание Расшифровка БВР

%з А Т Т. Э: К: /: \ = А Э К:
%н п2 п2 п1с1 м1п1 в2 м1п1 м1с1 н4 п2 м2 в2
%т Воз-де-ржа'-нi-е-м(е) тjь'-ло сми-ри'-ти

%з _/ К: Т Т \ = Э: К:
%н п4 в2 в1п1 м2 с2 н4 с1м1 п2
%т в(е)-си` по-тщи'-м(о)-ся[,] бо-же'-

%з Т. /: Ч Т. Э: К: Ч /: =\ =
%н м1с1 м1п1 м1с1 н1г1 н1с1 м2 н1с1 н1г1 н4 г4
%т стве-[|н]но-е по'-при-ще пре-хо-д[_я]'-и

%з Т. Э: К: Т. Э: \ = Т Т. /: Ч
%н с1н1 с1м1 п2 м1с1 н1с1 м2 с2н2 п2 п1м1 п1в1 п1м1
%т не-по-ро'-чна-г[о] по-ста` и= мо-ли'-тва-

%з Э: \ =ч =\ = Э+ Э: К: Т. /:
%н с1м1 п2 м2с2 н4 г4 н2 с1м1 п2 м1с1 м1п1
%т ми и= сле-[s|з]а'-ми го'-спо-да спа-са'-

%з Ч Т Т Т. Э: \ =Э _/ =Э Т К:
%н м1с1 н2 н2 н1г1 н1с1 м2 с2н3г1 г1н1с1 н4 п2 в2
%т ю-ща-го на'-с(о) в(о)-[s|з]ы'-ще-м(о)[,] и= [s|з]а-

%з _/ К: Т Т \ = Т. К: Т
%н п4 в2 в1п1 м2 с2 н4 н1г1 с2 н2
%т бве'-н[и]-е-м(е) [з|s]ло'-бё w=-то-ню'-

%з Т. /: \ _/: =: Т. /: Ч Т. Э: К:
%н н1г1 н1с1 н1г1 н2с1м1 п4 м1с1 м1п1 м1с1 н1г1 н1с1 м2
%т де со-тво-ри'-ми[,] во-пi-ю'-щ[и|е][:] со-грjь-

%з Ч /: =\ = Э: К: Т. /: \ _./ =
%н н1с1 н1г1 н4 г4 с1м1 п2 м1с1 м1п1 м1с1 н2м2 с2н2
%т ши'-хо-м(о) ти`[,] спа-си`[,] jа='-к[о]-же дре'-вле

%з Т. /: Ч Т. Э: \ =Э _/ =Э
%н с1н1 м1п1 м1с1 н1г1 н1с1 м2 с2н3г1 г1н1с1 н4
%т нi-не-[вви|vi]'-т_я-ны хри-сте` ца-рю`,

%з Т К: _/ К: Т Т \ = Т Т Т. /: Ч
%н п2 в2 п4 в2 в1п1 м2 с2 н4 м2 м2 м1с1 м1п1 м1с1
%т и= [w|_о]=-бё'-щ(е)-ни-ки на'-с(о) не-бе'-с(е)-на-г[о]

%з Ч Э Э: =: Т Т Т. _:/ \ +
%н н1г1 н2 с1м1 п4 п2 п2 п1с1 м1п1в2 п4 м4\
%т ца'-р(е)-ств[и]-я со-тво-ри` вла-ды'-ко.

%Разница [поприще преходяи|преходя'ще по'прище]
   [забвенiем злобё|забвенiе sло'бы]
   [wтонюде|всеконе'чное]
   сотворим[и|въ]
   jа='к[о|оже]
   [насъ небеснаго царствия сотвори владыко|ны` сотвори` нб\снагw цр\ствiя бл~гоутро'бне]

