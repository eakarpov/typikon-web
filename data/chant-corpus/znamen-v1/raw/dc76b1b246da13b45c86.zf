%Название Гласъ 1 I=рмосы`
%Архив ГПНТБ СО РАН, F.I.5

%песнь 1
%код i11h
%Расшифровка С.Хохряков

%текст ро\ж хр\сву

%з гЭ+ нТ.ц Э: стЭ!-м пА мТ. мК. сТ \? мб_/: с=`
%н г2 н1ц1 г1н1 с2м2 п2 м1с1 м2 с2 н1г1 н1с1м2 с4
%т {С}па-се лю-ди чю-до-дё-я вла-ды-ко

%з Э: вК: пТ. п\ с=`
%н м1п1 в2 п1м1 п2 с4
%т мо-кру-ю мо-ря

%з гЭ+ нК. гТ. Э: смт_./о нЭ с\ н=.\`
%н г2 н2 г1ц1 г1н1 с2м1с1 н2 с2 н4н2г2
%т во-лну ис-су-ши-в(о) дре-вле

%з рЭ+ н_/ сК. гТ. гТ ц\ *н=`
%н г2 н4 с2 г1ц1 г2 ц2 *н4
%т во-ле-ю же ро-ж(е)-ся

%з сА рТ. пт_:/ сТ рТ рТ м/ч нЭ с\ нХ`
%н с2 с1н1 с2м1п1 с2 с2 с2 м1с1 н2 с2н1 с1н2
%т w-т(о) дё-вы сте-зю про-хо-д(е)-ну

%з гТ. Э: н_/ с/: рТ. гЭ н\ с=.` бТ:
%н г1*н1 ц1г1 н4 н1с1 с1н1 г2 н2 с2 м1п1
%т не-бе-се по-ло-жи на-м(о) _

%з вК: пТ. п/: мТ. нЭ Э: п=:`
%н в2 п1с1 м1п1 м1с1 н2 с1м1 п4
%т _е-го-же по су-ще-ству

%з мТ. Э: вК: пТ. пК. л\ с=`
%н м1с1 м1п1 в2 п1м1 п2 н1м1 с4
%т ра-в(е)-на же _о-т(е)-цу

%з р_/ нТ! рТ! рТ. лЭ:с р/ч =чк ,,/ +
%н с4 н1 н1 н1г1 н1с1 с1н1 н!г!ц1г1ц1 *н4 *г4\
%т и зе-м(е)-ны-(и)-ми сла-ви-ма.

