%з ГнтЭ-н с=. _  нЭ пб,,:/ш р=.\ п=: мЩк с=. р=\
%н г2н2 с4 = н2 н1с1м1п1 п2п1м1 п4 м1с1м2 с4 с2с1н1
%т Дне'--сь    хри-сто'съ вхо'---ди-тъ[,|]

%з тЭ- с=. р=\ _ гтЭ- сК. нЩк мб,,/: сК.  м/: с=. н=
%н г2н2 с4 с2с1н1 = г2н2 с2 н1г1н2 н1с1м2 с2 н1м1 с4 н4
%т во гра'--дъ       ви-_фа'----нi--ю,

%з гтЭ- с=. рК. сб/: н=. г=Э н=. рТ сТ пб_./+ м=. с= р=\
%н г2н2 с4 с2 н1с1 н4 г4 н4 н2 с2 м1п3 м4 с4 с2с1н1
%т на жре-бя-'-ти сё-дя'й[,] без-сло-ве'-сi-е _

%з тЭ- с=. рК. мб,,/:о нЭ сК. н= рТ. мб_./+- сК. м/:  с=. н=
%н г2н2 с4 с2 н1с1м1с1 н2 с2 н4 н1г1 н1м3 с4 н1м1 с4 н4
%т ра-зрё-ша'----я, _я=-зы'къ sлё'й-ше--е[,]

%з нЭ сК. нЩк мб,,/: сТ м/: с=. нЩк б,,/: сТ м/: с=. н+
%н н2 с2 н1г1н2 н1с1м2 с2 н1м1 с4 н1г1н2 н1с1м2 с2 н1м1 с4 н4\
%т дре'----вле сви-рё'-пё--ю-ще--е.

