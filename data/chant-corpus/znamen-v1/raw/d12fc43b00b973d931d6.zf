%код prl2

%з сТ. Э: вК: пТ. пК: л\ с= рТ рТ. Э: птК:ч с= мтК:ч н\? мб_/: =\ =
%н с1н1 м1п1 в2 п1м1 п2 н1м1 с4 с2 с1н1 с1м1 п2м2 с4 м2с2 н1г1 н1с1м2 с4 н4
%т {Н}е'-бо и= зе-мля` _ дне'сь со-во-ку-пи'-ся[,] ро'жд[ь|]-шу-ся ^хри-сту`[:]

%з сА %(цвё\т%)сб_/:оФЗ=: _ _ лК: сТ рТ м:/ч нЭ с\ н=
%н с4 г1н1с1н1с4м2п4м1с1м4с4н2н1г1н1с1 м2 с4 с1п1 с2 с2 м1с1 н2 с2 н4
%т дне'--сь ^бо'гъ на зе'-млю прi-и'--де[,]

%з нТ сТ. Э: п:/ч пК: мТ. нЭ пб=ч =\ = ст_/:- лК: сТ рТ м:/ч нЭ с\ н=
%н н2 с1н1 с1м1 п1м1 п2 м1с1 н2 м1п2м1 с4 н4 г2н2с4 с1п1 с2 с2 м1с1 н2 с2 н4
%т и= че-ло-вё'къ на не-бе-са` взы'-де[:] дне'сь ви'-димъ _е='сть пло'--т[и]-ю

%з сА нЭ сТ. Э: пК: пК:ч рК: рК: мТ. нЭ рЭ+ Э: п/: бД (_./+)п=ч =\ =
%н с2 н2 с1н1 с1м1 п2 п2м2 п2 п2 м1с1 н2 н2 с1м1 м1п1 м!с!н1 м1п2м1 с4 н4
%т и='-же _е=-сте-ство'мъ не-ви'-ди-мы-[й][,] че-ло-вё'-ка ра'--ди[,]

%з сТ. мК: мЗ: гЭ н\ с= бТ: вК: пТ. пК: л\ с= мК:
%н с1н1 м2 с1м1с1н1 г2 н2 с2 м1п1 в2 п1м1 п2 н1м1 с4 м2
%т се-г[о]` ра'-ди и= мы` _ сла-во-сло'-вя-ще во-

%л.95

%з сТ н\? мб_/: =\ =
%н с2 н1г1 н1с1м2 с4 н4
%т зо-пи-[е|и]'мъ _е=-му`[:]

%з нб_/: гТ. н/: гЧ тЭ- с=. рК: лЧ б/: =\ =
%н ц1г1н2 г1ц1 г1н1 г1ц1 г2н2 с4 с2 г1с1 н2 г4 н4
%т сла'-ва в\ъ+вы'-шни[\х|хъ] ^бо'-гу[,] и= на зе-мли` ми'ръ[:]

%з сТ рТ. сб_/:о р=:
%н с2 с1н1 г1н1с1н1 с4
%т да-ро-ва'-ти

%з Э: вК: пТ. пК: л\ с= мК: сТ н\? мб_/: сТ р\ н+
%н м1п1 в2 п1м1 п2 н1м1 с4 м2 с2 н1г1 н1с1м2 с2 с2 н4\
%т при-ше'-ствi-е ^тво-е`[,] ^спа'-се на'шъ[,] сла'-ва ^те-бё`.

%Разница
   совокупи'[|ша]ся
   [и='же|] _е=стество'мъ
   возоп[ие|iи']мъ
   [дарова'ти|дарова` бо]

