%Набор Е.Нечипоренко
%Расшифровка Е.Нечипоренко

%код 212Al1
%текст {Н}а+литi'и {С}тр\хы {Г}ла'съ. 8.

%з с/ч#г нЭ пб_:/ р:/ч сЩк мт_./+шз м/ч нТ. Э:
%н с1г1 н2 с1м1п2 п1м1 с1н1с2 н2м3п1 м1с1 н1г1 н1с1
%т {П}ре-по-до-бне w-тче свя-ти-те-

%з мК: лЧ б/: =\ = пб_:/ нТ. м/: =чк пК: м\? =:
%н м2 н1с1 н1г1 н4 г4 с1м1п2 н1г1 н1м1 с1н1с1м1 п2 м1с1 м2п!в1п1м1в3п1
%т лю а-ле-_кси-е а-ще ка--я стра-на

%з мТ. пб_/ пб_:/ м=ч =\ = нЭ+
%н м1с1 м1п3м1 с1м1п2 м2с!н1м1 г1н3с1 н1г1н4 н2
%т и-ли кiй градъ мо-лчитъ но

%л.212

%з Э: пК: мТ. Э: мК: бДЭ Э: п\ м=ч =\
%н с1м1 п2 м1с1 н1с1 м2 с1н1п1м1 с1м1 п2 м2с!н1м1 г1н3с1
%т миръ и-же то-бо-ю про-свё-ще-

%з = Э: пК: нТ. м/: =чк пК:
%н н1г1н4 с1м1 п2 н1г1 н1м1 с1н1с1м1 п2
%т нный чю-десъ тво-ихъ мно-

%з м\? =: мЭ пК: мТ. пб_/ пб_:/ м=ч =\
%н м1с1 м2п!в1п1м1в3п1 м2 п2 м1с1 м1п3м1 с1м1п2 м2с!н1м1 г1н3с1
%т же-ство слы--ша-ще и ви-дя-

%з = Э: пК: мТ сТ рТ. мК: сТ н\?
%н н1г1н4 с1м1 п2 м2 с2 с1н1 м2 с2 н1г1
%т ще и мы с[|\ъ]ни-ми по-хва-лны-ми

%з мб_:/ сФЗ=: нЭ+ Э: пК: м/: =чк пК:
%н н1с1м2 с2с1н1с1м1п2м!с1м1п2п1в1п2м2м2с!н1г1н1с1м2с!н1с4с2н2г2н1с1н4 н2 с1м1 п2 н1м1 с1н1с1м1 п2
%т пё-сньми во-пи-емъ и гла-го-

%з м\? =: сТ. Э: пК: мТ. нЭ Э: пК:
%н м1с1 м2п!в1п1м1в3п1 с1н1 с1м1 п2 м1с1 н2 с1м1 п2
%т -лемъ бла-го-да-ти-ю пре-свя-

%з пб_/ Э: п\ м=ч =\ = нА %(_еди\н+_е'сть%)ДЗФЗ =: 
%н м1п3м1 с1м1 п2 м2с!н1м1 г1н3с1 н1г1н4 н2 н2г2ц1г1н4г2ц2г2ц2г2ц1*н1ц2*н4ц2*н4 н2н1с1м4с2н2с2м1н1с1м1п4м1с1н2м2с4н1с1м1п1с1м4с2с1м1с2н2н1г!н!с2н2г2н4
%т та--го ду--ха хри-сто-вымъ

%з Э: пК: мТ. нЭ рТ. м/: =чк пК:
%н с1м1 п2 м1с1 н2 н1г1 н1м1 с1н1с1м1 п2
%т а-по-сто-ломъ по-до-бникъ былъ

%з м\? =: мА Э: пК: мТ. нЭ пб_/ Э: п\
%н м1с1 м2п!в1п1м1в3п1 м2 с1м1 п2 м1с1 н2 м1п3м1 с1м1 п2
%т _е-си и все-ле-нну-ю всю про-свё-

%з м=ч =\ = сК. нТ рТ рТ. Э: мК: бДЭ
%н м2с!н1м1 г1н3с1 н1г1н4 с2 н2 н2 н1г1 н1с1 м2 с1н1п1м1
%т ща-е-ши тё-мже и до ца-ря

%з Э: п\ м=ч =\ = нТ рТ. м/: =чк пК:
%н с1м1 п2 м2с!н1м1 г1н3с1 н1г1н4 н2 н1г1 н1м1 с1н1с1м1 п2
%т до-и-до--ша сло-ве-са чю-десъ

%з м\? =: в=.\ рК: пЗ: Х Э: пК: мТ.
%н м1с1 м2п!в1п1м1в3п1 в2в1п1 в2 м1п1м2с!н1 г1н2 с1м1 п2 м1с1
%т тво-ихъ [|_]я-ко лу-ча и да-ль-

%з нЭ мТ п\? пб_/ Э: п\ м=ч =\ =
%н н2 м2 п1с1 м1п3м1 с1м1 п2 м2с!н1м1 г1н3с1 н1г1н4
%т нимъ [|_]я-ко бли-зъ си-я-ю-ща

%з Э: нТ рТ (/ч~Т:)З:ФЗ=: нТ сТ. Э: пК:
%н ц1г1 н2 н2 г1ц1г1н1с2с1н1с1м1п2м!с1м1п2п1в1п2м2м2с!н1г1н1с1м2с!н1с4с2н2г2н1с1н4 н2 с1н1 с1м1 п2
%т и насъ w[|\]т бёдъ и на-хо-дя-

%з м/: =чк пК: м\? =: мТ. пб_/
%н н1м1 с1н1с1м1 п2 м1с1 м2п!в1п1м1в3п1 м1с1 м1п3м1
%т щихъ лютъ сво-бо-ди тво-и-

%л.212о

%з Э: п\ м=ч =\ +
%н с1м1 п2 м2с!н1м1 г1н3с1 н1г1н4\
%т ми мо-ли-тва-ми.

