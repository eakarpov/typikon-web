%код pbx2

%з сТ. мК: сТ н\? м_/: стКч пт_:/
%н с1н1 м2 с2 н1г1 н1с1м2 с2н2 с2м2п4
%т {_W} ди-вно-е чю--дw,

%з м\:к нЭ+ мТ. Э: вК: пТ. Э: *мК% ву=ч мТ. Э: вК:ч
%н м1с1м1с1 н2 м1с1 м1п1 в2 п1м1 п1в1 *м2 п1в2п1 м1с1 м1п1 в2п2
%т и-же w\т не-пло-до-ве плодъ _ во-си-явъ

%з вК: пТ. пК: мл\ с= сТ. Э: пК: мТ сТ.
%н в2 п1м1 п2 н1м1 с4 с1н1 с1м1 п2 м2 с1н1
%т ма-но-ве-ни-емъ всёхъ со-дё-те-ля

%з мК: сТ н\? м_/: с=\ н= мК: сТ рТ. м/:
%н м2 с2 н1г1 н1с1м2 с4 н4 м2 с2 с1г1 н1м1
%т и все-де-ржи-те-ля, до-бле-стве-нw

%з (Т.)сЧ тЭ!- с=. Э: пК: мТ сТ. мтК:ч н\? м_/:
%н с1н1 г2н2 с4 с1м1 п2  м2 с1н1 м2с2 н1г1 н1с1м2
%т ми-рско-е бла-гихъ раз-рё-ши не-пло-

%з с=\ н= мК: сТ рТ. мЗ: гЭ н\ с= Т: пК:
%н с4 н4 м2 с2 с1г1 н1м1с1н1 г2 н2 с2 с1м1 п2
%т дь-ство, ма-те-ри с[|\ъ+]ма-те-ри-ю _ бо-

%з рТ. пК: мТ сТ рТ рТ. мК: сТ н\? м_/: стКч
%н п1м1 п2 м2 с2 с2 с1н1 м2 с2 н1г1 н1с1м2 с2н2
%т го-ро-ди-чно-ю ли-куй-те зо-ву--

%л.18о

%з пт_:/- нЭ+ п_:/ рТ. Э: вК: пТ. пК: л\ с= сТ.
%н с2м2п4 н2 с1м1п2 п1с1 м1п1 в2 п1м1 п2 н1м1 с4 с1н1
%т ще, w-бра-до-ва-нна-я ра-дуй-ся, с[|ъ+]то-

%з в_/:о рК: пТ. п\ с= рТ. Э: пК:?? Э: ву**/ сТ
%н м1п1в1п1 в2 п1м1 п2 с4 с1н1 с1м1 п1с1 м1п1 в!п!м1п1м1 с2
%т бо-ю го-спо-дь, по-да-я-и ми-ро-

%з рТ. Э: пК:ч сТ. мК: сТ н\? м_/: с=\ н+
%н с1н1 с1м1 п2м2 с1н1 м2 с2 н1г1 н1с1м2 с4 н4\
%т ви то-бо-ю ве-ли-ю ми--лость.

