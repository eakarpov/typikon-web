%код dlg2

%з стЧ. Э: нК. пб_:/ рТ.
%н с2н1г1 ц1г1 н2 с1м1п2 п1м1
%т {И}-же сво-е-ю

%з в/: пК: рТ. сЩк н= сТ. Э: п_/ мТ рТ рТ рТ.
%н п1в1 п2 п1м1 с1н1с2 н4 с1н1 с1м1 п4 м2 м2 м2 м1с1
%т кро-вi-ю спа-се че-ло-вё-ки и-ску-пи-

%з нЭ Э: м_/ Э: стЧ. Э: нК. рТ Э: пК: рТ
%н н2 н1с1 м4 г1н1 с2н1г1 ц1г1 н2 н2 с1м1 п2 п2
%т лъ _е-си и сме-ртi-ю си w\т сме-рти

%з рТ рТ рТ рТ рТ. вЗ: сТ. с\ н= Э: п_/ мТ. нЭ
%н п2 п2 п2 п2 п1м1 п1в1п1м1 с1н1 с2 н4 с1м1 п4 м1с1 н2
%т го-ркi-я и-зба-вле--и насъ и жизнь вё--

%з Э: м_/ рТ. Э: вК: пЗ: нТ. Э: мК: лЧ б/: н=\
%н н1с1 м4 м1с1 м1п1 в2 м1п1м1с1 н1г1 н1с1 м2 н1с1 н1г1 н4
%т чну-ю по-да-я-и во-скре-се-нi-емъ си

%з #г= вб,,:/ пб=ч сТ. Э: пК:ч с\ н= Э: с_/
%н г4 м1п1в2 м1п2м1 с1н1 с1м1 п2м2 с2 н4 г1н1 с4
%т _ вся _ по-кои го-спо-ди о_у-сопъ-

%з рТ рТ рТ. Э: мК:ч н= пА рТ мТ. вб,,:/ пб=ч
%н с2 с2 с1г1 н1с1 м2с2 н4 п2 п2 м1с1 м1п1в2 м1п2м1
%т шi-я бла-го-че-стно и-ли впу-сты-няхъ

%з сТ. Э: пК:ч с\ н= рТ. Э: м_/ сТ рТ. Э:
%н с1н1 с1м1 п2м2 с2 н4 н1г1 н1с1 м4 с2 с1г1 н1с1
%т и-ли во гра-дёхъ и-ли вмо-рихъ и-ли

%з мК: с\ н= сТ рТ. Э: п_/ мТ рТ. нЭ бТ: м_/
%н м2 с2 н4 с2 с1н1 с1м1 п4 м2 м1с1 н2 н1с1 м4
%т на зе-мли и-ли на вся-комъ мё---сте

%з Э: пК: рТ рТ рТ. пК: мТ. нЭ Э: пК: мТ. нЭ
%н с1м1 п2 п2 п2 п1м1 п2 м1с1 н2 с1м1 п2 м1с1 н2
%т ца-ри же и свя-ти-те-ли и пе-рво-свя-

%з пб=ч пб_/:о п=: *мб,,:./ вб=ч вК: рТ. мТ с\ н= пб_:/
%н м1п2м1 с1м1п1м1 п4 п1в1*м2 п1в2п1 в2 в1п1 м2 с2 н4 с1м1п2
%т ще-нни-цы и--но-ки и бёль-цы вво-

%з мК: сТ. пб_:/ м\? пт_/: мТ. Э: пК:ч с\ н=
%н м2 с1н1 с1м1п2 м2 с2м2п4 м1н1 с1м1 п2м2 с2 н4
%т зра-стё вся--цёмъ и спо-до-би насъ

%з сТ. пб_:/ мТ. нЭ пб_:/ мТ рТ сТ. гЭ н+
%н с1н1 с1м1п2 м1с1 н2 с1м1п2 м2 м2 с1н1 г2 н4\
%т не-бе-сна-го царь-ствi-я тво-е-го.

