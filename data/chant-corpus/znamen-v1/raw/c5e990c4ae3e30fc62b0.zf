%код i590

%л.129о

%текст Всубо\т напаве\ч. I=вн\длю напо\л. I=нао_у\т.

%з нЭ+ м_/ Э: вК: рТ. тЭ!- в=: *пК%
%н н2 м4 м1п1 в2 в1п1 м2п2 в4 *п2
%т И-са-i-я ли-ку-й дё-

%з *м%/ч пЭ в=: Э: вК: рЗ: =\ =
%н *м1в1 п2 в4 м1п1 в2 м1в1п2 м4 п4
%т ва-я бо и-мё во-чре-вё

%з мТ рТ. Э: п=: рТ. Э: вК: мТ. мК:
%н м2 м1н1 с1м1 п4 п1с1 м1п1 в2 м1с1 м2
%т и по-ро-ди сы-на _е-мма-ну-

%л.130

%з с\ н= м_/ Э: вК: рТ пЭ! вТ! *мК%
%н с2 н4 м4 м1п1 в2 в2 п1 в1 *м2 
%т и-ла бо-га же и че-ло-вё-

%з в=: мЭ п_/ сКч сТ м\ п=: мЭ
%н в4 м2 п4 с2н2 с2 м2 п4 м2
%т ка во-стокъ и-мя _Е-му _е

%з п_/ Э: вК: рТ. мК: с\ н= бТ: вК:
%н п4 м1п1 в2 в1п1 м2 с2 н2 м1п1 в4
%т го-же ве-ли-ча-ю-ще _ те-

%з рК: п_/ мТ рТ. нЭ с_/ мК.ч н+
%н в2 п4 м2 м1с1 н2 с4 м2с2 н4\
%т бе дё-во о_у-бла-жа--емъ.

