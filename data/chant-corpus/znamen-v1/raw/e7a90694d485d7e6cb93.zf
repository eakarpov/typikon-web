%Название Гласъ 1 I=рмосы`
%Архив ГПНТБ СО РАН, F.I.5

%песнь 1
%код i18z
%Расшифровка С.Хохряков
%текст [|вн\длю фоми\н]

%з гЭ+ сК. рТ. Э: пК: л\ с=`
%н г2 с2 с1н1 с1м1 п2 н1м1 с4
%т {В}(о) пла-ме-ни _о-гне-нё

%з Э: вК: пТ. пК: л\ с=`
%н м1п1 в2 п1м1 п2 н1м1 с4
%т го-ря-щi-я пе-щи

%з нЭ сТ. Э: п_/о сЭ м\ с=`
%н н2 с1н1 с1м1 п2п1м1 с2 м2 с4
%т со-хра-н(е)-ша-го дё-ти

%з гЭ сК: нЭ сК. рТ. Э: п_/ мтДЭ Э: пК: рТ рТ рТ. мтКч н=` бТ:
%н г2 с2 н2 с2 с1н1 с1м1 п4 м1с1н2 с1м1 п2 п2 п2 п1с1 м2с2 н2 с1м1
%т и во _о-бра-зё а-нге-ла со-ше-д(о)-ша к(о) ни-м(о) _

%з пК. л\ с= бТ: мК: с\ н=` бТ:
%н п2 н1м1 с2 н1с1 м2 с2 н2 с1м1
%т по-и-те _ го-спо-да _

%з пК: рТ. стКч мК. с\ н=` бТ: п/ч пК: мтТ:? =\ +
%н п2 п1м1 с2н2 м2 с2 н2 с1м1 п1м1 п2 с1м1н1 с4 н4\
%т и пре-воз-но-си-те _ _е-го во вё-ки.

