%код pcv1
%текст }В\ъНЛ\дЮ ЦВЁТНУ'Ю Ве\ч НА'Г~И Во\з.
 С{тр\хы. }Г{ла\с 8.

%з нЭ+ Э: пК: рТ рТ Э: вК: пЗ:
%н н2 с1м1 п2  п2 п2 м1п1 в2 м1п1м1.с!н1
%т {Р}а'-ду-[й]ся и= ве-се-ли'--

%л.39

%з Х мб,,/: лЧ б/: н=\ #г=     нЭ+ пб_:/ рТ. Э: вК: пЗ: Х сТ. Э: мК: сЗ: н=\ #г=
%н г1н2 н1с1м2 н1с1 н1г1 н4 г4 н2 с1м1п2 п1с1 м1п1 в2 м1п1м1.с!н1 г1н2 с1г1 н1с1 м2 н1с1н1г1 н4 г4
%т ся гра'-де сi-w'-не,        кра-су'-[й]ся и= ра'-ду-[й]ся це-ркв[и|е] бо--жi-я:

%з пб_:/ мТ. мт_./ с=ч Э: пК: мТ р:/ч бТ: м\ с=ч
%н с1м1п2 м1с1 н2м2 с2н2 с1м1 п2 м2 м1с1 н1с1 м2 с2н2
%т се' бо царь тво'[й] прi-и'-де пра'--вдо-ю,

%з нЭ+ Э: *мт_:/ ву**/ лЧ б/: н=\ #г= нЭ+ Э: п_/ мЩк
%н н2 с1м1 п2в1*м1 в!п!м1п2 н1с1 н1г1 н4 г4 н2 с1мм1 п4 м1с1м2
%т на жре-бя'--ти сjь-дя` _  w\т дjь-те'-[й]

%з лЧ б/: н=\ #г= нА З:Ф =:
%н н1с1 н1г1 н4 г4 н2 г1ц1г1н1 с2с1н1с1м1п2м!с1м1п2п1в1п2м2м2с!н1г1н1с1м2с!н1с4
%т во-схва-ля'-ем[ъ|ь] [_о|w]=-са'-нна _

%з _ бТ: в=: нТ мТ. сЭ: п\ =ч =\ =
%н с2н2г2н1с1н2 м1п1 в4 н2 м1н1 с1м1 п2 м1.с!н1м1 г1н2с1 н1г1н4
%т _ _ в\ъ+вы'-шнихъ, бла-го-сло-ве'нъ _е=-си`,

%з Э: пК: мТ. Э: в=: пК: мТ. Э: м=\    Э: мК: сЗ: н=\ #г+
%н с1м1 п2 м1с1 м1п1 в4 п2 м1с1 н1с1 м2м1с1 н1с1 м2 н1с1н1г1 н4 г8\
%т и=-мjь'-я-[й] мно'-же-ство ще-дро'тъ, по-ми'--лу[й] на'съ.

