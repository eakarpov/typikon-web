%код dbx1

%текст Недёля блуднаго, на хв\ха, гла\с [6|2]

%з сА нТ рТ. мт_./ рт=.\ Э: мК: (=.ч)Щ Э: м\ с=Э сб_/ н=Э
%н с2 н2 н1г1 н2м2 м2с4н2н1г1н1с4н4 н1с1 м2 н1с1н1г1 н1с1 м2 с2н2г1 г1н1с1 н4
%т Блу'-дна-г[о] гла'-са при-но-шу' _ ти[,] го'-спо-ди[:]

%з сЭ:л р./ч #г\ цХ сТ. Э: пК:шз мЧ Э: мК: лЧ б/: н=\ #г=
%н г1с1 с1н1 г2ц1 ц1*н2 с1н1 с1м1 п2 м1с1 н1с1 м2 н1с1 н1г1 н4 г4
%т со-грё-ши'-хъ предъ _о=-чи'-ма тво-и'-ма бла-г*и'-й[,]

%з рЭ нТ. сК.шз н\? б_/: п=: рК: рТ. вЗ: Э: п\ м=ч н=\ #г=
%н г2 н1г1 н1с1 н1г1 н2с1м1 п4 п2 п1м1 п1в1п1м1 с1м1 п2 м2с2 н4 г4
%т ра-сто-чи'хъ бо-га'т[ь|]-ство да-ро-ва'--н*и-[й] тво-и'хъ[.]

%з нЭ+ сТ. Э: пК: мЧ пЗ: Э: м\ с=ч пб_:/ сК.ч мК:? нЧ нт/: с=\ н+
%н н2 с1н1 с1м1 п2 м1с1 м1п1м1с1 н1с1 м2 с2н2 с1м1п2 с2н2 м2 н1г1 н2г1 г1н1с1 н4\
%т но пр*и-и-ми' мя ка'-ю-ща-ся бо'-же[,] и= по-ми'-луй мя.

%Разница [гласа приношу|гла'съ приноша'ю]
   [дарованiй твоихъ|твои'хъ дарова'нiй]
   [боже и помилуй мя|сп~се, и= сп~си' мя]

