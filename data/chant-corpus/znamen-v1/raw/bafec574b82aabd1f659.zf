%код 102sgc
%Название Прп\дбному _о=ц~у нш~ему серафi'му саро'вскому
   На гд\си во\з, Сла'ва, Гла\с 8:
%Источник Распев иеродиакона Павла (Коротких), 2006 г.

%з пА Э: вК: пЗ: Х мб_/: лЧ б/: =\ =
%н п2 м1п1 в2 м1п1м1.с!н1 г1н2 н1с1м2 н1с1 н1г1 н4 г4
%т Прi- и- ди'-- те, вё'-рныхъ со-бо'-ри,

%з Э: пК: п/: м\ мб_/: с=ч нЩкс м/: с=ч пК:
%н с1м1 п2 м1п1 м1с1 н1с1м2 с2н2 н1г1с2 н1м1 с1н1с1м1 п2
%т по-хва'-льны-ми пё'-сньми дне'сь пре-чу'-

%з м\? вт=: мТ. п_/? Э: п\ =ч =\ =
%н м1с1 м1.п!в1п1м1в2п1 м1с1 м1п2м1 с1м1 п2 м1.с!н1м1 г1н2с1 н1г1н4
%т дна'-го _о=-тца` _ про-сла'-- вимъ

%з вК: п_/ рТ. Э: вК: рТ. мТ с\ н= нЭ+ Э:
%н в2 п4 п1с1 м1п1 в2 в1п1 м2 с2 н4 н2 с1м1
%т и= си'-це _е=-му` во- зо- пi'- имъ: пре- по-

%з пК: пЗ: Э: мК: лЧ б/: =\ = Э: п_./о м=\
%н п2 м1п1м1с1 н1с1 м2 н1с1 н1г1 н4 г4 с1м1 п3с1 м3с1
%т до'-бне _о='-тче се-ра-фi'-ме, во-и'-сти-

%з мЗ:с   рДЗ    З        мК: сТ. сб_./+ =\ =
%н н1м1с2 с1н1г2н1г1н1с1 н1с1м1п1 м2 с1н1 г1с2 н1г1н4 г2н1с1н4
%т нну    спо-   до'-- би-лся _е=-си`

%з _/: *мт_:/ в**/ лЧс б/: =\ = Э: пК:             м/: с=ч пК:
%н н2с1м1 п2в1*м1 в!п!м1п2 н1с1 н1г1 н4 г4 с1м1 п2 н1м1 с1н1с1м1 п2
%т бо-же'-стве-нны-я жи'-зни, прi-и'мъ             w\т бо'- га

%з м\? вт=: мТ. п_/? Э: п\ =ч                          =\ =
%н м1с1 м1.п!в1п1м1в2п1 м1с1 м1п2м1 с1м1 п2 м1.с!н1м1  г1н2с1 н1г1н4
%т вё- не'цъ не- тлё'- нны- я сла'-                    -вы.

%з Э: нК: рДЗ ФЗ=:
%н ц1г1 н2 н2г2 ц1г1н4 г2ц2 г2ц2 г2 ц1*н1 ц2 *н4 ц2 *н4 н2 н1с1м4 с2н2 с2
%т се- гw` ра'------                      ----ди _ _ _ _ _

%н м1н1 с1м1п4 м1с1н2 м2 с4 н1с1м1п1 с1м4 с2 с1м1 с2н2 н1 г!н!с1 н2г2 н4

%з Э: пК: нТ. м/: с=ч пК: м\? вт=: мТ. п_/? Э: п\
%н с1м1 п2 н1г1 н1м1 с1н1с1м1 п2 м1с1 м1.п!в1п1м1в2п1 м1с1 м1п2м1 с1м1 п2
%т _о=- би'- тель са- ро'-- вска- я                   то- бо'-- ю

%з =ч =\ = нб_:/ рТ сТ:л нТ! нб_/? Э: н\:
%н м1.с!н1м1 г1н2с1 н1г1н4 ц1г1н2 н2 г1с1 н1 г1н1.г! ц1г1 н4
%т хва'- ли- тся, лю'- дi- е              же, зря'-- ще

%з Э: мК: р\ с,,/к Э: м\ с,,/к =\ = нЭ+ сТ. Э: п_/ мтДЭ
%н н1с1 м2 м2 с1н1с2 н1с1 м2 с1н1с2 н4 г4 н2 с1н1 с1м1 п4 м1с1н2
%т че- стну'- ю ра'- ку мо-  ще'й тво- их'ъ и= чу- де- са` _

%з Э: п_./о мК: с\ н= бТ: в=.\ пЗ: Х нТ. м/:
%н с1м1 п3с1 м2 с2 н2 м1п1 в3п1 м1п1м1.с!н1 г1н4 н1г1 н1м1
%т бы- ва'-  _е- ма- я _, сла'-- вятъ            про- сла-

%з с=ч пК: м\? п_/? пб_:/ =ч =\ = пб_./+ в=.\ вК:
%н с1н1с1м1 п2 м1с1 м1п2м1 с1м1п2 м1.с!н1м1 г1н2с1 н1г1н4 н1п2 в3п1 в2
%т вля'-    ю- ща- го тя` го'- спо- да: _е=- му` же

%з рТ. мКч н= в/: п\? *мт_:/ДЗЗ =:
%н в1п1 м2с2 н4 п1в1 п1м1 п2в2*м3в1п1*м1в2п2м1с1н2 м2п2в2п2п1*м1в4п4
%т мо- ли'- ся пре- по- до'-  бне

%з нЭ+ Э: п_/ мтДЭ м/: с=ч пК: м\? вт=: пб_:/
%н н2 с1м1 п4 м1с1н2 н1м1 с1н1с1м1 п2 м1с1 м1.п!в1п1м1в2п1 с1м1п2
%т да- ро- ва'- ти ду- ша'мъ на'-- шымъ ми'ръ

%з мТ. п_/? Э: п\ =ч =\ +
%н м1с1 м1п2м1 с1м1 п2 м1.с!н1м1 г1н2с1 н1г1н4\
%т и= ве'- лi- ю ми'-- лость.

