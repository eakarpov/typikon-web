%Название Гласъ 1 I=рмосы`
%Архив ГПНТБ СО РАН, F.I.5

%песнь 1
%код i45w
%Расшифровка С.Хохряков

%з гЭ+ сК. нЭ сТ. Э: пК: мТ с\? мб_/: с=` бТ:
%н г2 с2 н2 с1н1 с1м1 п2 м2 с1г1 н1с1м2 с2 м1п1
%т {W}-т(о) свё-та w-т(о)-г(о)-на-вы-и _

%з вК: пК. мТ рТ рТ. пт_./+ рК: м\? м=`
%н в2 п2 м2 м2 м1с1 м2п2 п2 м1с1 м4
%т пер-во-ро-д(е)-на-г[о|w] па-гу-бу

%з рТ рТ. Э: вК: пТ. пК: мТ. Э: пК: мТ. Э: пК: см_/чк`
%н м2 м1с1 м1п1 в2 п1м1 п2 м1н1 с1м1 п2 м1н1 с1м1 п2 с2н2м4
%т _я-к[о|w] во свё-те дё-ла по-ю-т(е) тя хри-сте

%з сТ. мК: с\ н=` сТ рТ. Э: мК: с\ н=`
%н с1н1 м2 с2 н4 с2 с1г1 н1с1 м2 с2 н4
%т со-дё-те-ля во свё-тё тво-е-м(е)

%з Э: п_/ мЭ пК: мтКч мт\ с+
%н с1м1 п4 м2 п2 м2с2 м4 с4\
%т пу-ти на-ша на-пра-ви.

