%код vlt2
%л.56

%текст }П{овы'ходё пое'мъ.

%з мТ. п/: мТ. мт_./ ст=ч` нТ.
%н м1с1 м1п1 м1с1 н2м2 с2н2 н1г1
%т {С}вя-ты-я сла-вы без-

%з с=.чк нЭ бТ: п=:` рТ. вЗ:
%н н1с1н1г1 н2 с1м1 п4 п1м1 п1в1п1м1
%т сме-ртна--го wт-ца

%з пб_:/ м=ч =\ =` вб,,:/ п_/ вК:
%н с1м1п2 м2с2 н4 г4 м1п1в2 п4 в2
%т не-бе-сна-го свя-та-го

%з рТ. мТ с\ н=` Э: *мК:.ч пЭ
%н в1п1 м2 с2 н4 п1в1 *м1в1 п2
%т бла-же-нна-го и-су-са

%з в:/ч мр=\ пЗ:` мб,,/: (Т.)Ч т/:- =\
%н в1п1 м3с1 м1п1м1с1 н1с1м2 н1г1 н2г1 г1н1с1
%т хри-ста _ сы-на бо-жi-

%з =` нТ. с=.чк нЭ бТ: п=:` вб,,:/ пДЭч
%н н4 н1г1 н1с1н1г1 н2 с1м1 п4 м1п1в2 п1м1с1н1
%т я при-ше-дша--го на _

%з Э: п\ м=ч =\ =` пЗ: мт_./
%н с1м1 п2 м2с2 н4 г4 м1п1м1с1 н2м2
%т за-падъ со--лнцу ви-дё-

%з ст=ч` мб,,/: сТ. сб_./+- нТ. н_/ гЭ
%н с2н2 н1с1м2 с1н1 н1с4 н1г1 н4 г2
%т вше свётъ ве-че-рнi--и

%з с/: н=` Э: пК: мТ. п/: мТ.
%н н1с1 н4 с1м1 п2 м1с1 м1п1 м1с1
%т _ _ по-_емъ wт-ца и

%з нЭ бТ: п=:` Э: вК: п_/ Э:
%н н2 с1м1 п4 м1п1 в2 п4 м1п1
%т сы--на и свя-та-го

%л.57

%з вК: рТ. мК.ч н=` Э: мК: лЧ
%н в2 в1п1 м2с2 н4 н1с1 м2 н1с1
%т ду-ха бо-га до-сто-инъ

%з б/: =\ =` Э: *м:./ч пЭ в:/ч
%н н1г1 н4 г4 п1в1 *м1в1 п2 в1п1
%т _е-си _ во вся вре-ме-

%з мр=\ пЗ: нЭ бТ: п=:` в/:
%н м3с1 м1п1м1с1 н2 с1м1 п4 п1в1
%т на пётъ бы--ти гла-

%з пТ. Э: п\ м=ч =\ =` мб,,/:
%н п1м1 с1м1 п2 м2с2 н4 г4 н1с1м2
%т сы пре-по-до-бны-ми сы-

%з (Т.)Ч т/:- =\ =` мТ. п/:
%н н1г1 н2г1 г1н1с1 н4 м1с1 м1п1
%т не бо-жi-и жи-вотъ

%з мТ. нЭ бТ: п=:` пб_:/ м=ч =\
%н м1с1 н2 с1м1 п4 с1м1п2 м2с2 н4
%т да-я--и все-му ми-

%з =` мТ. п/: мТ. нЭ бТ: п=:`
%н г4 м1с1 м1п1 м1с1 н2 с1м1 п4
%т ру _е-го-же ра--ди

%з р_/ мТ. вб,,:/ п_/ м+
%н п4 м1с1 м1п1в2 п4 м8\
%т весь миръ сла-витъ тя.

