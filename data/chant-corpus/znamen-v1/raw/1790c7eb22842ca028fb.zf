%код u6a
%Набор Михаил Ясько (текст, ноты), Е.Ю.Нечипоренко (крюки)
%Источник Обиход крюковой XIX в.
%Архив ГПНТБ, F.III.10

%з гЭ рЭ нТ рТ рТ рТ рТ р_/ с=: рК. рК. н=
%н г2 г2 н2 н2 н2 н2 н2 н4 с4 с2 с2 н4
%т А=л- ли- лу'- i-а[,] а=л- ли- лу'- - i- а[,]

%л.100

%з нт_./+ мб,,/: рК:ч нЭ м/: с_/ рТ. сК.
%н г2н2 н1с1м2 м2с2 н2 с1м1 с4 с1н1 с2
%т сла'- - - ва _ те- бё` 

%з н= рК.б с_/:- рК. мб,,/:- рК:ч н= стДЭ ст_./+-
%н н4 н2 г1н1с4 с2 н1с1м4 м2с2 н4 с1н1г2 н2с4
%т бо'-

%з сК. мК:ч м:/ч н= гЭ сб_./+- нКч н+
%н с2  м2с2 м1с1 н4 г2 н1с4 н2г2 н8\
%т же[.]

