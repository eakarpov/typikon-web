%т с[у|о]-по-ста'-тныхъ по-га^-нъ де-ржа'-вно-ю си'-

%з мт_./ ст=ч гЭ сК. Э: м\ рт=ч =\ +
%н н2м2 с2н2 г2 с2 н1с1 м2 м1с2м1 н2г2 н4\
%т ло-ю[|,] то-я` _ мо-ли'-тва-ми.

%Разница [о_у=краси`|о_у=краси`въ]
