%Название Покро'ву. На лiтiи`. Сла'ва: и= ны'нё: гла\с 2.

%з нЭ бТ-- п=: Э: вК: рТ- мТ с\ н= Э: сК. нТ- Э: мК:
%н н2 с1м1 п4 м1п1 в2 в1п1 м2 с2 н4 г1н1 с2 н1г1 н1с1 м2
%т Смы'--слъ w=-чи'-сти-вше и= о_у='[\м|мъ][|,] со а='-нге-лы и=

%з с=.чк Э: м\ ст=Э _/ =Э п=\ вЗ: Э: п\ =ч =\ =
%н н1с1н1г1 н1с1 м2 с2н3г1 г1н1с1 н4 п2п1м1 п1в1п1м1 с1м1 п2 м2с2 н4 г4
%т мы` то-рже-ству'--емъ[|,] свё'-тл[о] на-чи-на'-ю-щи

%з Э: пК: пЗ: Э: м\ ст=ч нЭ сТ- Э: пК: п/: мЧ мт_./ ст=ч
%н с1м1 п2 м1п1м1с1 н1с1 м2 с2н2 н2 с1н1 с1м1 п2 м1п1 м1с1 н2м2 с2н2
%т да-вы'--дску-ю пё'снь _о=-тро-ко-ви'-цё[|,] не-вё'-стё

%з нТ- Э: м\ рт=.\ нТ. сК. м/: сКч стТ-- ср_/? Э: н\:
%н н1г1 н1с1 м2 м2с4н2н1г1н1с4н4 н1г1 с2 н1м1 с2н2 с1н1г1 с3н1 ц1г1 н4
%т всё'-хъ ца-ря` хри-ста` бо'-га _ на'-ше-г[о][|,]

%з сТ- Э: пК: сКч стТ-- ср_/ Э: н\: мТ- пЗ: мб,,/: лЧ
%н с1н1 с1м1 п2 с2н2 с1н1г1 с3н1 ц1г1 н4 м1с1 м1п1м1с1 н1с1м2 н1с1
%т вос-кре-сн[и]`[|,] _ го'--спо-ди[|,] гла-го'-лю-ще[|,]

%з б/: =\ = пК: п/: м\? тЭ!- м_/ рЭ п:/ч бТ-- *м%/ч пЭ в:/ч м=\
%н н1г1 н4 г4 п2 м1п1 м1с1 н2с2 м4 м2 п1м1 п1в1 *м1в1 п2 в1п1 м2м1с1
%т в[|\ъ+]по-ко'й тво'й[|,] ты`[|,] и= кi-[|в]w'-тъ свя-ты'--ни тво-е-я`[:]

%з пЗ: нЭ Э: пК: рК: рК: Э: вК: п=\ тЭ- пК: вутДЭ пК:
%н м1п1м1с1 н2 с1м1 п2 п2 п2 м1п1 в2 п2п1м1 с2м2 п2 в1п1м2 п2
%т _ _я='-к[о] бо п[о|а]-ла'--ту кра--сну`---

%поле <Фита>пК:~бДЗФЗ=:</Фита><текст>красна

%з вб,,:/- сТ- пб_:/? мК: с\ н= Э: пК: руДЭ! м_/ тЭ!- пК:
%н м1п1в4 с1н1 с1м1п1с1 м2 с2 н4 с1м1 п2 п!м!с1 м4 с2м2 п2
%т -сi-ю` о_у=-кра-си`[|въ] и= при-чте` _ _ _

%з муДЭ! мТ- пб_./+шз пК: м_/ рК: м/: сКч сб_/: н= сК. Д мб,,/:-
%н м!с!н1 м1с1 м1п2в1 п2 м4 м2 с1м1 с2н2 г1н1с2 н4 с2 н1г1 н1с1м4
%т _ _ _ _ _ _ _ _ _ ю=` _ _ _

%з с=\ сКч м/: сК.- н= гЭ с/: н= пб_/: рТ рТ рТ лТ--
%н с2с1н1 с2н2 н1м1 с4 н4 г2 н1с1 н4 с1м1п2 п2 п2 п2 м1в1
%т _ _ _ _ _ _ _ _ гра'-ду тво-е-му`[,]

%з пТ! пб_/? Э: п\: пб_:/ мТ рТ рТ- п/: мТ- мт_./ ст=ч гЭ
%н п1 м1п1м1 с1м1 п4 с1м1п2 м2 м2 м1с1 м1п1 м1с1 н2м2 с2н2 г2
%т вла-ды'--ко[,] стро'-и-ти и= по-кры-ва'-ти [w=т|w\т]

%з нТ- Э: мК: лЧ б/: =\ = Э: пК: мТ рТ- пЗ:
