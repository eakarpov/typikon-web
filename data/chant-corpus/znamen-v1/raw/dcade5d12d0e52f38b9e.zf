%код a01pkd

%Название Покро'въ. К{онда'\к, гла\с 3.
%Набор Е.Ю.Нечипоренко
%л.91

%з в=: вЗ: Э: в\ п_/ рТ. Э: вК: пК: р:/ч тЭ!- пК:
%н в4 п1в1п1с1 м1п1 в2 п4 п1с1 м1п1 в2 п2 п1м1 с2м2 п2
%т Дё'--ва-я дне'сь пред\ъ-сто-и'тъ в\ъ+це---ркви

%з втДЭ пК: вб,,:/- пТ. вЗ: Э: в\ п=. Э: *пК% *мК%
%н в1п1м2 п2 м1п1в4 п1м1 п1в1п1с1 м1п1 в2 п4 в1*м1 *п2 *м2
%т _ _ _ и= с[|\ъ+]ли'-ки свя-ты'хъ не-ви-ди-

%з вТ р_/ рТ. Э: *м\ в=чк =\ = в=: вЗ: с= пТ. Э:
%н в2 в4 в1м1 п1в1 *м2 в1п1в2 п2м2 п4 в4 п1в1п1м1 с4 п1с1 м1п1
%т м[о] бо'-гу за ны` мо'-ли-тся[:] а='-нге-ли со свя-

%з вК: рТ. пб=ч в/: п\? пб=ч м,,/к с= пТ. Э: в=: п=Э
%н в2 в1п1 м1п2м1 п1в1 п1м1 с1м1п2 м1с1м2 с4 п1с1 м1п1 в4 п4
%т ти'-те-ли по-кла-ня'-ю-тся[,] и= а=-по'-сто-

%з ву**/? пТ. Э: вК: пб=ч в/: п\? пб=ч м_/к с= в/: п\?
%н в!п!м1п2 п1с1 м1п1 в2 м1п2м1 п1в1 п1м1 с1м1п2 м1с1м2 с4 п1в1 п1м1
%т ли со про-р[о]'-ки ли-ков[ь]-ству'--ютъ[:] на'съ бо

%з вбЭЭ\ р=ч сТ. Э: пК: Э: вК: пК: Дк тЭ!- пК: вДЭ
%н с1м1п1в1 в1п4 с1н1 с1м1 п2 м1п1 в2 п2 п1м1 с2м2 п2 в1п1м2
%т ра'-ди бо-го-ро'-ди-ца мо'---ли--

%з пК: вб,,:/- Э: пК: в:/ч пб=ч в/: п\? пб=ч м_/к +
%н п2 м1п1в4 с1м1 п2 в1п1 м1п2м1 п1в1 п1м1 с1м1п2 м1с1м2 с4\
%т -тъ хри-ста` пре-вё'-чна-го бо'--га.

%Разница
[Дё'вая|Дё'ва]
[бг~у за ны` мо'лится|за ны` мо'лится бг~у]
[со святи'тели |со а=рхiере'и]
[и= а=по'столи|а=п\сли же]
[богоро'дица мо'литъ|мо'литъ бц\да]
[христа` превё'чнагw бо'га|превё'чнагw бг~а]

