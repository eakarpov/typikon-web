%Название Ст*ихи'ра 2, гла'съ 2:
%Источник Октоих. Синодальное издание, 1899.
%Набор Е.Ю.Нечипоренко

%н м1п1м1с1н2с1м1 п4 с1м1 п2м2с2м1с1н2м1с1м1п1м1с1н2с1н1г2 н2с2н3м1с4н4
%т Съ+м_и'-ры при-ше'д-шымъ,

%н н2 н2 н1г1 н1м1с1н1г1ц1г1н1 с2 н4 г1ц1г1н1 н1с3н1г1н4г2н1с1н4
%т _я=`-же с\ъ+ма-рй'-е-ю же-на'мъ,

%н г1н1 с2 н2 н1г1 н1с1 м4 с2 н3г1с3н1с2н2г1н1с2 н4с2н1г1н1с1м4
%т и= не-до-у-мё-ва'-ю-щым-ся,

%н с3н1с2н3м1с4н4г2н1с1н4 н1с1м4 м1с1 м1п1м1с1н1с1 м2 м2с4н3г1н1с4н4
%т _                      ка'-к*о     бу'-детъ        и=`мъ

%н н1г1 н1с1 м2н1с1н1г1 н1с1 м2 с2н2г1 г1н1с1 н4 н1г1 с2 н1с1
%т о_у=-лу-чи'-ти же-ла'-н*и-е,                  _я=-ви'-ся

%н м3с1н2с1н1г2 н2с2н3м1с4н4 с2м2п2м1п1с2н2г1н1с2н2г2н2с2н1м1с2н2г4н2с2н4
%т ка'-мень взя'-

%н н2г2н2г1с1с1н1г1с1с1н1г2 н2г1ц1г2ц4г2ц4 н1г1 с2 н2 н1г1 н1с1н1г1
%т -                        тый, бо-же'с-твен-ный ю='-

%н н2с1м1 п4 м2 м1с1 м1п1м1с1 н2м1п1 в1м1 п1*м1в1п1 м3с1 м1п1м1с1 н1с1
%т но-ша     о_у=-то-ля'-яй мя-те'жъ ду'шъ и='хъ: во-

%н м3с1 м1п1м1с1 н1г1 н2м2с1г1н1с1м2м1.с!н1м1с1н1г2ц1г1н1с1н2с2н1с1м1п1м2с1м1п1м1п2
%т ста` бо       гла- го'-

%н м1с!м!п2п1в1п2м4м2н1м1с2н2г1н1с2 н4с2н1г1н1с1м4с2с1н1с2н2н1м1с4н4г2н1с1н4
%т _                                летъ,

%н с1м1 п2 м2с2 н4 г4 н2с1н1г2  н2с2м1н1с1м1п2п1в1п2м2м1.с!н1г1н1с1м1.с!н1с4
%т *и=-и-су'съ го-спо'дь. тё'м- же

%н с2н2г2н1с1н4 м2 м1с1 м1п1м1с1н1с1 м2 с2н2 г1с1 н1г1 н2с1м1п4 п1м1
%т _            про-по- вё'-         ди-те   про- по-  вё'д-    ни-

%н с1м1 п2 с1н1с2 н1ц1 г1н1 с2 н4 н1г1 н1с1 м3с1м1п1м1с1 н2с1н1
%т к*омъ _е=-г*о`, о_у=-че-ни-к*о'мъ в\ъ+га-л*и-ле'-     ю

%н г2 н2с1н1г2н2с2н3м1с4н4 н1с1 м2н1с1н1г1н1с1 м2 с2н2г1 г1н1с1 н4
%т те-щи`, и= ви`-дё-ти _е=-го`

%н н1 м2с1м1п4 м1н1 с1м1 п!м!с1м4с2н1с1м1п1м1.с!н1м1п2в1п4м2н1м1с2н2г1н1с2
%т вос-кре'с-  ша   и=зъ ме`рт-

%н н4с2н1г1н1с1м4с3н1с2н2н1м1с4н4г2н1с1н4 с2 н2 н1г1 н1с1 м3с1м1п1м1с1н2м2
%т выхъ,                                  _я=-к*о жиз-но-да'в-

%н м2с4н3г1н1с4н4 н1с1м2 м1с2м1 н2г2 н8\
%т ца и= го'-спо-да.

%код we3u
%Название Воскр\сныя о_у='тренн*ия ст*ихи'ры _е=_в\гльск*ия.
%Название Ст*ихи'ра 3, гла'съ 3:
%Источник Октоих. Синодальное издание, 1899.
%Набор Е.Ю.Нечипоренко

%н н2 н1г1 с2 н2 н1г1 н1с1н1г1ц1г1н1с1 с1н3 с4ц2г2н4н2г2н1г1н1с1н2 г2
%т Ма-гда-ли'-нё ма-р*и'-и, спа'-со-

%н ц2*н1ц1г2ц4 н1г1 н1с1 н1г1 ц1г1н2 г1ц1г2 ц4 г1н1 с4 с1н1г2
%т во          бла-го-вё-ству'-ю-щей и=зъ ме'рт-выхъ

%н н1с1 м2 с1н1с2 н2г2 н4 н1с1 н1г1 ц1г1н2 г1ц1г2 ц4 *н2 ц2 ц2
%т вос-кре-се'-н*и-е      и=   _я=в-ле'-   н*и-   е, не вё'-ру-

%н ц1*н1 г1н1 с2 н1г1 н2 ц4 н2 н1г1 н1с1 н1г1 ц1г1н1с1 с1н3 ц2
%т ю-ще о_у=-че-ни-цы`, по-но-си'-ми          бы'-     ша   *о=

%н *н2 ц1г1 н2с1н1г1ц1 г2 ц4 *н2 ц2 ц2 ц2 ц1*н1 г1н1 с2н1г1 н2 ц4
%т  же-сто-се'р-д*и-и, но зна'-мен-ми во-*о-ру'ж-ше-ся

%н н2 н2 г1ц1 г1н1с2н2г2н4 н2 н1ц1 г1н1 с4 н2 н2 н1г1 н1с1 н1г1
%т и= чу-де-сы', ко про-по-вё'-да-н*и-ю по-сы-

%н ц1г1н2 г1ц1г2 ц4 *н2 н2 н2 г2 н2с2 с2 ц3*н1ц1г1н1.г!ц1г1н3с1н2
%т ла'-ху-ся:       и= ты о_у='-б*о го'-спо-ди,

%н г2г1.ц!*н1*г1*н1ц1г1.ц!*н1ц4*н4*г2*н1ц1*н4 ц1г1 н2н1ц1 г1н1 с2 н3г1ц2г2
%т _                                          к\ъ+на-ча'ль-но-му свё'-

%н н2с1н1г2н2г1н1с4 с2 с1н1г2 н1с1 м2 с1н1с2 н2г2 н4 г1н1 с2 н1ц1
%т ту воз-не'сл-ся _е=-си` _о=т-цу`,                 _о=-ни` же

%н г1н1 г1ц1 г1н1с2 н2г2 н2с2м2с1н1м4с3н1с2н3м1с4н4г2н1с1н4 г1ц1 г1н1
%т про-по-   вё'-   да-ша                                   всю'-ду

%н с!н!г1н1г1 ц4 г1ц1 г1н1 с2г1н2г1 н1с1 н1г1 ц1г1н2 г1ц1г2 ц2г2
%т сло'-во, чу-де-сы` о_у=-вё-ря'-ю-ще.

%н н3г1ц2г2 н2с1н1г2н2г1н1с4 г1ц1 г1н1 с4м2с2м1с1н1г1ц1г1н2 г2 н2г1ц1г2ц4г2ц4
%т тё'м-    же про-свё-ти'в-ше-ся

%н н1с1н1г1ц1г1н1с1 с1н3 н2 г1ц1 г1н1 с4 с2 с1н1 с1м1 п2м2 с1н1г2
%т тё'-ми,               сла'-вимъ тво-е` _е='-же и=зъ ме'рт-выхъ

%н н1с1 м2 с1н1с2 н2г2 н4 *н2 ц1г1 н2 г1н1 с2г1н2г1н1с1 н1г1
%т вос-кре-се'-н*и-е,     че-ло-вё-ко-лю'б-че

%н ц1г1н2 г1ц1г2 ц8\
%т го'с-по-ди.

%код we4u
%Название Воскр\сныя о_у='тренн*ия ст*ихи'ры _е=_в\гльск*ия.
%Название Ст*ихи'ра 4, гла'съ 4:
%Источник Октоих. Синодальное издание, 1899.
%Набор Е.Ю.Нечипоренко

%н н2м4 с2 н1с1н2 н1г1н1с1н1г1 ц1г1н1с1 с1н2. н2 н1г1 н1с1м2 с2 н2
%т О_у='-тро бё глу-бо-ко`, и= же-ны` пр*и-и-

%н с2н1г1ц2 г2н2с1н1г1н1с2н2г1н2с4н1г1ц2 с2 с2м1с1 н1с1м2 с4 н4 п2
%т до'-     ша на гробъ твой хр*и-сте`:                         но

%н с2п2 м4 м2 м1с1 м1п1 м1с1 н2 г2 н1г1н1с1 м2 н1с1 н1г1 н4 г4
%т тё'-ло не *о=-брё'-те-    ся же-ла'-е-мо-е и='-ми:

%н н2г2н2с2 м4п1м1с2м2п4м1с1м4с4н3г1н1с1м2с4 м2 м2 м1с1 м1п1 в2п1м1
%т тё'м-же                                   не-до-у-   ме-  ва'-

%н с1м1 п2 м4 с2 с1н1 с1м1п2 м1с1н2 м1с1 м2п2 м1с1 м4 с1м1 п4
%т ю-щым-ся, и='-же в\ъ+ри'-захъ бле-ща'-щих-ся       пред-ста'-

%н м1с1н2 м1п1 м!с!н1 м1п2м1 с4 н4 н2м2с2н2с2м2п4м4 п2 с2п2 м4
%т вш*и-и гла-го'-ла-ху: что` жи-ва'-го

%н п4м1с1н2  м1п1 м!с!н1 м1п2м1 с4 н4 н1с1 м4 с1м1п2 м1с1 н2с1м1
%т с\ъ+ме'рт-вы-ми и='-ще-те; во-ста`, _я='-ко-же

%н п1с1 м1п1 м2с2н4 н2м2с2н2с2м2п4м4 с1н1с1м1 м1п1м2п1.м!с1м1 с4 м2с4
%т пред-ре-че`,     что не по'м-ни-те

%н м1п1м!с!н1 м1п2м1 с4 н4 с4н1г1ц2с2 м1с1 н1с1м2 с2 н2  с2м2п4
%т гла-г*о'лъ _е=-г*о`;    и=м-       же   вё'-   ро-вав-ша

%н м1с1м4с4н3г1н1с1м2с4 м2п2 п2  м1с1 м4 м1п1 м!с!н1 м1п2м1 с4 н4
%т _                     ви^- дён-на-  я  про-по-   вё'-   да-ху,

%н н1с1 м4 с1м1 п2 с4н1г1ц2 с2 с2 м1с1 н1с1м2 с4 н4 м4 п2
%т но мня'-ху-ся лжа бла-го-вё'-щ_е-н*и-я. та'-к*о

%н с2п2 м4 м2 м1с1 м1п1м1с1н2с1м1 п4 м1с1 н2 с1м1 п1м1п1в1п1.м!с1м1с4
%т бы'-ша  _е=-ще` ко'с-          ни о_у=-че-ни-  цы`,

%н м2с4 п2 с2п2м4 м1п1 в4 п2 м4п3м1с1м1п2м3с1н1с1м2 с2н2с2м2п4м2с1м1п1с1м4
%т _    но петръ те-че`   и= ви'-                   дёвъ

%н г1н1с3н1г2н2 с3н1м1п1м1с1 н2 с1м1 п4 м1с1н2 м1п2м1 с2 с2 н8\
%т про-сла'-ви                  тво-я` въ+се-бё` чу-де-са`.

%код we5u
%Название Воскр\сныя о_у='тренн*ия ст*ихи'ры _е=_в\гльск*ия.
%Название Ст*ихи'ра 5, гла'съ 5:
%Источник Октоих. Синодальное издание, 1899.
%Набор Е.Ю.Нечипоренко

%н с4ц2г2н4с2н2с1н1г1ц1*н1ц1г2ц2г2ц1*н1ц2*н4ц2*н4 н1г1 н2г1ц1*н2*г1г2ц1*н4 *г4
%т _W=^ пре-му'-дрыхъ

%н г1н1 с4м2с1м1п2п1.м!с1н1с1м1с2н1г1ц2г2н4г2н2г2н1г1ц2г2н2г2н1с1н4 н2г2
%т су-де'бъ тво-

%н с4н1г1н2г2ц2*н2ц1г1н3ц1 г1 н2н1г1н2г1ц1г2ц4г2ц4 н3г1н2с2г1н1г1ц1 *н4
%т и'хъ хр*и-сте`, ка'-к*о

%н *н1ц1 г3ц1 *н2*г2г2н2с3н1с1м1п1н1с3н1г1ц1*н2 г2н2с2н3м1с4н4 с2 с1н1 с2м1п1
%т пе-тру` о_у=-б*о пла-ща-ни'-

%н с2  с2 с2 с1н1г1н1 с2 н4 с3н1г1н1 с2 н4 н2 г1ц1 *н4 *н1ц1г2ц2*н2
%т ца- ми _е=-ди'-нё-ми, далъ _е=-си` ра-зу-мё'-ти

%н ц1г1 н2 г1ц1 г1н1 с4 с1н1г1с1 н4н2г2н1с1м2с2н2г1ц1г2ц2*н1ц1г1*н1ц1г1н4
%т тво-е' вос-  кре-се'-н*и-е,

%н г1ц1г2ц2*н1ц1г1*н1ц1г1н4г2ц2*н2 н1г1ц1*н1ц1г1н4г2н2г1ц!г!н2г1ц1г2ц4г2ц4 ц1г1 н2
%т                        _        _                                        лу-цё'

%н г1ц1 г1н1 г1ц1 г2н2 с4 г1*н1 ц1г1 н2 г2 г1ц1 г1н1 с3н1с1м1
%т же и= кле-о'-пё спу-те-ше'-ству-        я,   бе-  сё'-

%н п2 с1м1с1н1 г1н1г1ц1 *н4 *н1 ц1 г4н3г1ц1г1н2г3ц1*н1ц1г2 ц2*н2 ц2г2н4
%т до-валъ _е=-си`, и= бе-сё'-ду-                                яй

%н г2ц1г1н1ц1г4 г1н1 с4 с1н1г1с1 н4 н1г1 н2 г1ц1*н2 *г1г2ц1 *н4 *г4
%т _             не а='-б*и-е се-бе`        _я=-    вля'-   е-  ши;

%н *н2 *г2 *н2 *н2 *н2 *г1г3н2 г1ц1 г2 ц2 *н4 ц1г1н2 г1н1 г1ц1 г2н2с4
%т тё'м-же и= по-но-си'мъ бы-ва'-е-ши, _я='-к*о           _е=-ди'нъ

%н с1г1 н1м1 с1н1 г2 г1ц1 г1н1 с2 г1с1 н2 г4н4 ц1г1 н2
%т при-ше'ль-ству-яй во *и=-е-ру-      са-ли'мъ, и= не

%н г1ц1 г1н1 с4 с1н1г1с1 н4 г1н1 с2н2 г2г1*н1 ц1г1н2 г1ц1 *н4*г4
%т при-ча-ща'-яй-ся в\ъ+ко-не'цъ со-вё'-та и='хъ.

%н г1 с2н1 м1 с4н2п4в2п1м1с2н2 п2п1м1с2м2м1с1н2с2м2н2с2м2 н2с2м4п1м1с2м2п4
%т но и='-же вся _ _

%н м1с1м4с4н3г1н1с1м2с4 с1н1   с2м1п1 с2  с1г1 н1м1  с1н1 г1н1с2 н4
%т _                    к\ъ+со-зда'-  н*и-я    по'ль-зё   стро'- я,

%н г1н1 с4 с1н1 г1н1 с2 н4 г1н1 с4 н2 с1н1 с1м1 п2 с1м1с1н1
%т и= я=`-же *о= те-бё` про-ро-ч_е-ств*и-  я  *о\т-кры'лъ

%н г1н1г1ц1 *н4 ц1*н1 ц1г1 н2 г2 г2 г1ц1 г1н1г1ц1 г2н2 с4 с1г1
%т _е=-     си` и= вне-гда` бла-го-сло-ви'-ти хлёбъ       по-

%н н1м1 с1н1 г1н1 с2г1с1н2 г4н4 с2м1п1 с2 с1г1 н1м1с1н1 г1н1 с2
%т зна'л-ся _е=-си` и=`мъ: и='х-же и= пре'-жде то-

%н н1с1н2 г1н1с2 н4 г1н1 с4 н2 н2 н2 н1г1 н2 г1ц1 *н2 *г1г2ц1 *н4  *г4
%т г*о` серд-ца`    к\ъ+по-зна'-н*и-ю тво-е-му` рас-па-ла'-ста-    ся,

%н г1н1с1н1 с4 н2 с2 с1н1  с1м1 п4м1с1н2ц1г1н1г1 н1с1г1 н4 г4
%т и=`-же       и= о_у=-че-ни-к*о'мъ со'-бран-нымъ

%н г1н1 с4г2н2г1н1 с1н1г1с1 н4 н2 г1ц1*н2 *г1г2ц1 *н4 *г4 г1н1 с3н1
%т о_у=-же`        _я='с-   н*о про-по-   вё'-    да-ста  тво-е`

%н с1м1 п2 с1м1с1н1 г1н1г1ц1 *н4 с4 н1с1н1г1 ц1г1н1г1 н2с1м1с1н1 г1ц1 *н4*г8\
%т во-сре-се'-н*и-е, и='м-же по-                         ми'-луй насъ.

%код we6u
%Название Воскр\сныя о_у='тренн*ия ст*ихи'ры _е=_в\гльск*ия.
%Название Ст*ихи'ра 6, гла'съ 6:
%Источник Октоих. Синодальное издание, 1899.
%Набор Е.Ю.Нечипоренко

%н г2н2 *н1ц1г1ц1 г2н4 н1с1м2н1г1 н2г1 г1н1с1 н4 г1ц1 г1н1 с2н2 г1ц1
%т И='с-тин-ный миръ ты хр*и-сте`, к\ъ+че-ло-ве'-к*омъ

%н *н1ц1г1н1г3*н1 ц2г2н4 г1ц1г1ц1*н2 н2с1н1 г2    н2с2н3м1с4н4 н1г1 н1с1
%т бо'-           ж*ий   миръ        твой   да-   я`           по   во-

%н м3с1н1с1 м2 с2н2 н2  н2 н2 н2с1н1г2н2с2м1н1с1м1п3в1п2м2 м1.с!н1г1н1с1м1.с!н1с4
%т ста'-    н*и-и  о_у=-че-ни-к*о'мъ, _

%н с2н2г2н1с1н4 н2 с1м1п2 м2 м2 м1с1 м1п1м1с1 н1с1 м2 с2н2 н1с1м2
%т _             при-стра'ш-ны по-ка-за'лъ _е=-си` я=`,     мня'-

%н н1с1н1г1 н1с1 м2 с2н2г1 г1н1с1 н4 н2 н1г1 с2н1с1н1г1 н2 с1м1
%т щи-      я    духъ ви'-дё-ти, но о_у=-ти'-шилъ _е=-

%н п4  п2  п1м1с1м1 п2 м2с2н4 г4 с2н2 с2м2 п2м2с4с2н2г2с4н2г4
%т си` мя- те'жъ ду-ши` и='хъ, по-ка-за'-

%н н2с2н1г1с4н2н1с1н2г2н2 г1с1с1н1г1с1с1н1г2н2 г1ц1г2ц4г2ц4 г1н1с2 н2 г1ц1
%т _                      _          вый          ру'-   це и=

%н г1н1г1ц1 *н1ц1г1н1 г2ц1г1 н4 ц1г1 н!г!н1 *н2 ц1г1 н1с1н1 г1н2 ц1г1
%т но'-     зё тво-и`. _о=-ба'-че не-вё'-ру-                     ю-

%н н2г1н1с4 н1г1 н4г2н1с1н4 н1г1с2 н2 н1г1 н1с1 м3с1м1п1м1с1н2с1н1
%т щымъ     _е=-ще`, бра'-шенъ при-ча-ще'-

%н г2 н2с2н3м1с4н4 н2 н1г1 н1м1 с1н1г2н4 н1г1 н1м1 с2н2с!н!г1 с3н1
%т нi-емъ,         и= о_у=-че'-нiй вос-по-ми-                 на'-

%н ц1г1 н2 н1с1   м3с1м1п1м1с1 н1г1 н2м2с1 с1н1с1м2м1.с!н1м1с2с1н1г2ц1г1н1с1н2с2
%т нi-   емъ, w\т- ве'рзлъ _е=-      си` и='хъ

%н н1с1м1п1м2 с1м1п1м1п2 м1с!м!п2п1в1п2м4 м2н1м1с2н2г1н1с2 н4с2н1г1н1с1м4с3н1с2н2
%т _          _          _                _              о_у='мъ,

%н н1м1с4н4г2н1с1н4 н4   г2 г1ц1 г1н1 с2 н2 г1ц1 *н1ц1г1н1 г3*н1
%т _           _е='-же ра-зу-  мjь'-ти пи-са^-              нi-

%н ц2г2н4 г1ц1г1ц1 *н2 н2   н1г1 н1с1н1г1 н2 с1м1 п4  п2 п2 п1м1
%т я:     и=`м-    же    и= _о=- те'-     че-ско- е   w=-бjь-то-

%н п1в1п1м1 с1м1 п2 м2 с2  н4     н2 м2  м1н1 с1м1 п2п!м!с1м4с2
%т ва'-нi-е w=-         бjь-ща'въ, и= бла-го-  сло- ви'въ

